# .NET build output
**/bin/
**/obj/
TestResults/
coverage/
*.trx

# IDE and operating-system files
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json

# Experiment output and downloaded/vendor content
tmp/
vendor/

# Python bytecode: a stray .pyc inside the repository changes the
# git-visible inventory, and the matrix preflight aborts a job when that
# inventory drifts mid-run.
__pycache__/
*.pyc

# Outputs of the fast-simulator scripts (they write next to themselves; see src/fastsim/README.md)
fastsim/adapter60/aggregate.json
fastsim/adapter60/eta_analysis.json
fastsim/adapter60/full_common.json
