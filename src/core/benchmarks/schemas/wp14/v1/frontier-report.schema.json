{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14/v1/frontier-report.schema.json",
  "title": "RideBound WP14 paired service-burden frontier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "freezeId",
    "freezeReceiptSha256",
    "claimBoundary",
    "sourceIdentity",
    "design",
    "points",
    "perCell",
    "verification"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14/v1/frontier-report.schema.json"
    },
    "reportType": {"const": "ridebound-wp14-paired-frontier-v1"},
    "freezeId": {"const": "wp14-development-ablation-v1"},
    "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
    "claimBoundary": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "developmentExploratoryOnlyNotConfirmatory",
          "frozenPanelsNeverUsedForTuningOrSelection",
          "reportPairedFrontierNotAPostOutcomeScalar",
          "mustNotReinterpretOrRescueH6",
          "frontierNotARanking",
          "noPostOutcomeScalarSelection",
          "perRiderTailReportedBesideFleetTotals"
        ]
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerSourceSha256",
        "independentVerifierSourceSha256"
      ],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "independentVerifierSourceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cellCount",
        "armCount",
        "bundleCount",
        "arrivalsPerArm",
        "cells",
        "baselineArmId",
        "referenceArmId",
        "frontierAxes",
        "dominanceRule"
      ],
      "properties": {
        "cellCount": {"const": 16},
        "armCount": {"const": 10},
        "bundleCount": {"const": 160},
        "arrivalsPerArm": {"const": 1728},
        "cells": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/cellId"}
        },
        "baselineArmId": {"const": "b1-ref"},
        "referenceArmId": {"const": "c1-h6ref"},
        "frontierAxes": {
          "const": {
            "service": "completedMaximize",
            "burden": "attributedDecisionInducedMillisecondsMinimize"
          }
        },
        "dominanceRule": {"const": "weakOnBothAxesAndStrictOnAtLeastOne"}
      }
    },
    "points": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/point"}
    },
    "perCell": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "minProperties": 16,
          "maxProperties": 16,
          "additionalProperties": false,
          "patternProperties": {
            "^d[0-9]{8}-s[0-9]+-r[0-9]+-w[0-9]+$": {
              "$ref": "#/$defs/observation"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedBundleCount",
        "duplicateJobCount",
        "duplicateArmCellCount",
        "repositoryInventorySha256es",
        "status"
      ],
      "properties": {
        "verifiedBundleCount": {"const": 160},
        "duplicateJobCount": {"const": 0},
        "duplicateArmCellCount": {"const": 0},
        "repositoryInventorySha256es": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "status": {"const": "pass"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "cellId": {
      "type": "string",
      "pattern": "^d[0-9]{8}-s[0-9]+-r[0-9]+-w[0-9]+$"
    },
    "counter": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/nonnegative"}
    },
    "cellDeltas": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 16,
      "additionalProperties": false,
      "patternProperties": {
        "^d[0-9]{8}-s[0-9]+-r[0-9]+-w[0-9]+$": {
          "$ref": "#/$defs/integer"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arrived",
        "completed",
        "decisions",
        "attributedPickupMs",
        "attributedDropMs",
        "attributedTotalMs",
        "exogenousTotalMs",
        "experiencedTotalMs",
        "pickupEtaImprovementCount",
        "pickupEtaImprovementMs",
        "pickupEtaWorseningCount",
        "pickupEtaWorseningMs",
        "disruptiveDecisions",
        "commitmentPrunedByCode",
        "commitmentPrunedByDimension",
        "ridersWithOpenPromise",
        "ridersCharged",
        "riderDropConsumptionP95Ms",
        "riderDropConsumptionMaxMs",
        "semanticHash",
        "repositoryInventorySha256"
      ],
      "properties": {
        "arrived": {"const": 108},
        "completed": {"type": "integer", "minimum": 0, "maximum": 108},
        "decisions": {"$ref": "#/$defs/nonnegative"},
        "attributedPickupMs": {"$ref": "#/$defs/nonnegative"},
        "attributedDropMs": {"$ref": "#/$defs/nonnegative"},
        "attributedTotalMs": {"$ref": "#/$defs/nonnegative"},
        "exogenousTotalMs": {"$ref": "#/$defs/nonnegative"},
        "experiencedTotalMs": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaImprovementCount": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaImprovementMs": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaWorseningCount": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaWorseningMs": {"$ref": "#/$defs/nonnegative"},
        "disruptiveDecisions": {"$ref": "#/$defs/nonnegative"},
        "commitmentPrunedByCode": {"$ref": "#/$defs/counter"},
        "commitmentPrunedByDimension": {"$ref": "#/$defs/counter"},
        "ridersWithOpenPromise": {"$ref": "#/$defs/nonnegative"},
        "ridersCharged": {"$ref": "#/$defs/nonnegative"},
        "riderDropConsumptionP95Ms": {"$ref": "#/$defs/nonnegative"},
        "riderDropConsumptionMaxMs": {"$ref": "#/$defs/nonnegative"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "repositoryInventorySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armId",
        "factorLevel",
        "arrived",
        "completed",
        "completionRatePartsPerMillionFloor",
        "completedDeltaVersusBaseline",
        "completedDeltaVersusReference",
        "perCellCompletedDeltaVersusBaseline",
        "perCellCompletedDeltaVersusReference",
        "medianCellDeltaVersusBaselineTimesTwo",
        "attributedBurdenMs",
        "attributedBurdenDeltaVersusBaselineMs",
        "attributedBurdenDeltaVersusReferenceMs",
        "experiencedMovementMs",
        "pickupEtaImprovementCount",
        "pickupEtaImprovementMs",
        "pickupEtaWorseningCount",
        "pickupEtaWorseningMs",
        "disruptiveDecisions",
        "commitmentPrunedByCode",
        "commitmentPrunedByDimension",
        "ridersWithOpenPromise",
        "ridersCharged",
        "riderDropConsumptionP95Ms",
        "riderDropConsumptionMaxMs",
        "worstCellP95RiderDropConsumptionMs",
        "isParetoEfficient",
        "dominatedByArmIds"
      ],
      "properties": {
        "armId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "factorLevel": {"type": "string", "minLength": 1},
        "arrived": {"const": 1728},
        "completed": {"type": "integer", "minimum": 0, "maximum": 1728},
        "completionRatePartsPerMillionFloor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "completedDeltaVersusBaseline": {"$ref": "#/$defs/integer"},
        "completedDeltaVersusReference": {"$ref": "#/$defs/integer"},
        "perCellCompletedDeltaVersusBaseline": {"$ref": "#/$defs/cellDeltas"},
        "perCellCompletedDeltaVersusReference": {"$ref": "#/$defs/cellDeltas"},
        "medianCellDeltaVersusBaselineTimesTwo": {"$ref": "#/$defs/integer"},
        "attributedBurdenMs": {"$ref": "#/$defs/nonnegative"},
        "attributedBurdenDeltaVersusBaselineMs": {"$ref": "#/$defs/integer"},
        "attributedBurdenDeltaVersusReferenceMs": {"$ref": "#/$defs/integer"},
        "experiencedMovementMs": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaImprovementCount": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaImprovementMs": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaWorseningCount": {"$ref": "#/$defs/nonnegative"},
        "pickupEtaWorseningMs": {"$ref": "#/$defs/nonnegative"},
        "disruptiveDecisions": {"$ref": "#/$defs/nonnegative"},
        "commitmentPrunedByCode": {"$ref": "#/$defs/counter"},
        "commitmentPrunedByDimension": {"$ref": "#/$defs/counter"},
        "ridersWithOpenPromise": {"$ref": "#/$defs/nonnegative"},
        "ridersCharged": {"$ref": "#/$defs/nonnegative"},
        "riderDropConsumptionP95Ms": {"$ref": "#/$defs/nonnegative"},
        "riderDropConsumptionMaxMs": {"$ref": "#/$defs/nonnegative"},
        "worstCellP95RiderDropConsumptionMs": {"$ref": "#/$defs/nonnegative"},
        "isParetoEfficient": {"type": "boolean"},
        "dominatedByArmIds": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    }
  }
}
