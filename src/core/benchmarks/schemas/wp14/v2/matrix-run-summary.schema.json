{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14/v2/matrix-run-summary.schema.json",
  "title": "RideBound WP14 matrix run summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "freezeId",
    "freezeReceiptSha256",
    "claimBoundary",
    "requestedJobs",
    "selectedJobIds",
    "completed",
    "failed",
    "failures",
    "results",
    "resourceObservation"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14/v2/matrix-run-summary.schema.json"
    },
    "reportType": {"const": "ridebound-wp14-matrix-run-summary-v2"},
    "freezeId": {"const": "wp14-development-ablation-v2"},
    "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
    "claimBoundary": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requestedJobs": {"type": "integer", "minimum": 1, "maximum": 160},
    "selectedJobIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^w14-[a-z0-9-]+-s7$"}
    },
    "completed": {"type": "integer", "minimum": 0, "maximum": 160},
    "failed": {"type": "integer", "minimum": 0, "maximum": 160},
    "failures": {
      "type": "array",
      "maxItems": 160,
      "items": {"$ref": "#/$defs/failure"}
    },
    "results": {
      "type": "array",
      "maxItems": 160,
      "items": {"$ref": "#/$defs/result"}
    },
    "resourceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeDiskBeforeBytes",
        "freeDiskAfterBytes",
        "outputBytesBefore",
        "outputBytesAfter",
        "transcriptBytes",
        "elapsedWallMs"
      ],
      "properties": {
        "freeDiskBeforeBytes": {"$ref": "#/$defs/nonnegative"},
        "freeDiskAfterBytes": {"$ref": "#/$defs/nonnegative"},
        "outputBytesBefore": {"$ref": "#/$defs/nonnegative"},
        "outputBytesAfter": {"$ref": "#/$defs/nonnegative"},
        "transcriptBytes": {"$ref": "#/$defs/nonnegative"},
        "elapsedWallMs": {"$ref": "#/$defs/nonnegative"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "error"],
      "properties": {
        "jobId": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "status",
        "elapsedMs",
        "transcriptBytes",
        "bundleBytes"
      ],
      "properties": {
        "jobId": {"type": "string", "minLength": 1},
        "status": {"enum": ["executedVerified", "reusedVerified"]},
        "elapsedMs": {"$ref": "#/$defs/nonnegative"},
        "transcriptBytes": {"$ref": "#/$defs/nonnegative"},
        "bundleBytes": {"$ref": "#/$defs/nonnegative"}
      }
    }
  }
}
