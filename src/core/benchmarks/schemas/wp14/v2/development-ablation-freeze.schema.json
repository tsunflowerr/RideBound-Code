{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14/v2/development-ablation-freeze.schema.json",
  "title": "RideBound WP14 development ablation freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "freezeId",
    "frozenAtUtc",
    "claimBoundary",
    "design",
    "execution",
    "sourceIdentity",
    "runtime"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14/v2/development-ablation-freeze.schema.json"
    },
    "freezeId": {"const": "wp14-development-ablation-v2"},
    "frozenAtUtc": {"type": "string", "format": "date-time"},
    "claimBoundary": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "developmentExploratoryOnlyNotConfirmatory",
          "frozenPanelsNeverUsedForTuningOrSelection",
          "reportPairedFrontierNotAPostOutcomeScalar",
          "mustNotReinterpretOrRescueH6"
        ]
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gridId",
        "gridManifest",
        "cellCount",
        "armCount",
        "jobCount",
        "arrivalsPerJob",
        "arrivalsPerArm",
        "comparisonUnit",
        "masterSeed",
        "solverSeedsAreReplicates",
        "failureTreatment",
        "arms",
        "jobs"
      ],
      "properties": {
        "gridId": {"const": "wp14-development-panel-v1"},
        "gridManifest": {"$ref": "#/$defs/repositoryArtifact"},
        "cellCount": {"const": 16},
        "armCount": {"const": 10},
        "jobCount": {"const": 160},
        "arrivalsPerJob": {"const": 108},
        "arrivalsPerArm": {"const": 1728},
        "comparisonUnit": {"const": "pairedDevelopmentCell"},
        "masterSeed": {"const": 7},
        "solverSeedsAreReplicates": {"const": false},
        "failureTreatment": {"const": "retainTypedFailureNoRetryNoReplacement"},
        "arms": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/arm"}
        },
        "jobs": {
          "type": "array",
          "minItems": 160,
          "maxItems": 160,
          "items": {"$ref": "#/$defs/job"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputRoot",
        "forbiddenRoots",
        "maximumParallelJobs",
        "repeatsPerJob",
        "resourceEnvelope"
      ],
      "properties": {
        "outputRoot": {"type": "string", "minLength": 1},
        "forbiddenRoots": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "maximumParallelJobs": {"const": 4},
        "repeatsPerJob": {"const": 1},
        "resourceEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planningBasis",
            "observedE1PanelAJobCount",
            "observedMedianJobWallMs",
            "projectedMatrixOutputBytes",
            "projectedMatrixWallMsAtMaximumParallelism",
            "minimumFreeDiskBytesBeforeRun",
            "minimumFreeDiskReserveBytes",
            "maximumOutputBytes",
            "maximumJobWallSeconds",
            "maximumMatrixWallSeconds",
            "cancellationPolicy"
          ],
          "properties": {
            "planningBasis": {"const": "observedE1PanelAResourceOnlyNotOutcomeTuning"},
            "observedE1PanelAJobCount": {"const": 40},
            "observedMedianJobWallMs": {"const": 971998},
            "projectedMatrixOutputBytes": {"const": 15600000000},
            "projectedMatrixWallMsAtMaximumParallelism": {"const": 39600000},
            "minimumFreeDiskBytesBeforeRun": {"const": 26843545600},
            "minimumFreeDiskReserveBytes": {"const": 5368709120},
            "maximumOutputBytes": {"const": 21474836480},
            "maximumJobWallSeconds": {"const": 2700},
            "maximumMatrixWallSeconds": {"const": 57600},
            "cancellationPolicy": {
              "const": "failClosedBeforeLaunchOrRetainTypedPartialReceipt"
            }
          }
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "developmentPanelAudit",
        "resourcePlanningEvidence",
        "repositoryFiles",
        "treeSeals"
      ],
      "properties": {
        "developmentPanelAudit": {"$ref": "#/$defs/artifact"},
        "resourcePlanningEvidence": {"$ref": "#/$defs/artifact"},
        "repositoryFiles": {
          "type": "array",
          "minItems": 30,
          "items": {"$ref": "#/$defs/repositoryArtifact"}
        },
        "treeSeals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapterPackageSha256",
            "developmentFixtureSha256",
            "runnerArtifactSha256",
            "runnerDllSha256"
          ],
          "properties": {
            "adapterPackageSha256": {"$ref": "#/$defs/sha256"},
            "developmentFixtureSha256": {"$ref": "#/$defs/sha256"},
            "runnerArtifactSha256": {"$ref": "#/$defs/sha256"},
            "runnerDllSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fleetPyRoot",
        "fleetPyVersion",
        "fleetPyCommit",
        "pythonExecutable",
        "pythonVersion",
        "pythonExecutableSha256",
        "dotnetExecutable",
        "dotnetSdkVersion",
        "dotnetRuntimeVersion",
        "dotnetExecutableSha256",
        "dotnetRuntimeRoot",
        "dotnetRuntimeTreeSha256",
        "fleetPyCapabilityProbeResultSha256",
        "runnerRoot"
      ],
      "properties": {
        "fleetPyRoot": {"type": "string", "minLength": 1},
        "fleetPyVersion": {"const": "1.0.2"},
        "fleetPyCommit": {
          "const": "053aa9d4fcfde91c5d303435d5748f9206c071b0"
        },
        "pythonExecutable": {"type": "string", "minLength": 1},
        "pythonVersion": {"type": "string", "pattern": "^3\\.10\\."},
        "pythonExecutableSha256": {"$ref": "#/$defs/sha256"},
        "dotnetExecutable": {"type": "string", "minLength": 1},
        "dotnetSdkVersion": {"type": "string", "pattern": "^10\\.0\\."},
        "dotnetRuntimeVersion": {"const": "10.0.9"},
        "dotnetExecutableSha256": {"$ref": "#/$defs/sha256"},
        "dotnetRuntimeRoot": {"type": "string", "minLength": 1},
        "dotnetRuntimeTreeSha256": {"$ref": "#/$defs/sha256"},
        "fleetPyCapabilityProbeResultSha256": {"$ref": "#/$defs/sha256"},
        "runnerRoot": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repositoryArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {
          "properties": {
            "path": {"type": "string", "pattern": "^(benchmarks|docs|simulators)/"}
          }
        }
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "armId",
        "policyId",
        "factorLevel",
        "commitmentConfig",
        "commitmentConfigSha256",
        "wp4Config",
        "wp4ConfigSha256"
      ],
      "properties": {
        "armId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "policyId": {"enum": ["rolling-cost", "ridebound-hard-vector"]},
        "factorLevel": {"type": "string", "minLength": 1},
        "commitmentConfig": {"type": "string", "pattern": "^benchmarks/configurations/"},
        "commitmentConfigSha256": {"$ref": "#/$defs/sha256"},
        "wp4Config": {"type": "string", "pattern": "^benchmarks/configurations/"},
        "wp4ConfigSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "cellId",
        "armId",
        "driver",
        "driverSha256",
        "scenarioContentSha256",
        "commitmentConfig",
        "wp4Config",
        "masterSeed"
      ],
      "properties": {
        "jobId": {"type": "string", "pattern": "^w14-[a-z0-9-]+-s7$"},
        "cellId": {"type": "string", "pattern": "^d[0-9]{8}-s[0-9]+-r[0-9]+-w[0-9]+$"},
        "armId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "driver": {"type": "string", "pattern": "^benchmarks/scenarios/wp14-development/"},
        "driverSha256": {"$ref": "#/$defs/sha256"},
        "scenarioContentSha256": {"$ref": "#/$defs/sha256"},
        "commitmentConfig": {"type": "string", "pattern": "^benchmarks/configurations/"},
        "wp4Config": {"type": "string", "pattern": "^benchmarks/configurations/"},
        "masterSeed": {"const": 7}
      }
    }
  }
}
