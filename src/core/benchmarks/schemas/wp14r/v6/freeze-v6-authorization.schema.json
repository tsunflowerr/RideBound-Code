{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v6/freeze-v6-authorization.schema.json",
  "title": "RideBound WP14R protocol freeze-v2 authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "recordType",
    "freezeId",
    "authorizedAtUtc",
    "authorizationStatus",
    "ownerAuthorization",
    "claimBoundary",
    "baseScientificFreeze",
    "protocol",
    "sourceIdentity",
    "methodologyEvidence"
  ],
  "properties": {
    "schemaVersion": {"const": "6.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v6/freeze-v6-authorization.schema.json"
    },
    "recordType": {"const": "ridebound-wp14r-freeze-v6-authorization"},
    "freezeId": {"const": "wp14r-resilient-development-v6"},
    "authorizedAtUtc": {"$ref": "#/$defs/utc"},
    "authorizationStatus": {
      "const": "protocolAuthorizedExecutionPreconditionsRequired"
    },
    "ownerAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "requestDate",
        "scientificLaunchRequiresPassingHostPreflight"
      ],
      "properties": {
        "basis": {"const": "explicitPersistentGoalContinueWp14rBenchmarks"},
        "requestDate": {"type": "string", "format": "date"},
        "scientificLaunchRequiresPassingHostPreflight": {"const": true}
      }
    },
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "developmentExploratoryOnlyNotConfirmatory"},
        {"const": "frozenPanelsNeverUsedForTuningOrSelection"},
        {"const": "attemptsAreNotExperimentalUnits"},
        {"const": "recoveryUsesMechanicalValidityOnly"},
        {"const": "noPopulationOrSpeedupClaim"},
        {"const": "doesNotReinterpretOrRescueH6"},
        {"const": "doesNotSupersedeWp14V1Failure"}
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "baseScientificFreeze": {"$ref": "#/$defs/baseFreeze"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "methodologyEvidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceArtifact"},
      "minItems": 3,
      "maxItems": 3
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lengthBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationId", "pageCount", "artifact"],
      "properties": {
        "citationId": {"$ref": "#/$defs/identifier"},
        "pageCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "baseFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "freezeId",
        "designSha256",
        "sourceIdentitySha256",
        "jobCount"
      ],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "freezeId": {"const": "wp14-development-ablation-v2"},
        "designSha256": {"$ref": "#/$defs/sha256"},
        "sourceIdentitySha256": {"$ref": "#/$defs/sha256"},
        "jobCount": {"const": 160}
      }
    },
    "hostPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredPlatform",
        "requiredHostFingerprintSha256",
        "requiredAcLineStatus",
        "requiredPowerSchemeGuid",
        "sampleCount",
        "sampleIntervalMs",
        "maximumMeanCpuBusyPercent",
        "maximumSingleCpuBusyPercent",
        "minimumAvailableMemoryBytes",
        "minimumFreeDiskBytes",
        "arbitraryProcessNamesOrCommandLinesRecorded"
      ],
      "properties": {
        "requiredPlatform": {"const": "Windows"},
        "requiredHostFingerprintSha256": {"$ref": "#/$defs/sha256"},
        "requiredAcLineStatus": {"const": "online"},
        "requiredPowerSchemeGuid": {"$ref": "#/$defs/guid"},
        "sampleCount": {"const": 10},
        "sampleIntervalMs": {"const": 1000},
        "maximumMeanCpuBusyPercent": {"const": 20},
        "maximumSingleCpuBusyPercent": {"const": 60},
        "minimumAvailableMemoryBytes": {"const": 8589934592},
        "minimumFreeDiskBytes": {"const": 26843545600},
        "arbitraryProcessNamesOrCommandLinesRecorded": {"const": false}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolId",
        "ledgerVersion",
        "maximumAttemptsPerJob",
        "attemptsAreExperimentalUnits",
        "recoveryPolicy",
        "outcomeAccessPolicy",
        "pairedResourceGate",
        "fullMatrix",
        "execution",
        "hostPolicy",
        "isolation",
        "inheritedEnvironmentNames"
      ],
      "properties": {
        "protocolId": {"const": "wp14r-supervised-scientific-job-v6"},
        "ledgerVersion": {"const": "wp14r-immutable-attempt-ledger-v1"},
        "maximumAttemptsPerJob": {"const": 2},
        "attemptsAreExperimentalUnits": {"const": false},
        "recoveryPolicy": {
          "const": "oneInitialOneMechanicalRecoveryRetainAllNoThirdAttempt"
        },
        "outcomeAccessPolicy": {
          "const": "authorizationAndRecoveryCannotReadScientificOutcome"
        },
        "pairedResourceGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jobIds",
            "executionOrder",
            "requiredValidJobs",
            "requiredFailedJobs",
            "outcomeReadPermitted",
            "matrixLaunchOnFailure"
          ],
          "properties": {
            "jobIds": {
              "type": "array",
              "items": {"$ref": "#/$defs/identifier"},
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            },
            "executionOrder": {"const": "listedSequentially"},
            "requiredValidJobs": {"const": 2},
            "requiredFailedJobs": {"const": 0},
            "outcomeReadPermitted": {"const": false},
            "matrixLaunchOnFailure": {"const": false}
          }
        },
        "fullMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobCount", "jobOrderSha256", "requiresPairedGatePass"],
          "properties": {
            "jobCount": {"const": 160},
            "jobOrderSha256": {"$ref": "#/$defs/sha256"},
            "requiresPairedGatePass": {"const": true}
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumParallelJobs",
            "maximumJobWallSeconds",
            "heartbeatIntervalMs",
            "maximumStreamBytes",
            "chunkBytes",
            "treeExitGraceMs"
          ],
          "properties": {
            "maximumParallelJobs": {"const": 1},
            "maximumJobWallSeconds": {"const": 2700},
            "heartbeatIntervalMs": {"const": 1000},
            "maximumStreamBytes": {"const": 16777216},
            "chunkBytes": {"const": 32768},
            "treeExitGraceMs": {"const": 2000}
          }
        },
        "hostPolicy": {"$ref": "#/$defs/hostPolicy"},
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ledgerRoot", "controlRoot", "forbiddenRoots"],
          "properties": {
            "ledgerRoot": {"type": "string", "minLength": 3},
            "controlRoot": {"type": "string", "minLength": 3},
            "forbiddenRoots": {
              "type": "array",
              "items": {"type": "string", "minLength": 3},
              "minItems": 13,
              "maxItems": 13,
              "uniqueItems": true
            }
          }
        },
        "inheritedEnvironmentNames": {
          "type": "array",
          "prefixItems": [
            {"const": "PATH"},
            {"const": "PROCESSOR_ARCHITECTURE"},
            {"const": "PYTHONDONTWRITEBYTECODE"},
            {"const": "SystemRoot"},
            {"const": "TEMP"},
            {"const": "TMP"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryFiles",
        "mechanicsGateArtifacts",
        "pythonExecutable",
        "runnerTreeSha256",
        "fleetPyIdentitySha256"
      ],
      "properties": {
        "repositoryFiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"},
          "minItems": 16,
          "maxItems": 64
        },
        "mechanicsGateArtifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"},
          "minItems": 3,
          "maxItems": 3
        },
        "pythonExecutable": {"$ref": "#/$defs/artifact"},
        "runnerTreeSha256": {"$ref": "#/$defs/sha256"},
        "fleetPyIdentitySha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
