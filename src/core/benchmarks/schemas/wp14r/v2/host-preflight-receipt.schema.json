{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v2/host-preflight-receipt.schema.json",
  "title": "RideBound WP14R host preflight receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "recordType",
    "preflightVersion",
    "status",
    "claimBoundary",
    "observedUtc",
    "freezeId",
    "freezeReceiptSha256",
    "jobId",
    "prospectiveAttemptNumber",
    "host",
    "power",
    "quiescence",
    "failureCodes",
    "outcomeFieldsRead",
    "preflightToolSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v2/host-preflight-receipt.schema.json"
    },
    "recordType": {"const": "ridebound-wp14r-host-preflight-v2"},
    "preflightVersion": {"const": "wp14r-host-preflight-v2"},
    "status": {"enum": ["pass", "fail"]},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "mechanicalOnly"},
        {"const": "doesNotReadScientificOutcome"},
        {"const": "withinHostConditioningOnly"},
        {"const": "doesNotCreateExperimentalUnits"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "observedUtc": {"$ref": "#/$defs/utc"},
    "freezeId": {"$ref": "#/$defs/identifier"},
    "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
    "jobId": {"$ref": "#/$defs/identifier"},
    "prospectiveAttemptNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "hostFingerprintSha256"],
      "properties": {
        "platform": {"const": "Windows"},
        "hostFingerprintSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acLineStatus", "activeSchemeGuid"],
      "properties": {
        "acLineStatus": {"enum": ["online", "offline", "unknown"]},
        "activeSchemeGuid": {"$ref": "#/$defs/guid"}
      }
    },
    "quiescence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "sampleIntervalMs",
        "cpuBusyPercentSamples",
        "meanCpuBusyPercent",
        "maximumCpuBusyPercent",
        "availableMemoryBytes",
        "freeDiskBytes"
      ],
      "properties": {
        "sampleCount": {"type": "integer", "minimum": 2, "maximum": 60},
        "sampleIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000
        },
        "cpuBusyPercentSamples": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 100},
          "minItems": 2,
          "maxItems": 60
        },
        "meanCpuBusyPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximumCpuBusyPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "availableMemoryBytes": {"$ref": "#/$defs/nonnegativeInteger"},
        "freeDiskBytes": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "failureCodes": {
      "type": "array",
      "items": {
        "enum": [
          "HOST_FINGERPRINT_MISMATCH",
          "PLATFORM_MISMATCH",
          "POWER_SOURCE_NOT_AC",
          "POWER_SCHEME_MISMATCH",
          "CPU_MEAN_ABOVE_LIMIT",
          "CPU_SAMPLE_ABOVE_LIMIT",
          "MEMORY_BELOW_MINIMUM",
          "DISK_BELOW_MINIMUM"
        ]
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "outcomeFieldsRead": {"const": false},
    "preflightToolSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {"properties": {"failureCodes": {"maxItems": 0}}},
      "else": {"properties": {"failureCodes": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
