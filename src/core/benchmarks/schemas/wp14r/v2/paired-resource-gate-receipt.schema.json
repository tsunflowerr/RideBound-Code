{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v2/paired-resource-gate-receipt.schema.json",
  "title": "RideBound WP14R paired resource gate receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "recordType",
    "gateId",
    "generatedUtc",
    "status",
    "freezeId",
    "freezeReceiptSha256",
    "claimBoundary",
    "requiredValidJobs",
    "requiredFailedJobs",
    "jobs",
    "totalElapsedMs",
    "totalRetainedOutputBytes",
    "maximumRetainedOutputBytes",
    "minimumFreeDiskReserveBytes",
    "freeDiskBytesAtGate",
    "resourceEnvelopeStatus",
    "outcomeFieldsRead",
    "matrixAuthorized",
    "protocolToolSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v2/paired-resource-gate-receipt.schema.json"
    },
    "recordType": {"const": "ridebound-wp14r-paired-resource-gate-v2"},
    "gateId": {"const": "wp14r-paired-b1-c1-resource-gate-v2"},
    "generatedUtc": {"$ref": "#/$defs/utc"},
    "status": {"enum": ["pass", "fail"]},
    "freezeId": {"type": "string", "pattern": "^wp14r-resilient-development-v[0-9]+$"},
    "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "resourceAndMechanicalValidityOnly"},
        {"const": "doesNotReadScientificOutcome"},
        {"const": "singleWithinHostPairNoSpeedupClaim"},
        {"const": "attemptsAreNotExperimentalUnits"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "requiredValidJobs": {"const": 2},
    "requiredFailedJobs": {"const": 0},
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "ledgerState",
          "selectedValidAttemptId",
          "attemptCount",
          "terminalReceiptSha256",
          "elapsedMs",
          "retainedOutputBytes",
          "independentVerificationStatus",
          "preflightReceipts"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,191}$"
          },
          "ledgerState": {"enum": ["succeeded", "exhausted", "incomplete"]},
          "selectedValidAttemptId": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "attemptCount": {"type": "integer", "minimum": 0, "maximum": 2},
          "terminalReceiptSha256": {
            "oneOf": [
              {"$ref": "#/$defs/sha256"},
              {"type": "null"}
            ]
          },
          "elapsedMs": {
            "oneOf": [
              {"type": "integer", "minimum": 0, "maximum": 86400000},
              {"type": "null"}
            ]
          },
          "retainedOutputBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "independentVerificationStatus": {
            "enum": ["valid", "invalid", "notRun"]
          },
          "preflightReceipts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "lengthBytes",
                "sha256",
                "status",
                "prospectiveAttemptNumber"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "lengthBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "sha256": {"$ref": "#/$defs/sha256"},
                "status": {"enum": ["pass", "fail"]},
                "prospectiveAttemptNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                }
              }
            },
            "maxItems": 100
          }
        }
      },
      "minItems": 2,
      "maxItems": 2
    },
    "totalElapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172800000
    },
    "totalRetainedOutputBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximumRetainedOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "minimumFreeDiskReserveBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "freeDiskBytesAtGate": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resourceEnvelopeStatus": {"enum": ["pass", "fail"]},
    "outcomeFieldsRead": {"const": false},
    "matrixAuthorized": {"type": "boolean"},
    "protocolToolSha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {
        "properties": {
          "matrixAuthorized": {"const": true},
          "resourceEnvelopeStatus": {"const": "pass"}
        }
      },
      "else": {"properties": {"matrixAuthorized": {"const": false}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    }
  }
}
