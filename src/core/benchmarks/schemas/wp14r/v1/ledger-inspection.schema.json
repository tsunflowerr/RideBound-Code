{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/ledger-inspection.schema.json",
  "title": "RideBound WP14R attempt-ledger inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "ledgerVersion",
    "status",
    "claimBoundary",
    "jobId",
    "maximumAttempts",
    "ledgerState",
    "attemptCount",
    "openAttemptNumber",
    "selectedValidAttemptId",
    "attempts"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/ledger-inspection.schema.json"
    },
    "reportType": {"const": "ridebound-wp14r-ledger-inspection-v1"},
    "ledgerVersion": {"const": "wp14r-attempt-ledger-v1"},
    "status": {"const": "valid"},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "mechanicalOnly"},
        {"const": "attemptsNotExperimentalUnits"},
        {"const": "noScientificOutcomeAuthorization"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "maximumAttempts": {"const": 2},
    "ledgerState": {
      "enum": [
        "readyInitial",
        "attemptOpen",
        "recoveryAuthorized",
        "succeeded",
        "exhausted"
      ]
    },
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 2},
    "openAttemptNumber": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 2},
        {"type": "null"}
      ]
    },
    "selectedValidAttemptId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
        },
        {"type": "null"}
      ]
    },
    "attempts": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptNumber",
          "attemptId",
          "startReceiptSha256",
          "terminalReceiptSha256",
          "terminalStatus",
          "bundleVerificationStatus",
          "retryDisposition"
        ],
        "properties": {
          "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
          "attemptId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
          },
          "startReceiptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "terminalReceiptSha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              {"type": "null"}
            ]
          },
          "terminalStatus": {"enum": ["open", "terminal"]},
          "bundleVerificationStatus": {
            "enum": ["open", "pass", "fail", "notRun"]
          },
          "retryDisposition": {
            "enum": [
              "open",
              "terminalSuccess",
              "recoveryAuthorized",
              "attemptsExhausted"
            ]
          }
        }
      }
    }
  }
}
