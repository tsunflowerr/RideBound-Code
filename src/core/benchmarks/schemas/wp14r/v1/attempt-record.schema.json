{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/attempt-record.schema.json",
  "title": "RideBound WP14R immutable attempt record v1",
  "oneOf": [
    {"$ref": "#/$defs/start"},
    {"$ref": "#/$defs/terminal"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "fileInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "bytes", "sha256"],
      "properties": {
        "exists": {"type": "boolean"},
        "bytes": {"$ref": "#/$defs/nonnegative"},
        "sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "directoryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "fileCount", "bytes", "treeSha256"],
      "properties": {
        "exists": {"type": "boolean"},
        "fileCount": {"$ref": "#/$defs/nonnegative"},
        "bytes": {"$ref": "#/$defs/nonnegative"},
        "treeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "schemaId",
        "recordType",
        "ledgerVersion",
        "jobId",
        "attemptId",
        "attemptNumber",
        "maximumAttempts",
        "startedUtc",
        "freezeId",
        "freezeReceiptSha256",
        "jobBindingSha256",
        "commandSha256",
        "outputRelativePath",
        "processLogRelativePath",
        "previousAttemptId",
        "retryPolicy",
        "outcomeAccessPolicy"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "schemaId": {
          "const": "https://ridebound.local/schemas/wp14r/v1/attempt-record.schema.json"
        },
        "recordType": {"const": "attemptStart"},
        "ledgerVersion": {"const": "wp14r-attempt-ledger-v1"},
        "jobId": {"$ref": "#/$defs/jobId"},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
        "maximumAttempts": {"const": 2},
        "startedUtc": {"$ref": "#/$defs/utc"},
        "freezeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
        "jobBindingSha256": {"$ref": "#/$defs/sha256"},
        "commandSha256": {"$ref": "#/$defs/sha256"},
        "outputRelativePath": {"const": "output"},
        "processLogRelativePath": {"const": "process.log"},
        "previousAttemptId": {
          "oneOf": [
            {"$ref": "#/$defs/attemptId"},
            {"type": "null"}
          ]
        },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
            "maximumAttempts",
            "attemptsAreExperimentalUnits",
            "retainAllAttempts",
            "retryAfterValidBundle"
          ],
          "properties": {
            "policyId": {"const": "one-initial-one-recovery-v1"},
            "maximumAttempts": {"const": 2},
            "attemptsAreExperimentalUnits": {"const": false},
            "retainAllAttempts": {"const": true},
            "retryAfterValidBundle": {"const": false}
          }
        },
        "outcomeAccessPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policyId",
            "mayReadScientificOutcomeToAuthorizeRecovery",
            "recoveryBasis"
          ],
          "properties": {
            "policyId": {"const": "mechanical-validity-only-v1"},
            "mayReadScientificOutcomeToAuthorizeRecovery": {"const": false},
            "recoveryBasis": {"const": "mechanicalValidityOnly"}
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "schemaId",
        "recordType",
        "ledgerVersion",
        "jobId",
        "attemptId",
        "attemptNumber",
        "terminalUtc",
        "startReceiptSha256",
        "exitClassification",
        "processExitCode",
        "elapsedMs",
        "processTreeStatus",
        "recoveryReceiptSha256",
        "processLogInventory",
        "outputInventory",
        "bundleVerification",
        "retryDisposition"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "schemaId": {
          "const": "https://ridebound.local/schemas/wp14r/v1/attempt-record.schema.json"
        },
        "recordType": {"const": "attemptTerminal"},
        "ledgerVersion": {"const": "wp14r-attempt-ledger-v1"},
        "jobId": {"$ref": "#/$defs/jobId"},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
        "terminalUtc": {"$ref": "#/$defs/utc"},
        "startReceiptSha256": {"$ref": "#/$defs/sha256"},
        "exitClassification": {
          "enum": [
            "success",
            "controlledTimeout",
            "processExitFailure",
            "launcherRecoveredOrphanedStart",
            "verifierFailure",
            "processTreeUncertain"
          ]
        },
        "processExitCode": {
          "oneOf": [
            {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
            {"type": "null"}
          ]
        },
        "elapsedMs": {"$ref": "#/$defs/nonnegative"},
        "processTreeStatus": {
          "enum": ["notObserved", "exitedCleanly", "terminated", "uncertain"]
        },
        "recoveryReceiptSha256": {"$ref": "#/$defs/nullableSha256"},
        "processLogInventory": {"$ref": "#/$defs/fileInventory"},
        "outputInventory": {"$ref": "#/$defs/directoryInventory"},
        "bundleVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verifierId",
            "verifierSha256",
            "bundleManifestSha256",
            "behavioralHash"
          ],
          "properties": {
            "status": {"enum": ["pass", "fail", "notRun"]},
            "verifierId": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                {"type": "null"}
              ]
            },
            "verifierSha256": {"$ref": "#/$defs/nullableSha256"},
            "bundleManifestSha256": {"$ref": "#/$defs/nullableSha256"},
            "behavioralHash": {"$ref": "#/$defs/nullableSha256"}
          }
        },
        "retryDisposition": {
          "enum": ["terminalSuccess", "recoveryAuthorized", "attemptsExhausted"]
        }
      }
    }
  }
}
