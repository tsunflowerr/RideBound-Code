{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/supervision-log-record.schema.json",
  "title": "RideBound WP14R supervised process journal record v1",
  "oneOf": [
    {"$ref": "#/$defs/supervisorStart"},
    {"$ref": "#/$defs/launchIntent"},
    {"$ref": "#/$defs/childStarted"},
    {"$ref": "#/$defs/streamChunk"},
    {"$ref": "#/$defs/streamEof"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/limitTriggered"},
    {"$ref": "#/$defs/readerFailure"},
    {"$ref": "#/$defs/launchFailure"},
    {"$ref": "#/$defs/childExit"},
    {"$ref": "#/$defs/supervisorTerminal"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "stream": {"enum": ["stdout", "stderr"]},
    "treeStatus": {
      "enum": ["notObserved", "exitedCleanly", "terminated", "uncertain"]
    },
    "nullableExitCode": {
      "oneOf": [
        {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        {"type": "null"}
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "schemaId",
        "logVersion",
        "recordType",
        "sequence",
        "observedUtc",
        "monotonicElapsedMs",
        "previousRecordSha256",
        "payload",
        "recordSha256"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "schemaId": {
          "const": "https://ridebound.local/schemas/wp14r/v1/supervision-log-record.schema.json"
        },
        "logVersion": {"const": "wp14r-supervision-log-v1"},
        "recordType": {"type": "string"},
        "sequence": {"$ref": "#/$defs/nonnegative"},
        "observedUtc": {"$ref": "#/$defs/utc"},
        "monotonicElapsedMs": {"$ref": "#/$defs/nonnegative"},
        "previousRecordSha256": {"$ref": "#/$defs/sha256"},
        "payload": {"type": "object"},
        "recordSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event": {
      "$ref": "#/$defs/base"
    },
    "supervisorStart": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "supervisorStart"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jobId",
                "attemptId",
                "attemptNumber",
                "startReceiptSha256",
                "commandSha256",
                "executablePath",
                "executableSha256",
                "argumentCount",
                "argumentsSha256",
                "workingDirectory",
                "inheritedEnvironmentNames",
                "environmentBindingSha256",
                "supervisorSha256",
                "supervisorProcessId",
                "hostFingerprintSha256",
                "platform",
                "policy"
              ],
              "properties": {
                "jobId": {"$ref": "#/$defs/identifier"},
                "attemptId": {"$ref": "#/$defs/attemptId"},
                "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
                "startReceiptSha256": {"$ref": "#/$defs/sha256"},
                "commandSha256": {"$ref": "#/$defs/sha256"},
                "executablePath": {"type": "string", "minLength": 1},
                "executableSha256": {"$ref": "#/$defs/sha256"},
                "argumentCount": {"$ref": "#/$defs/nonnegative"},
                "argumentsSha256": {"$ref": "#/$defs/sha256"},
                "workingDirectory": {"type": "string", "minLength": 1},
                "inheritedEnvironmentNames": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}
                },
                "environmentBindingSha256": {"$ref": "#/$defs/sha256"},
                "supervisorSha256": {"$ref": "#/$defs/sha256"},
                "supervisorProcessId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "supervisionEvidenceVersion": {
                  "const": "wp14r-supervision-schema-provenance-v1"
                },
                "logSchemaSha256": {"$ref": "#/$defs/sha256"},
                "reportSchemaSha256": {"$ref": "#/$defs/sha256"},
                "hostFingerprintSha256": {"$ref": "#/$defs/sha256"},
                "platform": {"enum": ["Windows", "Linux", "Darwin", "Other"]},
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "wallTimeoutMs",
                    "heartbeatIntervalMs",
                    "maximumStreamBytes",
                    "chunkBytes",
                    "treeExitGraceMs"
                  ],
                  "properties": {
                    "wallTimeoutMs": {"type": "integer", "minimum": 1, "maximum": 86400000},
                    "heartbeatIntervalMs": {"type": "integer", "minimum": 50, "maximum": 60000},
                    "maximumStreamBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
                    "chunkBytes": {"type": "integer", "minimum": 1, "maximum": 65536},
                    "treeExitGraceMs": {"type": "integer", "minimum": 0, "maximum": 60000}
                  }
                }
              },
              "allOf": [
                {
                  "if": {"required": ["supervisionEvidenceVersion"]},
                  "then": {
                    "required": [
                      "supervisionEvidenceVersion",
                      "logSchemaSha256",
                      "reportSchemaSha256"
                    ]
                  },
                  "else": {
                    "not": {
                      "anyOf": [
                        {"required": ["logSchemaSha256"]},
                        {"required": ["reportSchemaSha256"]}
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "launchIntent": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "launchIntent"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commandSha256", "executableSha256"],
              "properties": {
                "commandSha256": {"$ref": "#/$defs/sha256"},
                "executableSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      ]
    },
    "childStarted": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "childStarted"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["processId", "containment"],
              "properties": {
                "processId": {"type": "integer", "minimum": 1, "maximum": 4294967295},
                "containment": {"enum": ["windowsJobObject", "posixProcessGroup"]}
              }
            }
          }
        }
      ]
    },
    "streamChunk": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "streamChunk"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stream",
                "streamSequence",
                "byteCount",
                "chunkSha256",
                "cumulativeCapturedBytes",
                "dataBase64"
              ],
              "properties": {
                "stream": {"$ref": "#/$defs/stream"},
                "streamSequence": {"$ref": "#/$defs/nonnegative"},
                "byteCount": {"type": "integer", "minimum": 1, "maximum": 65536},
                "chunkSha256": {"$ref": "#/$defs/sha256"},
                "cumulativeCapturedBytes": {"$ref": "#/$defs/nonnegative"},
                "dataBase64": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      ]
    },
    "streamEof": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "streamEof"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stream",
                "observedBytes",
                "observedSha256",
                "capturedBytes",
                "capturedSha256",
                "capturedChunkCount"
              ],
              "properties": {
                "stream": {"$ref": "#/$defs/stream"},
                "observedBytes": {"$ref": "#/$defs/nonnegative"},
                "observedSha256": {"$ref": "#/$defs/sha256"},
                "capturedBytes": {"$ref": "#/$defs/nonnegative"},
                "capturedSha256": {"$ref": "#/$defs/sha256"},
                "capturedChunkCount": {"$ref": "#/$defs/nonnegative"}
              }
            }
          }
        }
      ]
    },
    "heartbeat": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "heartbeat"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["childState", "stdoutCapturedBytes", "stderrCapturedBytes"],
              "properties": {
                "childState": {"enum": ["running", "exited"]},
                "stdoutCapturedBytes": {"$ref": "#/$defs/nonnegative"},
                "stderrCapturedBytes": {"$ref": "#/$defs/nonnegative"}
              }
            }
          }
        }
      ]
    },
    "limitTriggered": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "limitTriggered"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["limit", "observedValue", "maximumValue"],
              "properties": {
                "limit": {"enum": ["wallTimeout", "stdoutBytes", "stderrBytes", "cancellation"]},
                "observedValue": {"$ref": "#/$defs/nonnegative"},
                "maximumValue": {"$ref": "#/$defs/nonnegative"}
              }
            }
          }
        }
      ]
    },
    "readerFailure": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "readerFailure"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stream", "errorType", "messageSha256"],
              "properties": {
                "stream": {"$ref": "#/$defs/stream"},
                "errorType": {"$ref": "#/$defs/identifier"},
                "messageSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      ]
    },
    "launchFailure": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "launchFailure"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "errorType", "messageSha256"],
              "properties": {
                "stage": {"enum": ["createProcess", "containment"]},
                "errorType": {"$ref": "#/$defs/identifier"},
                "messageSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      ]
    },
    "childExit": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "childExit"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["processExitCode", "treeStatus", "cleanupRequired"],
              "properties": {
                "processExitCode": {"$ref": "#/$defs/nullableExitCode"},
                "treeStatus": {"$ref": "#/$defs/treeStatus"},
                "cleanupRequired": {"type": "boolean"}
              }
            }
          }
        }
      ]
    },
    "supervisorTerminal": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "properties": {
            "recordType": {"const": "supervisorTerminal"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "processExitCode",
                "treeStatus",
                "bundleVerificationStatus",
                "stdoutCapturedBytes",
                "stdoutCapturedSha256",
                "stderrCapturedBytes",
                "stderrCapturedSha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "childExitedZeroAwaitingBundleVerification",
                    "childExitFailure",
                    "launchFailure",
                    "wallTimeout",
                    "stdoutLimit",
                    "stderrLimit",
                    "readerFailure",
                    "cancelled",
                    "treeLeakTerminated",
                    "treeUncertain"
                  ]
                },
                "processExitCode": {"$ref": "#/$defs/nullableExitCode"},
                "treeStatus": {"$ref": "#/$defs/treeStatus"},
                "bundleVerificationStatus": {"const": "notRun"},
                "stdoutCapturedBytes": {"$ref": "#/$defs/nonnegative"},
                "stdoutCapturedSha256": {"$ref": "#/$defs/sha256"},
                "stderrCapturedBytes": {"$ref": "#/$defs/nonnegative"},
                "stderrCapturedSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      ]
    }
  }
}
