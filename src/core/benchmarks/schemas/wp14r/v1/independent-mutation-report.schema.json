{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/independent-mutation-report.schema.json",
  "title": "RideBound WP14R independent mutation matrix report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "toolVersion",
    "status",
    "claimBoundary",
    "generatedUtc",
    "toolSourceSha256",
    "verifierSourceSha256",
    "schemaTreeSha256",
    "outputRootPathSha256",
    "sourceFixtures",
    "validFixtures",
    "mutationClassCount",
    "caughtMutationClassCount",
    "cases",
    "scientificOutcomeFieldsRead"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/independent-mutation-report.schema.json"
    },
    "reportType": {
      "const": "ridebound-wp14r-independent-mutation-report-v1"
    },
    "toolVersion": {"const": "wp14r-independent-mutation-matrix-v1"},
    "status": {"const": "pass"},
    "claimBoundary": {
      "const": [
        "mechanicalOnly",
        "mutationClassesAreNotExperimentalUnits",
        "noScientificOutcomeInterpretation",
        "doesNotAuthorizeRecoveryOrFreezeV2",
        "doesNotSupersedeWp14V1"
      ]
    },
    "generatedUtc": {"$ref": "#/$defs/utc"},
    "toolSourceSha256": {"$ref": "#/$defs/sha256"},
    "verifierSourceSha256": {"$ref": "#/$defs/sha256"},
    "schemaTreeSha256": {"$ref": "#/$defs/sha256"},
    "outputRootPathSha256": {"$ref": "#/$defs/sha256"},
    "sourceFixtures": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/sourceFixture"},
        {"$ref": "#/$defs/sourceFixture"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "validFixtures": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/validFixture"},
        {"$ref": "#/$defs/validFixture"},
        {"$ref": "#/$defs/validFixture"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "mutationClassCount": {"enum": [14, 15]},
    "caughtMutationClassCount": {"enum": [14, 15]},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"},
      "minItems": 14,
      "maxItems": 15
    },
    "scientificOutcomeFieldsRead": {"const": false}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "mutationClassCount": {"const": 14},
            "caughtMutationClassCount": {"const": 14},
            "cases": {"minItems": 14, "maxItems": 14}
          }
        },
        {
          "properties": {
            "mutationClassCount": {"const": 15},
            "caughtMutationClassCount": {"const": 15},
            "cases": {"minItems": 15, "maxItems": 15}
          }
        }
      ]
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sourceFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "role",
        "sourceLedgerRootPathSha256",
        "sourceJobId",
        "sourceJobTreeSha256"
      ],
      "properties": {
        "fixtureId": {"enum": ["clean", "recovery"]},
        "role": {"enum": ["cleanCompleteOpen", "partialRecoveryTerminal"]},
        "sourceLedgerRootPathSha256": {"$ref": "#/$defs/sha256"},
        "sourceJobId": {"$ref": "#/$defs/identifier"},
        "sourceJobTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "expectedLedgerState",
        "observedLedgerState",
        "journalSchemaProvenance",
        "valid"
      ],
      "properties": {
        "fixtureId": {"enum": ["clean", "recovery", "legacy"]},
        "expectedLedgerState": {
          "enum": ["attemptOpen", "recoveryAuthorized"]
        },
        "observedLedgerState": {
          "enum": ["attemptOpen", "recoveryAuthorized"]
        },
        "journalSchemaProvenance": {"enum": ["bound", "legacy"]},
        "valid": {"const": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "mutationClass",
        "baseFixtureId",
        "expectedRejectionCode",
        "observedRejectionCode",
        "caught",
        "retainedRelativeRoot",
        "mutantTreeSha256"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^M(0[1-9]|1[0-5])-[a-z][A-Za-z0-9]*$"
        },
        "mutationClass": {
          "enum": [
            "pathOverlap",
            "pathLink",
            "canonicalJson",
            "startBinding",
            "terminalBinding",
            "recoveryBinding",
            "attemptGap",
            "attemptExtra",
            "journalChain",
            "journalChunk",
            "journalEof",
            "journalState",
            "journalTerminalAppend",
            "schemaProvenance",
            "sourceProvenance"
          ]
        },
        "baseFixtureId": {"enum": ["clean", "recovery"]},
        "expectedRejectionCode": {
          "enum": [
            "PATH_UNSAFE",
            "CANONICAL_JSON",
            "START_BINDING",
            "TERMINAL_BINDING",
            "RECOVERY_BINDING",
            "ATTEMPT_SEQUENCE",
            "ENTRY_UNEXPECTED",
            "JOURNAL_CHAIN",
            "JOURNAL_SEMANTICS",
            "JOURNAL_FORMAT",
            "SCHEMA_PROVENANCE",
            "SOURCE_PROVENANCE"
          ]
        },
        "observedRejectionCode": {"type": "string", "minLength": 1},
        "caught": {"const": true},
        "retainedRelativeRoot": {
          "type": "string",
          "pattern": "^cases/M(0[1-9]|1[0-5])-[a-z][A-Za-z0-9]*/ledger$"
        },
        "mutantTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
