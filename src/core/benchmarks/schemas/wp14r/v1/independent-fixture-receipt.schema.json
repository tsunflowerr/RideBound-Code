{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/independent-fixture-receipt.schema.json",
  "title": "RideBound WP14R independent verifier fixture receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "receiptType",
    "builderVersion",
    "status",
    "claimBoundary",
    "createdUtc",
    "rootPathSha256",
    "sourceHashes",
    "schemaTreeSha256",
    "pythonExecutableSha256",
    "jobs",
    "scientificOutcomeFieldsRead"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/independent-fixture-receipt.schema.json"
    },
    "receiptType": {
      "const": "ridebound-wp14r-independent-fixture-receipt-v1"
    },
    "builderVersion": {"const": "wp14r-independent-fixture-builder-v1"},
    "status": {"const": "valid"},
    "claimBoundary": {
      "const": [
        "mechanicalOnly",
        "syntheticChildOnly",
        "noScientificOutcome",
        "fixturesAreNotExperimentalUnits",
        "doesNotAuthorizeRecoveryOrFreezeV2",
        "doesNotSupersedeWp14V1"
      ]
    },
    "createdUtc": {"$ref": "#/$defs/utc"},
    "rootPathSha256": {"$ref": "#/$defs/sha256"},
    "sourceHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "attemptLedger",
        "supervisor",
        "recovery",
        "independentVerifier"
      ],
      "properties": {
        "builder": {"$ref": "#/$defs/sha256"},
        "attemptLedger": {"$ref": "#/$defs/sha256"},
        "supervisor": {"$ref": "#/$defs/sha256"},
        "recovery": {"$ref": "#/$defs/sha256"},
        "independentVerifier": {"$ref": "#/$defs/sha256"}
      }
    },
    "schemaTreeSha256": {"$ref": "#/$defs/sha256"},
    "pythonExecutableSha256": {"$ref": "#/$defs/sha256"},
    "jobs": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/job"},
        {"$ref": "#/$defs/job"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "scientificOutcomeFieldsRead": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "role",
        "expectedLedgerState",
        "observedLedgerState",
        "journalStatus",
        "journalSchemaProvenance",
        "jobTreeSha256"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "role": {"enum": ["cleanCompleteOpen", "partialRecoveryTerminal"]},
        "expectedLedgerState": {
          "enum": ["attemptOpen", "recoveryAuthorized"]
        },
        "observedLedgerState": {
          "enum": ["attemptOpen", "recoveryAuthorized"]
        },
        "journalStatus": {"enum": ["validComplete", "validPartial"]},
        "journalSchemaProvenance": {"const": "bound"},
        "jobTreeSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
