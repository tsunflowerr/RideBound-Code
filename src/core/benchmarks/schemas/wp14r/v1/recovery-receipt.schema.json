{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/recovery-receipt.schema.json",
  "title": "RideBound WP14R stale-open recovery receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "recordType",
    "recoveryVersion",
    "claimBoundary",
    "jobId",
    "attemptId",
    "attemptNumber",
    "observedUtc",
    "startReceiptSha256",
    "commandSha256",
    "supervisorToolSha256",
    "recoveryToolSha256",
    "expectedSupervisorProcessId",
    "processLogInventory",
    "journalState",
    "journalRecordCount",
    "journalTruncatedTailBytes",
    "journalFinalRecordSha256",
    "journalTerminalStatus",
    "launchState",
    "childProcessId",
    "containment",
    "cleanupAction",
    "supervisorAbsent",
    "childAbsent",
    "processGroupAbsent",
    "treeStatus",
    "treeSafe",
    "ledgerExitClassification",
    "retryAuthorized",
    "ledgerRetryDisposition",
    "outcomeFieldsRead"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nullableProcessId": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 4294967295},
        {"type": "null"}
      ]
    },
    "nullableBoolean": {
      "oneOf": [{"type": "boolean"}, {"type": "null"}]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "fileInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "bytes", "sha256"],
      "properties": {
        "exists": {"type": "boolean"},
        "bytes": {"$ref": "#/$defs/nonnegative"},
        "sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/recovery-receipt.schema.json"
    },
    "recordType": {"const": "wp14rRecoveryReceipt"},
    "recoveryVersion": {"const": "wp14r-stale-open-recovery-v1"},
    "claimBoundary": {
      "const": [
        "mechanicalOnly",
        "attemptsNotExperimentalUnits",
        "doesNotReadScientificOutcome",
        "doesNotSupersedeWp14V1"
      ]
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
    },
    "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
    "observedUtc": {"$ref": "#/$defs/utc"},
    "startReceiptSha256": {"$ref": "#/$defs/sha256"},
    "commandSha256": {"$ref": "#/$defs/sha256"},
    "supervisorToolSha256": {"$ref": "#/$defs/sha256"},
    "recoveryToolSha256": {"$ref": "#/$defs/sha256"},
    "expectedSupervisorProcessId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "processLogInventory": {"$ref": "#/$defs/fileInventory"},
    "journalState": {
      "enum": ["noCompleteRecord", "validPartial", "validComplete"]
    },
    "journalRecordCount": {"$ref": "#/$defs/nonnegative"},
    "journalTruncatedTailBytes": {"$ref": "#/$defs/nonnegative"},
    "journalFinalRecordSha256": {"$ref": "#/$defs/nullableSha256"},
    "journalTerminalStatus": {
      "oneOf": [
        {
          "enum": [
            "childExitedZeroAwaitingBundleVerification",
            "childExitFailure",
            "launchFailure",
            "wallTimeout",
            "stdoutLimit",
            "stderrLimit",
            "readerFailure",
            "cancelled",
            "treeLeakTerminated",
            "treeUncertain"
          ]
        },
        {"type": "null"}
      ]
    },
    "launchState": {
      "enum": [
        "beforeSupervisorStart",
        "supervisorStarted",
        "launchAmbiguous",
        "launchFailedBeforeChild",
        "contained",
        "childExitObserved",
        "supervisorTerminal"
      ]
    },
    "childProcessId": {"$ref": "#/$defs/nullableProcessId"},
    "containment": {
      "oneOf": [
        {"enum": ["windowsJobObject", "posixProcessGroup"]},
        {"type": "null"}
      ]
    },
    "cleanupAction": {
      "enum": [
        "none",
        "observeWindowsJobClose",
        "terminatePosixProcessGroup",
        "notPossible"
      ]
    },
    "supervisorAbsent": {"const": true},
    "childAbsent": {"$ref": "#/$defs/nullableBoolean"},
    "processGroupAbsent": {"$ref": "#/$defs/nullableBoolean"},
    "treeStatus": {
      "enum": ["notObserved", "exitedCleanly", "terminated", "uncertain"]
    },
    "treeSafe": {"type": "boolean"},
    "ledgerExitClassification": {
      "enum": ["launcherRecoveredOrphanedStart", "processTreeUncertain"]
    },
    "retryAuthorized": {"type": "boolean"},
    "ledgerRetryDisposition": {
      "enum": ["recoveryAuthorized", "attemptsExhausted"]
    },
    "outcomeFieldsRead": {"const": false}
  }
}
