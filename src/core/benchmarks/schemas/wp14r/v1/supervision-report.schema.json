{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/supervision-report.schema.json",
  "title": "RideBound WP14R supervision journal verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "status",
    "claimBoundary",
    "jobId",
    "attemptId",
    "attemptNumber",
    "commandSha256",
    "recordCount",
    "truncatedTailBytes",
    "finalRecordSha256",
    "terminalStatus",
    "processExitCode",
    "treeStatus",
    "streams"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/supervision-report.schema.json"
    },
    "reportType": {"const": "ridebound-wp14r-supervision-report-v1"},
    "status": {"enum": ["validComplete", "validPartial"]},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "mechanicalOnly"},
        {"const": "doesNotVerifyBundleOrOutcome"},
        {"const": "exitZeroAwaitsIndependentBundleVerification"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "jobId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "attemptId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"},
    "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
    "commandSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supervisionEvidenceVersion": {
      "const": "wp14r-supervision-schema-provenance-v1"
    },
    "logSchemaSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reportSchemaSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recordCount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "truncatedTailBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "finalRecordSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminalStatus": {
      "oneOf": [
        {
          "enum": [
            "childExitedZeroAwaitingBundleVerification",
            "childExitFailure",
            "launchFailure",
            "wallTimeout",
            "stdoutLimit",
            "stderrLimit",
            "readerFailure",
            "cancelled",
            "treeLeakTerminated",
            "treeUncertain"
          ]
        },
        {"type": "null"}
      ]
    },
    "processExitCode": {
      "oneOf": [
        {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        {"type": "null"}
      ]
    },
    "treeStatus": {
      "enum": ["notObserved", "exitedCleanly", "terminated", "uncertain"]
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["supervisionEvidenceVersion"]},
      "then": {
        "required": [
          "supervisionEvidenceVersion",
          "logSchemaSha256",
          "reportSchemaSha256"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["logSchemaSha256"]},
            {"required": ["reportSchemaSha256"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eof", "capturedBytes", "capturedSha256", "capturedChunkCount"],
      "properties": {
        "eof": {"type": "boolean"},
        "capturedBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "capturedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capturedChunkCount": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
