{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/mechanics-dimension-report.schema.json",
  "title": "RideBound WP14R mechanics dimension report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "status",
    "claimBoundary",
    "dimensioningId",
    "generatedUtc",
    "reportInputsSha256",
    "forbiddenRootPathSha256s",
    "hostSession",
    "toolchain",
    "corpus",
    "policy",
    "samples",
    "summaries",
    "decision"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0.0", "1.1.0"]},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/mechanics-dimension-report.schema.json"
    },
    "reportType": {
      "enum": [
        "ridebound-wp14r-mechanics-dimension-report-v1",
        "ridebound-wp14r-mechanics-dimension-report-v2"
      ]
    },
    "status": {"enum": ["complete", "completeWithMeasurementFailures"]},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "mechanicalOnly"},
        {"const": "doesNotReadScientificOutcome"},
        {"const": "descriptiveWithinHostOnly"},
        {"const": "attemptsAreNotReplicates"},
        {"const": "noConfidenceOrPopulationClaim"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "dimensioningId": {"$ref": "#/$defs/identifier"},
    "generatedUtc": {"$ref": "#/$defs/utc"},
    "reportInputsSha256": {"$ref": "#/$defs/sha256"},
    "forbiddenRootPathSha256s": {
      "type": "array",
      "items": {"$ref": "#/$defs/sha256"},
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "hostSession": {"$ref": "#/$defs/hostSession"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "corpus": {"$ref": "#/$defs/corpus"},
    "policy": {"$ref": "#/$defs/policy"},
    "samples": {
      "type": "array",
      "items": {"$ref": "#/$defs/sample"},
      "minItems": 48,
      "maxItems": 48
    },
    "summaries": {
      "type": "array",
      "items": {"$ref": "#/$defs/summary"},
      "minItems": 8,
      "maxItems": 8
    },
    "decision": {"$ref": "#/$defs/decision"}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": "1.1.0"}}},
      "then": {
        "properties": {
          "reportType": {
            "const": "ridebound-wp14r-mechanics-dimension-report-v2"
          },
          "toolchain": {"required": ["wp14rSchemaTreeSha256"]}
        }
      },
      "else": {
        "properties": {
          "reportType": {
            "const": "ridebound-wp14r-mechanics-dimension-report-v1"
          },
          "toolchain": {
            "not": {"required": ["wp14rSchemaTreeSha256"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "nullableInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "null"}
      ]
    },
    "nullableSignedInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {"type": "null"}
      ]
    },
    "nullableString": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "hostSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostSessionId",
        "hostFingerprintSha256",
        "platform",
        "release",
        "machine",
        "logicalCpuCount"
      ],
      "properties": {
        "hostSessionId": {"$ref": "#/$defs/identifier"},
        "hostFingerprintSha256": {"$ref": "#/$defs/sha256"},
        "platform": {"enum": ["Windows", "Linux", "Darwin", "Other"]},
        "release": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "logicalCpuCount": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensionerSha256",
        "supervisorSha256",
        "ledgerSha256",
        "recoverySha256",
        "faultInjectionSha256",
        "pythonExecutableSha256",
        "pythonVersion",
        "psutilVersion"
      ],
      "properties": {
        "dimensionerSha256": {"$ref": "#/$defs/sha256"},
        "supervisorSha256": {"$ref": "#/$defs/sha256"},
        "ledgerSha256": {"$ref": "#/$defs/sha256"},
        "recoverySha256": {"$ref": "#/$defs/sha256"},
        "faultInjectionSha256": {"$ref": "#/$defs/sha256"},
        "wp14rSchemaTreeSha256": {"$ref": "#/$defs/sha256"},
        "pythonExecutableSha256": {"$ref": "#/$defs/sha256"},
        "pythonVersion": {"type": "string", "minLength": 1},
        "psutilVersion": {"type": "string", "minLength": 1}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusId", "corpusSha256", "caseIds"],
      "properties": {
        "corpusId": {
          "enum": ["wp14r-mechanics-corpus-v1", "wp14r-mechanics-corpus-v2"]
        },
        "corpusSha256": {"$ref": "#/$defs/sha256"},
        "caseIds": {
          "type": "array",
          "prefixItems": [
            {"const": "silentExit"},
            {"const": "binaryStreams"},
            {"const": "exactCapBoundary"},
            {"const": "heartbeatIdle"},
            {"const": "nonzeroExit"},
            {"const": "lingeringGrandchild"},
            {"const": "partialRecovery"},
            {"const": "largeJournal"}
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "policySha256",
        "pilotRepetitionsPerCell",
        "measuredRepetitionsPerCell",
        "processPollIntervalMs",
        "maximumVerifierPeakRssBytes",
        "summaryMethod",
        "fsyncModel",
        "pilotExcludedFromSummaries",
        "retainEverySample",
        "outlierDeletionAllowed"
      ],
      "properties": {
        "policyId": {"const": "wp14r-mechanics-dimension-policy-v1"},
        "policySha256": {"$ref": "#/$defs/sha256"},
        "pilotRepetitionsPerCell": {"const": 1},
        "measuredRepetitionsPerCell": {"const": 5},
        "processPollIntervalMs": {"const": 5},
        "maximumVerifierPeakRssBytes": {"const": 268435456},
        "summaryMethod": {"const": "lowerIntegerMedianMinimumMaximum"},
        "fsyncModel": {"const": "oneFsyncPerJournalRecord"},
        "pilotExcludedFromSummaries": {"const": true},
        "retainEverySample": {"const": true},
        "outlierDeletionAllowed": {"const": false}
      }
    },
    "processMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processId",
        "returnCode",
        "wallElapsedNs",
        "processCpuNs",
        "peakRssBytes",
        "stdoutBytes",
        "stderrBytes"
      ],
      "properties": {
        "processId": {"$ref": "#/$defs/nullableInteger"},
        "returnCode": {"$ref": "#/$defs/nullableSignedInteger"},
        "wallElapsedNs": {"$ref": "#/$defs/nullableInteger"},
        "processCpuNs": {"$ref": "#/$defs/nullableInteger"},
        "peakRssBytes": {"$ref": "#/$defs/nullableInteger"},
        "stdoutBytes": {"$ref": "#/$defs/nullableInteger"},
        "stderrBytes": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "streamMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedBytes", "retainedBytes"],
      "properties": {
        "observedBytes": {"$ref": "#/$defs/nullableInteger"},
        "retainedBytes": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "journalMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "records",
        "fsyncCount",
        "supervisedChildProcessId",
        "cleanupLatencyNs",
        "stdout",
        "stderr"
      ],
      "properties": {
        "bytes": {"$ref": "#/$defs/nullableInteger"},
        "records": {"$ref": "#/$defs/nullableInteger"},
        "fsyncCount": {"$ref": "#/$defs/nullableInteger"},
        "supervisedChildProcessId": {"$ref": "#/$defs/nullableInteger"},
        "cleanupLatencyNs": {"$ref": "#/$defs/nullableInteger"},
        "stdout": {"$ref": "#/$defs/streamMeasurement"},
        "stderr": {"$ref": "#/$defs/streamMeasurement"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "caseId",
        "phase",
        "repetition",
        "operation",
        "measurementStatus",
        "failureType",
        "failureMessageSha256",
        "startedUtc",
        "jobId",
        "expectedTerminalStatus",
        "terminalStatus",
        "treeStatus",
        "recoverySourceSupervisorProcessId",
        "launcher",
        "verifier",
        "journal",
        "retained",
        "outcomeFieldsRead"
      ],
      "properties": {
        "sampleId": {"$ref": "#/$defs/identifier"},
        "caseId": {"$ref": "#/$defs/identifier"},
        "phase": {"enum": ["pilot", "measured"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 5},
        "operation": {"enum": ["supervise", "recover"]},
        "measurementStatus": {"enum": ["passed", "failed"]},
        "failureType": {"$ref": "#/$defs/nullableString"},
        "failureMessageSha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "startedUtc": {"$ref": "#/$defs/utc"},
        "jobId": {"$ref": "#/$defs/identifier"},
        "expectedTerminalStatus": {"type": "string", "minLength": 1},
        "terminalStatus": {"$ref": "#/$defs/nullableString"},
        "treeStatus": {"$ref": "#/$defs/nullableString"},
        "recoverySourceSupervisorProcessId": {
          "$ref": "#/$defs/nullableInteger"
        },
        "launcher": {"$ref": "#/$defs/processMeasurement"},
        "verifier": {"$ref": "#/$defs/processMeasurement"},
        "journal": {"$ref": "#/$defs/journalMeasurement"},
        "retained": {"const": true},
        "outcomeFieldsRead": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"measurementStatus": {"const": "passed"}},
            "required": ["measurementStatus"]
          },
          "then": {
            "properties": {
              "failureType": {"type": "null"},
              "failureMessageSha256": {"type": "null"},
              "terminalStatus": {"type": "string", "minLength": 1},
              "treeStatus": {"type": "string", "minLength": 1},
              "launcher": {"$ref": "#/$defs/completeProcessMeasurement"},
              "verifier": {"$ref": "#/$defs/completeProcessMeasurement"},
              "journal": {"$ref": "#/$defs/completeJournalMeasurement"}
            }
          },
          "else": {
            "properties": {
              "failureType": {"type": "string", "minLength": 1},
              "failureMessageSha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "completeProcessMeasurement": {
      "allOf": [
        {"$ref": "#/$defs/processMeasurement"},
        {
          "properties": {
            "processId": {"type": "integer", "minimum": 1},
            "returnCode": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "wallElapsedNs": {"type": "integer", "minimum": 1},
            "processCpuNs": {"type": "integer", "minimum": 0},
            "peakRssBytes": {"type": "integer", "minimum": 1},
            "stdoutBytes": {"type": "integer", "minimum": 0},
            "stderrBytes": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "completeJournalMeasurement": {
      "allOf": [
        {"$ref": "#/$defs/journalMeasurement"},
        {
          "properties": {
            "bytes": {"type": "integer", "minimum": 1},
            "records": {"type": "integer", "minimum": 1},
            "fsyncCount": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "axisSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["median", "minimum", "maximum"],
          "properties": {
            "median": {"type": "integer", "minimum": 0},
            "minimum": {"type": "integer", "minimum": 0},
            "maximum": {"type": "integer", "minimum": 0}
          }
        },
        {"type": "null"}
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "measuredSampleCount",
        "passedSampleCount",
        "failedSampleCount",
        "launcherWallElapsedNs",
        "launcherProcessCpuNs",
        "launcherPeakRssBytes",
        "verifierWallElapsedNs",
        "verifierProcessCpuNs",
        "verifierPeakRssBytes",
        "journalBytes",
        "journalRecords",
        "journalFsyncCount",
        "cleanupLatencyNs"
      ],
      "properties": {
        "caseId": {"$ref": "#/$defs/identifier"},
        "measuredSampleCount": {"const": 5},
        "passedSampleCount": {"type": "integer", "minimum": 0, "maximum": 5},
        "failedSampleCount": {"type": "integer", "minimum": 0, "maximum": 5},
        "launcherWallElapsedNs": {"$ref": "#/$defs/axisSummary"},
        "launcherProcessCpuNs": {"$ref": "#/$defs/axisSummary"},
        "launcherPeakRssBytes": {"$ref": "#/$defs/axisSummary"},
        "verifierWallElapsedNs": {"$ref": "#/$defs/axisSummary"},
        "verifierProcessCpuNs": {"$ref": "#/$defs/axisSummary"},
        "verifierPeakRssBytes": {"$ref": "#/$defs/axisSummary"},
        "journalBytes": {"$ref": "#/$defs/axisSummary"},
        "journalRecords": {"$ref": "#/$defs/axisSummary"},
        "journalFsyncCount": {"$ref": "#/$defs/axisSummary"},
        "cleanupLatencyNs": {"$ref": "#/$defs/axisSummary"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensioningStatus",
        "verifierMemoryEnvelopeStatus",
        "maximumVerifierPeakRssBytes",
        "largeJournalVerifierPeakRssBytes",
        "hostSessionCount",
        "betweenHostVarianceEstimated",
        "nativeHostScope",
        "scalarBestConfigurationSelected"
      ],
      "properties": {
        "dimensioningStatus": {
          "enum": ["withinPredeclaredEnvelope", "requiresRefinement"]
        },
        "verifierMemoryEnvelopeStatus": {"enum": ["pass", "fail"]},
        "maximumVerifierPeakRssBytes": {"const": 268435456},
        "largeJournalVerifierPeakRssBytes": {
          "$ref": "#/$defs/nullableInteger"
        },
        "hostSessionCount": {"const": 1},
        "betweenHostVarianceEstimated": {"const": false},
        "nativeHostScope": {"enum": ["Windows", "Linux", "Darwin", "Other"]},
        "scalarBestConfigurationSelected": {"const": false}
      }
    }
  }
}
