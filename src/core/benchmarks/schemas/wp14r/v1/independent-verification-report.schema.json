{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp14r/v1/independent-verification-report.schema.json",
  "title": "RideBound WP14R independent ledger verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "verifierVersion",
    "status",
    "claimBoundary",
    "verifiedUtc",
    "verifierSourceSha256",
    "schemaTreeSha256",
    "ledgerRootPathSha256",
    "forbiddenRootPathSha256s",
    "jobId",
    "ledgerState",
    "attemptCount",
    "openAttemptNumber",
    "selectedValidAttemptId",
    "attempts",
    "checks"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp14r/v1/independent-verification-report.schema.json"
    },
    "reportType": {"const": "ridebound-wp14r-independent-verification-report-v1"},
    "verifierVersion": {"const": "wp14r-independent-verifier-v1"},
    "status": {"const": "valid"},
    "claimBoundary": {
      "type": "array",
      "prefixItems": [
        {"const": "mechanicalOnly"},
        {"const": "independentReadOnlyImplementation"},
        {"const": "doesNotReadScientificOutcomeFields"},
        {"const": "doesNotAuthorizeRecoveryOrFreezeV2"},
        {"const": "attemptsAreNotExperimentalUnits"},
        {"const": "doesNotSupersedeWp14V1"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "verifiedUtc": {"$ref": "#/$defs/utc"},
    "verifierSourceSha256": {"$ref": "#/$defs/sha256"},
    "schemaTreeSha256": {"$ref": "#/$defs/sha256"},
    "ledgerRootPathSha256": {"$ref": "#/$defs/sha256"},
    "forbiddenRootPathSha256s": {
      "type": "array",
      "items": {"$ref": "#/$defs/sha256"},
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "jobId": {"$ref": "#/$defs/identifier"},
    "ledgerState": {
      "enum": [
        "readyInitial",
        "attemptOpen",
        "recoveryAuthorized",
        "succeeded",
        "exhausted"
      ]
    },
    "attemptCount": {"type": "integer", "minimum": 0, "maximum": 2},
    "openAttemptNumber": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 2},
        {"type": "null"}
      ]
    },
    "selectedValidAttemptId": {
      "oneOf": [{"$ref": "#/$defs/attemptId"}, {"type": "null"}]
    },
    "attempts": {
      "type": "array",
      "items": {"$ref": "#/$defs/attempt"},
      "minItems": 0,
      "maxItems": 2
    },
    "checks": {"$ref": "#/$defs/checks"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}-attempt-0[12]$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recordCount",
        "truncatedTailBytes",
        "finalRecordSha256",
        "terminalStatus",
        "processExitCode",
        "treeStatus",
        "schemaProvenance"
      ],
      "properties": {
        "status": {
          "enum": ["absent", "noCompleteRecord", "validPartial", "validComplete"]
        },
        "recordCount": {"$ref": "#/$defs/nonnegative"},
        "truncatedTailBytes": {"$ref": "#/$defs/nonnegative"},
        "finalRecordSha256": {"$ref": "#/$defs/nullableSha256"},
        "terminalStatus": {
          "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
        },
        "processExitCode": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {"type": "null"}
          ]
        },
        "treeStatus": {
          "enum": ["notObserved", "exitedCleanly", "terminated", "uncertain"]
        },
        "schemaProvenance": {"enum": ["notApplicable", "legacy", "bound"]}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptNumber",
        "attemptId",
        "startReceiptSha256",
        "terminalReceiptSha256",
        "recoveryReceiptSha256",
        "bundleVerificationStatus",
        "retryDisposition",
        "journal"
      ],
      "properties": {
        "attemptNumber": {"type": "integer", "minimum": 1, "maximum": 2},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "startReceiptSha256": {"$ref": "#/$defs/sha256"},
        "terminalReceiptSha256": {"$ref": "#/$defs/nullableSha256"},
        "recoveryReceiptSha256": {"$ref": "#/$defs/nullableSha256"},
        "bundleVerificationStatus": {"enum": ["open", "pass", "fail", "notRun"]},
        "retryDisposition": {
          "enum": ["open", "terminalSuccess", "recoveryAuthorized", "attemptsExhausted"]
        },
        "journal": {"$ref": "#/$defs/journal"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalJsonRecords",
        "journalRecords",
        "outputFilesHashed",
        "scientificOutcomeFieldsRead"
      ],
      "properties": {
        "canonicalJsonRecords": {"$ref": "#/$defs/nonnegative"},
        "journalRecords": {"$ref": "#/$defs/nonnegative"},
        "outputFilesHashed": {"$ref": "#/$defs/nonnegative"},
        "scientificOutcomeFieldsRead": {"const": false}
      }
    }
  }
}
