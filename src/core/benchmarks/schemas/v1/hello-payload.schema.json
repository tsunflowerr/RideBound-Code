{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/hello-payload.schema.json",
  "title": "RideBound hello payload v1",
  "type": "object",
  "required": [
    "adapterId",
    "adapterVersion",
    "supportedSchemaVersions",
    "positionModel",
    "capabilities",
    "maxFleetSize",
    "maxRequestCount"
  ],
  "properties": {
    "adapterId": {
      "$ref": "definitions.schema.json#/$defs/opaqueIdentifier"
    },
    "adapterVersion": {
      "$ref": "definitions.schema.json#/$defs/opaqueIdentifier"
    },
    "supportedSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "x-ridebound-semantic-set": true,
      "x-ridebound-sort": "semantic-version"
    },
    "positionModel": {
      "$ref": "definitions.schema.json#/$defs/positionModel"
    },
    "capabilities": {
      "$ref": "definitions.schema.json#/$defs/capabilitySet"
    },
    "maxFleetSize": {
      "$ref": "definitions.schema.json#/$defs/canonicalPositiveInteger"
    },
    "maxRequestCount": {
      "$ref": "definitions.schema.json#/$defs/canonicalPositiveInteger"
    }
  },
  "additionalProperties": false
}
