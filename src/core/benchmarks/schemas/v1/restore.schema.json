{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/restore.schema.json",
  "title": "RideBound restore message v1",
  "allOf": [
    { "$ref": "protocol-envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "messageType": { "const": "restore" },
        "payload": {
          "oneOf": [
            { "$ref": "checkpoint-payload.schema.json" },
            { "$ref": "restore-acknowledged-payload.schema.json" }
          ]
        }
      }
    }
  ]
}
