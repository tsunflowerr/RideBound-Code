{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/exploratory-replay-freeze.schema.json",
  "title": "RideBound WP13 E1 exploratory replay freeze v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "freezeId", "frozenAtUtc", "claimBoundary", "design", "execution", "sourceArtifacts", "repositoryFiles", "runtime", "treeSeals"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "freezeId": {"const": "wp13-e1-retained-portfolio-replay-v1"},
    "frozenAtUtc": {"type": "string", "format": "date-time"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "h6", "interpretation", "policySelection"],
      "properties": {
        "experiment": {"const": "postOutcomeExploratoryInstrumentationReplay"},
        "h6": {"const": "readOnlyImmutableHistoricalEvidence"},
        "interpretation": {"const": "descriptiveOnlyNotConfirmatoryNotCausal"},
        "policySelection": {"const": "unchangedB1C1NoRelaxationNoReranking"}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelIds", "pairedTargetCount", "plannedArmRunCount", "armIds", "masterSeed", "requestCountPerRun", "solverSeedsAreReplicates", "evidenceProfile", "failureTreatment"],
      "properties": {
        "panelIds": {"const": ["A", "B"]},
        "pairedTargetCount": {"const": 40},
        "plannedArmRunCount": {"const": 80},
        "armIds": {"const": ["b1", "c1"]},
        "masterSeed": {"const": 7},
        "requestCountPerRun": {"const": 108},
        "solverSeedsAreReplicates": {"const": false},
        "evidenceProfile": {"const": "retained-portfolio-v1"},
        "failureTreatment": {"const": "retainTypedFailureNoRetryNoReplacement"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputRoots", "forbiddenRoots", "repeatsPerArm", "maximumParallelJobs", "runnerTimeoutSeconds", "maximumInputLineBytes", "maximumOutputLineBytes", "maximumRunnerStderrBytes"],
      "properties": {
        "outputRoots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": {"const": "E:\\RideBoundData\\wp13\\e1-retained-portfolio-panel-a"},
            "B": {"const": "E:\\RideBoundData\\wp13\\e1-retained-portfolio-panel-b"}
          }
        },
        "forbiddenRoots": {
          "const": [
            "E:\\RideBoundData\\wp9\\confirmatory-h6-panela",
            "E:\\RideBoundData\\wp9\\confirmatory-h6-panelb"
          ]
        },
        "repeatsPerArm": {"const": 1},
        "maximumParallelJobs": {"const": 4},
        "runnerTimeoutSeconds": {"const": 60},
        "maximumInputLineBytes": {"const": 67108864},
        "maximumOutputLineBytes": {"const": 67108864},
        "maximumRunnerStderrBytes": {"const": 1048576}
      }
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/namedArtifact"}
    },
    "repositoryFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repositoryFile"}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleetPyVersion", "fleetPyCommit", "pythonVersion", "pythonExecutableSha256", "dotnetSdkVersion", "dotnetRuntimeVersion", "dotnetExecutableSha256", "repositoryInventoryAlgorithm"],
      "properties": {
        "fleetPyVersion": {"const": "1.0.2"},
        "fleetPyCommit": {"$ref": "#/$defs/gitCommit"},
        "pythonVersion": {"const": "3.10.20"},
        "pythonExecutableSha256": {"$ref": "#/$defs/sha256"},
        "dotnetSdkVersion": {"const": "10.0.301"},
        "dotnetRuntimeVersion": {"const": "10.0.9"},
        "dotnetExecutableSha256": {"$ref": "#/$defs/sha256"},
        "repositoryInventoryAlgorithm": {"const": "RideBound.Wp9RepositoryInventory.v1"}
      }
    },
    "treeSeals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterPackageSha256", "panelADerivativeSha256", "panelBDerivativeSha256", "runnerArtifactSha256", "runnerDllSha256"],
      "properties": {
        "adapterPackageSha256": {"$ref": "#/$defs/sha256"},
        "panelADerivativeSha256": {"$ref": "#/$defs/sha256"},
        "panelBDerivativeSha256": {"$ref": "#/$defs/sha256"},
        "runnerArtifactSha256": {"$ref": "#/$defs/sha256"},
        "runnerDllSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "namedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "lengthBytes", "sha256"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repositoryFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^\\\\/].+"},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
