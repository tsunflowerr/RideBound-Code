{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/e1-candidate-descriptive-aggregation.schema.json",
  "title": "RideBound WP13 E1 candidate descriptive aggregation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaId", "reportType", "claimBoundary", "sourceIdentity", "inputIdentity", "totals", "associationRows", "panels", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/e1-candidate-descriptive-aggregation.schema.json"},
    "reportType": {"const": "ridebound-wp13-e1-candidate-descriptive-aggregation-v1"},
    "claimBoundary": {"$ref": "#/$defs/claimBoundary"},
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "inputIdentity": {"$ref": "#/$defs/inputIdentity"},
    "totals": {"$ref": "#/$defs/totals"},
    "associationRows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/associationRow"}
    },
    "panels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/panel"}
    },
    "records": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "signed": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["prunedWithRecordedWitness", "eligibleNotSelectedAssociation", "selectedByC1", "absentFromGeneratedSet"]
    },
    "immediateRelation": {
      "enum": ["c1LowerImmediateAcceptance", "equalImmediateAcceptance", "c1HigherImmediateAcceptance"]
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisClass", "interpretation", "trajectoryOutcome", "objectiveComparison", "associationRows", "populationInference", "counterfactualCompletion", "confirmatoryGate", "rawArtifacts"],
      "properties": {
        "analysisClass": {"const": "postOutcomeExploratoryFinitePanel"},
        "interpretation": {"const": "descriptiveAssociationNotCausal"},
        "trajectoryOutcome": {"const": "trajectoryAssociatedNotCausal"},
        "objectiveComparison": {"const": "notComparableAcrossObjectiveProfiles"},
        "associationRows": {"const": "overlappingCellsNotAdditive"},
        "populationInference": {"const": "notEvaluatedNoCiOrPValue"},
        "counterfactualCompletion": {"const": "notEvaluated"},
        "confirmatoryGate": {"const": "notApplicableCannotRescueH6"},
        "rawArtifacts": {"const": "readOnlyImmutableInputs"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerSourceSha256", "independentVerifierSourceSha256", "schemaSha256"],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "independentVerifierSourceSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstDivergenceRecordSetSha256", "behavioralComparatorSha256", "e1InventorySha256", "e1FalsificationReceiptSha256", "e1H6EquivalenceReceiptSha256", "repositoryInventorySha256"],
      "properties": {
        "firstDivergenceRecordSetSha256": {"$ref": "#/$defs/sha256"},
        "behavioralComparatorSha256": {"$ref": "#/$defs/sha256"},
        "e1InventorySha256": {"$ref": "#/$defs/sha256"},
        "e1FalsificationReceiptSha256": {"$ref": "#/$defs/sha256"},
        "e1H6EquivalenceReceiptSha256": {"$ref": "#/$defs/sha256"},
        "repositoryInventorySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prunedWithRecordedWitness", "eligibleNotSelectedAssociation", "selectedByC1", "absentFromGeneratedSet"],
      "properties": {
        "prunedWithRecordedWitness": {"$ref": "#/$defs/nonnegative"},
        "eligibleNotSelectedAssociation": {"$ref": "#/$defs/nonnegative"},
        "selectedByC1": {"$ref": "#/$defs/nonnegative"},
        "absentFromGeneratedSet": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "immediateRelationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c1LowerImmediateAcceptance", "equalImmediateAcceptance", "c1HigherImmediateAcceptance"],
      "properties": {
        "c1LowerImmediateAcceptance": {"$ref": "#/$defs/nonnegative"},
        "equalImmediateAcceptance": {"$ref": "#/$defs/nonnegative"},
        "c1HigherImmediateAcceptance": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordCount", "verifiedArmRunCount", "verifiedSolverDecisionCount", "targetPortfolioCount", "generatedCandidateObservationCount", "generatedSignatureIntersectionCount", "generatedSignatureEqualPairCount", "generatedSignatureDifferentPairCount", "candidateIdDriftCount", "actionfulLinkCount", "classificationCounts", "immediateRelationCounts"],
      "properties": {
        "recordCount": {"const": 40},
        "verifiedArmRunCount": {"const": 80},
        "verifiedSolverDecisionCount": {"const": 44156},
        "targetPortfolioCount": {"const": 80},
        "generatedCandidateObservationCount": {"$ref": "#/$defs/positive"},
        "generatedSignatureIntersectionCount": {"$ref": "#/$defs/positive"},
        "generatedSignatureEqualPairCount": {"$ref": "#/$defs/nonnegative"},
        "generatedSignatureDifferentPairCount": {"$ref": "#/$defs/nonnegative"},
        "candidateIdDriftCount": {"$ref": "#/$defs/nonnegative"},
        "actionfulLinkCount": {"const": 41},
        "classificationCounts": {"$ref": "#/$defs/classificationCounts"},
        "immediateRelationCounts": {"$ref": "#/$defs/immediateRelationCounts"}
      }
    },
    "associationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "acceptanceRelation", "cellCount", "linkCount", "trajectoryCompletedDeltaSum"],
      "properties": {
        "classification": {"$ref": "#/$defs/classification"},
        "acceptanceRelation": {"$ref": "#/$defs/immediateRelation"},
        "cellCount": {"$ref": "#/$defs/positive"},
        "linkCount": {"$ref": "#/$defs/positive"},
        "trajectoryCompletedDeltaSum": {"$ref": "#/$defs/signed"}
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "vehicleCount", "recordCount", "arrivalsPerArm", "actionfulLinkCount", "classificationCounts", "immediateRelationCounts", "generatedSignatureEqualPairCount", "candidateIdDriftCount", "h6B1Completed", "h6C1Completed", "h6CompletedDeltaC1MinusB1"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "vehicleCount": {"enum": [4, 8]},
        "recordCount": {"const": 20},
        "arrivalsPerArm": {"const": 2160},
        "actionfulLinkCount": {"$ref": "#/$defs/positive"},
        "classificationCounts": {"$ref": "#/$defs/classificationCounts"},
        "immediateRelationCounts": {"$ref": "#/$defs/immediateRelationCounts"},
        "generatedSignatureEqualPairCount": {"$ref": "#/$defs/nonnegative"},
        "candidateIdDriftCount": {"$ref": "#/$defs/nonnegative"},
        "h6B1Completed": {"$ref": "#/$defs/nonnegative"},
        "h6C1Completed": {"$ref": "#/$defs/nonnegative"},
        "h6CompletedDeltaC1MinusB1": {"$ref": "#/$defs/signed"}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstDivergenceRecordSha256", "behavioralComparisonRecordSha256", "observedInputProjectionSha256", "b1BundleManifestSha256", "b1PortfolioSha256", "c1BundleManifestSha256", "c1PortfolioSha256"],
      "properties": {
        "firstDivergenceRecordSha256": {"$ref": "#/$defs/sha256"},
        "behavioralComparisonRecordSha256": {"$ref": "#/$defs/sha256"},
        "observedInputProjectionSha256": {"$ref": "#/$defs/sha256"},
        "b1BundleManifestSha256": {"$ref": "#/$defs/sha256"},
        "b1PortfolioSha256": {"$ref": "#/$defs/sha256"},
        "c1BundleManifestSha256": {"$ref": "#/$defs/sha256"},
        "c1PortfolioSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "objectiveProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b1", "c1", "crossArmComparison", "ordinalInterpretation"],
      "properties": {
        "b1": {"const": "rollingCost"},
        "c1": {"const": "hardVector"},
        "crossArmComparison": {"const": "notComparableAcrossObjectiveProfiles"},
        "ordinalInterpretation": {"const": "withinVehicleDescriptiveNotGlobalSolverRank"}
      }
    },
    "generatedOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b1GeneratedCount", "c1GeneratedCount", "intersectionCount", "b1OnlyCount", "c1OnlyCount", "candidateIdDriftCount", "b1SignatureSetSha256", "c1SignatureSetSha256", "relation"],
      "properties": {
        "b1GeneratedCount": {"$ref": "#/$defs/positive"},
        "c1GeneratedCount": {"$ref": "#/$defs/positive"},
        "intersectionCount": {"$ref": "#/$defs/nonnegative"},
        "b1OnlyCount": {"$ref": "#/$defs/nonnegative"},
        "c1OnlyCount": {"$ref": "#/$defs/nonnegative"},
        "candidateIdDriftCount": {"$ref": "#/$defs/nonnegative"},
        "b1SignatureSetSha256": {"$ref": "#/$defs/sha256"},
        "c1SignatureSetSha256": {"$ref": "#/$defs/sha256"},
        "relation": {"enum": ["equal", "different"]}
      }
    },
    "immediate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceRelation", "acceptedCountDeltaC1MinusB1"],
      "properties": {
        "acceptanceRelation": {"$ref": "#/$defs/immediateRelation"},
        "acceptedCountDeltaC1MinusB1": {"$ref": "#/$defs/signed"}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrivalsPerArm", "h6B1Completed", "h6C1Completed", "h6CompletedDeltaC1MinusB1", "interpretation"],
      "properties": {
        "arrivalsPerArm": {"const": 108},
        "h6B1Completed": {"type": "integer", "minimum": 0, "maximum": 108},
        "h6C1Completed": {"type": "integer", "minimum": 0, "maximum": 108},
        "h6CompletedDeltaC1MinusB1": {"type": "integer", "minimum": -108, "maximum": 108},
        "interpretation": {"const": "trajectoryAssociatedNotCausal"}
      }
    },
    "pruneEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pruneCode", "commitmentWitnessCount", "commitmentWitnessCodes", "hasPhysicalWitness", "witnessSha256"],
      "properties": {
        "pruneCode": {"$ref": "#/$defs/identifier"},
        "commitmentWitnessCount": {"$ref": "#/$defs/nonnegative"},
        "commitmentWitnessCodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "hasPhysicalWitness": {"type": "boolean"},
        "physicalWitnessCode": {"$ref": "#/$defs/identifier"},
        "witnessSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateSignatureSha256", "vehicleId", "newRequestIds", "b1CandidateId", "candidateIdRelation", "classification", "b1ObjectiveVectorSha256", "b1WithinVehicleObjectiveOrdinal", "b1EligibleCandidateCountForVehicle"],
      "properties": {
        "candidateSignatureSha256": {"$ref": "#/$defs/sha256"},
        "vehicleId": {"$ref": "#/$defs/identifier"},
        "newRequestIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "b1CandidateId": {"$ref": "#/$defs/identifier"},
        "c1CandidateId": {"$ref": "#/$defs/identifier"},
        "candidateIdRelation": {"enum": ["same", "different", "notPresent"]},
        "classification": {"$ref": "#/$defs/classification"},
        "b1ObjectiveVectorSha256": {"$ref": "#/$defs/sha256"},
        "b1WithinVehicleObjectiveOrdinal": {"$ref": "#/$defs/positive"},
        "b1EligibleCandidateCountForVehicle": {"$ref": "#/$defs/positive"},
        "c1ObjectiveVectorSha256": {"$ref": "#/$defs/sha256"},
        "c1WithinVehicleObjectiveOrdinal": {"$ref": "#/$defs/positive"},
        "c1EligibleCandidateCountForVehicle": {"$ref": "#/$defs/positive"},
        "pruneEvidence": {"$ref": "#/$defs/pruneEvidence"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "prunedWithRecordedWitness"}}},
          "then": {"required": ["c1CandidateId", "pruneEvidence"]}
        },
        {
          "if": {"properties": {"classification": {"enum": ["eligibleNotSelectedAssociation", "selectedByC1"]}}},
          "then": {"required": ["c1CandidateId", "c1ObjectiveVectorSha256", "c1WithinVehicleObjectiveOrdinal", "c1EligibleCandidateCountForVehicle"]}
        },
        {
          "if": {"properties": {"classification": {"const": "absentFromGeneratedSet"}}},
          "then": {"properties": {"candidateIdRelation": {"const": "notPresent"}}}
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "vehicleCount", "unitId", "epochId", "simTimeMs", "b1JobId", "c1JobId", "sourceScenarioContentSha256", "sourceBinding", "objectiveProfiles", "generatedOverlap", "immediate", "trajectory", "linkClassCounts", "links"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "vehicleCount": {"enum": [4, 8]},
        "unitId": {"$ref": "#/$defs/identifier"},
        "epochId": {"$ref": "#/$defs/positive"},
        "simTimeMs": {"$ref": "#/$defs/nonnegative"},
        "b1JobId": {"$ref": "#/$defs/identifier"},
        "c1JobId": {"$ref": "#/$defs/identifier"},
        "sourceScenarioContentSha256": {"$ref": "#/$defs/sha256"},
        "sourceBinding": {"$ref": "#/$defs/sourceBinding"},
        "objectiveProfiles": {"$ref": "#/$defs/objectiveProfiles"},
        "generatedOverlap": {"$ref": "#/$defs/generatedOverlap"},
        "immediate": {"$ref": "#/$defs/immediate"},
        "trajectory": {"$ref": "#/$defs/trajectory"},
        "linkClassCounts": {"$ref": "#/$defs/classificationCounts"},
        "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/link"}}
      }
    }
  }
}
