{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/e1-falsification-receipt.schema.json",
  "title": "RideBound WP13 E1 falsification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaId", "reportType", "claimBoundary", "inputEvidence", "sourceIdentity", "verification", "samples", "mutations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/e1-falsification-receipt.schema.json"},
    "reportType": {"const": "ridebound-wp13-e1-falsification-receipt-v1"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation", "rawMutation", "mechanismConclusion", "confirmatoryGate"],
      "properties": {
        "interpretation": {"const": "evidenceContractFalsificationOnly"},
        "rawMutation": {"const": "noneInMemoryMutantsOnly"},
        "mechanismConclusion": {"const": "notEvaluated"},
        "confirmatoryGate": {"const": "notApplicableCannotRescueH6"}
      }
    },
    "inputEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freezeReceiptSha256", "inventorySha256", "inventoryLengthBytes", "repositoryInventorySha256", "panelARootInventorySha256", "panelBRootInventorySha256"],
      "properties": {
        "freezeReceiptSha256": {"$ref": "#/$defs/sha256"},
        "inventorySha256": {"$ref": "#/$defs/sha256"},
        "inventoryLengthBytes": {"$ref": "#/$defs/positive"},
        "repositoryInventorySha256": {"$ref": "#/$defs/sha256"},
        "panelARootInventorySha256": {"$ref": "#/$defs/sha256"},
        "panelBRootInventorySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerSourceSha256", "independentVerifierSourceSha256", "inventoryAnalyzerSourceSha256", "schemaSha256"],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "independentVerifierSourceSha256": {"$ref": "#/$defs/sha256"},
        "inventoryAnalyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifiedArmRunCount", "verifiedSolverDecisionCount", "verifiedPortfolioCount", "mutationCount", "expectedRejectionCount", "unexpectedPassCount", "unexpectedFailureCount"],
      "properties": {
        "verifiedArmRunCount": {"const": 80},
        "verifiedSolverDecisionCount": {"const": 44156},
        "verifiedPortfolioCount": {"const": 44156},
        "mutationCount": {"const": 31},
        "expectedRejectionCount": {"const": 31},
        "unexpectedPassCount": {"const": 0},
        "unexpectedFailureCount": {"const": 0}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/sample"}
    },
    "mutations": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {"$ref": "#/$defs/mutation"}
    }
  },
  "$defs": {
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rejectionCode": {"type": "string", "pattern": "^RBWP13F_[A-Z0-9_]+$"},
    "identifier": {"type": "string", "minLength": 1},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "panelId", "jobId", "epochId", "objectiveProfile", "candidateCount", "sha256"],
      "properties": {
        "sampleId": {"enum": ["richEligible", "withPruned"]},
        "panelId": {"enum": ["A", "B"]},
        "jobId": {"$ref": "#/$defs/identifier"},
        "epochId": {"$ref": "#/$defs/positive"},
        "objectiveProfile": {"enum": ["rollingCost", "hardVector"]},
        "candidateCount": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutationId", "layer", "sampleId", "expectedMessageContains", "expectedRejectionCode", "actualMessage", "actualRejectionCode", "status"],
      "properties": {
        "mutationId": {"$ref": "#/$defs/identifier"},
        "layer": {"enum": ["artifactBinding", "evidenceVersion", "portfolioIdentity", "candidateSet", "eligibility", "selection", "objective", "routeSchedule", "strictShape"]},
        "sampleId": {"enum": ["binding", "richEligible", "withPruned"]},
        "expectedMessageContains": {"$ref": "#/$defs/identifier"},
        "expectedRejectionCode": {"$ref": "#/$defs/rejectionCode"},
        "actualMessage": {"$ref": "#/$defs/identifier"},
        "actualRejectionCode": {"$ref": "#/$defs/rejectionCode"},
        "status": {"const": "rejectedAtExpectedLayer"}
      }
    }
  }
}
