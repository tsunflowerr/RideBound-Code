{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/e1-h6-behavioral-equivalence.schema.json",
  "title": "RideBound WP13 E1 to H6 behavioral equivalence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaId", "reportType", "claimBoundary", "sourceIdentity", "inputEvidence", "totals", "panels", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/e1-h6-behavioral-equivalence.schema.json"},
    "reportType": {"const": "ridebound-wp13-e1-h6-behavioral-equivalence-v1"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "interpretation", "stateHashEquality", "mechanismConclusion"],
      "properties": {
        "comparison": {"const": "sameArmSameScenarioOperationalProjection"},
        "interpretation": {"const": "instrumentationEquivalenceOnlyNotCausal"},
        "stateHashEquality": {"const": "notRequiredPolicyManifestBindsState"},
        "mechanismConclusion": {"const": "notEvaluated"}
      }
    },
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "inputEvidence": {"$ref": "#/$defs/inputEvidence"},
    "totals": {"$ref": "#/$defs/totals"},
    "panels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/panel"}
    },
    "records": {
      "type": "array",
      "minItems": 80,
      "maxItems": 80,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerSourceSha256", "independentVerifierSourceSha256", "schemaSha256"],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "independentVerifierSourceSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e1InventorySha256", "e1RepositoryInventorySha256", "h6PanelARoot", "h6PanelBRoot"],
      "properties": {
        "e1InventorySha256": {"$ref": "#/$defs/sha256"},
        "e1RepositoryInventorySha256": {"$ref": "#/$defs/sha256"},
        "h6PanelARoot": {"$ref": "#/$defs/identifier"},
        "h6PanelBRoot": {"$ref": "#/$defs/identifier"}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armRunCount", "behaviorallyEqualArmRunCount", "mismatchCount", "requestCount", "h6SolverDecisionCount"],
      "properties": {
        "armRunCount": {"const": 80},
        "behaviorallyEqualArmRunCount": {"const": 80},
        "mismatchCount": {"const": 0},
        "requestCount": {"const": 8640},
        "h6SolverDecisionCount": {"const": 44156}
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "armRunCount", "behaviorallyEqualArmRunCount", "mismatchCount", "h6SolverDecisionCount", "h6RootInventorySha256"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "armRunCount": {"const": 40},
        "behaviorallyEqualArmRunCount": {"const": 40},
        "mismatchCount": {"const": 0},
        "h6SolverDecisionCount": {"$ref": "#/$defs/positive"},
        "h6RootInventorySha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "unitId", "armId", "jobId", "sourceScenarioContentSha256", "e1BundleManifestSha256", "h6BundleManifestSha256", "e1SemanticHash", "h6SemanticHash", "e1BehavioralProjectionHash", "h6BehavioralProjectionHash", "h6SolverDecisionCount", "requestCount", "operationallyEqual"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "unitId": {"$ref": "#/$defs/identifier"},
        "armId": {"enum": ["b1", "c1"]},
        "jobId": {"$ref": "#/$defs/identifier"},
        "sourceScenarioContentSha256": {"$ref": "#/$defs/sha256"},
        "e1BundleManifestSha256": {"$ref": "#/$defs/sha256"},
        "h6BundleManifestSha256": {"$ref": "#/$defs/sha256"},
        "e1SemanticHash": {"$ref": "#/$defs/sha256"},
        "h6SemanticHash": {"$ref": "#/$defs/sha256"},
        "e1BehavioralProjectionHash": {"$ref": "#/$defs/sha256"},
        "h6BehavioralProjectionHash": {"$ref": "#/$defs/sha256"},
        "h6SolverDecisionCount": {"$ref": "#/$defs/positive"},
        "requestCount": {"const": 108},
        "operationallyEqual": {"const": true}
      }
    }
  }
}
