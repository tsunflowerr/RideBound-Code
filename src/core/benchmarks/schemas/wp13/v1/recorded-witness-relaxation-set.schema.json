{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/recorded-witness-relaxation-set.schema.json",
  "title": "RideBound WP13 recorded-witness relaxation set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "toolIdentity", "inputIdentity", "claimBoundary", "recordCount", "candidateLinkCount", "statusCounts", "clearanceKindCounts", "panelSummaries", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportType": {"const": "ridebound-wp13-recorded-witness-relaxation-set-v1"},
    "toolIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["calculatorSourceSha256", "schemaSha256"],
      "properties": {"calculatorSourceSha256": {"$ref": "#/$defs/hash"}, "schemaSha256": {"$ref": "#/$defs/hash"}}
    },
    "inputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["behavioralComparatorLengthBytes", "behavioralComparatorSha256", "behavioralComparatorSourceSha256", "firstDivergenceRecordSetLengthBytes", "firstDivergenceRecordSetSha256", "inventoryAnalyzerSourceSha256", "sourceInventoryReportSha256", "solverEvidenceVerifierSourceSha256"],
      "properties": {
        "behavioralComparatorLengthBytes": {"$ref": "#/$defs/nonnegative"},
        "behavioralComparatorSha256": {"$ref": "#/$defs/hash"},
        "behavioralComparatorSourceSha256": {"$ref": "#/$defs/hash"},
        "firstDivergenceRecordSetLengthBytes": {"$ref": "#/$defs/nonnegative"},
        "firstDivergenceRecordSetSha256": {"$ref": "#/$defs/hash"},
        "inventoryAnalyzerSourceSha256": {"$ref": "#/$defs/hash"},
        "sourceInventoryReportSha256": {"$ref": "#/$defs/hash"},
        "solverEvidenceVerifierSourceSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["analysisClass", "clearanceScope", "candidateFeasibilityAfterClearance", "retainedCandidatePortfolio", "validatorTraversal", "interpretation", "h6Artifacts", "confirmatoryGate"],
      "properties": {
        "analysisClass": {"const": "postOutcomeExploratory"},
        "clearanceScope": {"const": "recordedWitnessOnly"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"},
        "retainedCandidatePortfolio": {"const": "notRecorded"},
        "validatorTraversal": {"const": "failFastMayHideSubsequentBlockers"},
        "interpretation": {"const": "descriptiveNotCausal"},
        "h6Artifacts": {"const": "readOnlyImmutableInputs"},
        "confirmatoryGate": {"type": "null"}
      }
    },
    "recordCount": {"const": 40},
    "candidateLinkCount": {"$ref": "#/$defs/nonnegative"},
    "statusCounts": {"$ref": "#/$defs/statusCounts"},
    "clearanceKindCounts": {"$ref": "#/$defs/kindCounts"},
    "panelSummaries": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/panelSummary"}},
    "records": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^candidate-v1-[0-9a-f]{64}$"},
    "vehicleId": {"type": "string", "pattern": "^veh-[0-9a-f]{64}$"},
    "requestId": {"type": "string", "pattern": "^rq-[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "statusCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["absentRetainedOrOmittedNotRecorded", "prunedWithCommitmentWitness", "prunedWithoutCommitmentWitness", "selectedByC1"],
      "properties": {
        "absentRetainedOrOmittedNotRecorded": {"$ref": "#/$defs/nonnegative"},
        "prunedWithCommitmentWitness": {"$ref": "#/$defs/nonnegative"},
        "prunedWithoutCommitmentWitness": {"$ref": "#/$defs/nonnegative"},
        "selectedByC1": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "kindCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["categoricalLockDisablement", "numericBudgetLimitIncrease"],
      "properties": {
        "categoricalLockDisablement": {"$ref": "#/$defs/nonnegative"},
        "numericBudgetLimitIncrease": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "panelSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["panelId", "recordCount", "candidateLinkCount", "statusCounts", "clearanceKindCounts"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "recordCount": {"const": 20},
        "candidateLinkCount": {"$ref": "#/$defs/nonnegative"},
        "statusCounts": {"$ref": "#/$defs/statusCounts"},
        "clearanceKindCounts": {"$ref": "#/$defs/kindCounts"}
      }
    },
    "budgetClearance": {
      "type": "object", "additionalProperties": false,
      "required": ["clearanceKind", "witnessSha256", "stage", "code", "vehicleId", "requestId", "dimension", "limit", "before", "delta", "after", "requiredLimit", "additiveLimitIncrease"],
      "properties": {
        "clearanceKind": {"const": "numericBudgetLimitIncrease"},
        "witnessSha256": {"$ref": "#/$defs/hash"},
        "stage": {"const": "budget"},
        "code": {"const": "COMMITMENT_BUDGET_EXCEEDED"},
        "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "dimension": {"type": "string", "minLength": 1},
        "limit": {"$ref": "#/$defs/nonnegative"},
        "before": {"$ref": "#/$defs/nonnegative"},
        "delta": {"$ref": "#/$defs/nonnegative"},
        "after": {"$ref": "#/$defs/positive"},
        "requiredLimit": {"$ref": "#/$defs/positive"},
        "additiveLimitIncrease": {"$ref": "#/$defs/positive"}
      }
    },
    "lockClearance": {
      "type": "object", "additionalProperties": false,
      "required": ["clearanceKind", "witnessSha256", "stage", "code", "vehicleId", "requestId", "dimension", "rule", "requiredChange"],
      "properties": {
        "clearanceKind": {"const": "categoricalLockDisablement"},
        "witnessSha256": {"$ref": "#/$defs/hash"},
        "stage": {"const": "lock"},
        "code": {"const": "COMMITMENT_PHASE_LOCK"},
        "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "requestId": {"$ref": "#/$defs/requestId"},
        "dimension": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "requiredChange": {"const": "disableRecordedRuleForDimension"}
      }
    },
    "commitmentLink": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "vehicleId", "acceptedRequestIds", "sourceB1PlanActionSha256", "retainedCandidatePortfolio", "candidateFeasibilityAfterClearance", "status", "sourceC1PruneWitnessSha256", "pruneCode", "witnessClearances"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"}, "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "acceptedRequestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requestId"}},
        "sourceB1PlanActionSha256": {"$ref": "#/$defs/hash"}, "retainedCandidatePortfolio": {"const": "notRecorded"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"}, "status": {"const": "prunedWithCommitmentWitness"},
        "sourceC1PruneWitnessSha256": {"$ref": "#/$defs/hash"}, "pruneCode": {"type": "string", "minLength": 1},
        "witnessClearances": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/budgetClearance"}, {"$ref": "#/$defs/lockClearance"}]}}
      }
    },
    "otherPruneLink": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "vehicleId", "acceptedRequestIds", "sourceB1PlanActionSha256", "retainedCandidatePortfolio", "candidateFeasibilityAfterClearance", "status", "sourceC1PruneWitnessSha256", "pruneCode", "clearanceStatus"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"}, "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "acceptedRequestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requestId"}},
        "sourceB1PlanActionSha256": {"$ref": "#/$defs/hash"}, "retainedCandidatePortfolio": {"const": "notRecorded"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"}, "status": {"const": "prunedWithoutCommitmentWitness"},
        "sourceC1PruneWitnessSha256": {"$ref": "#/$defs/hash"}, "pruneCode": {"type": "string", "minLength": 1},
        "clearanceStatus": {"const": "notCalculableFromCommitmentWitness"}
      }
    },
    "selectedLink": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "vehicleId", "acceptedRequestIds", "sourceB1PlanActionSha256", "retainedCandidatePortfolio", "candidateFeasibilityAfterClearance", "status", "sourceC1PlanActionSha256", "clearanceStatus"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"}, "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "acceptedRequestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requestId"}},
        "sourceB1PlanActionSha256": {"$ref": "#/$defs/hash"}, "retainedCandidatePortfolio": {"const": "notRecorded"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"}, "status": {"const": "selectedByC1"},
        "sourceC1PlanActionSha256": {"$ref": "#/$defs/hash"}, "clearanceStatus": {"const": "notApplicableCandidateSelected"}
      }
    },
    "absentLink": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "vehicleId", "acceptedRequestIds", "sourceB1PlanActionSha256", "retainedCandidatePortfolio", "candidateFeasibilityAfterClearance", "status", "clearanceStatus"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/candidateId"}, "vehicleId": {"$ref": "#/$defs/vehicleId"},
        "acceptedRequestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requestId"}},
        "sourceB1PlanActionSha256": {"$ref": "#/$defs/hash"}, "retainedCandidatePortfolio": {"const": "notRecorded"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"}, "status": {"const": "absentRetainedOrOmittedNotRecorded"},
        "clearanceStatus": {"const": "notRecorded"}
      }
    },
    "candidateLink": {"oneOf": [{"$ref": "#/$defs/commitmentLink"}, {"$ref": "#/$defs/otherPruneLink"}, {"$ref": "#/$defs/selectedLink"}, {"$ref": "#/$defs/absentLink"}]},
    "rawEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["b1BundleManifestSha256", "b1TranscriptSha256", "c1BundleManifestSha256", "c1TranscriptSha256"],
      "properties": {"b1BundleManifestSha256": {"$ref": "#/$defs/hash"}, "b1TranscriptSha256": {"$ref": "#/$defs/hash"}, "c1BundleManifestSha256": {"$ref": "#/$defs/hash"}, "c1TranscriptSha256": {"$ref": "#/$defs/hash"}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "panelId", "unitId", "epochId", "simTimeMs", "sourceBehavioralComparisonSha256", "rawEvidence", "candidateLinks"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "recordType": {"const": "ridebound-wp13-recorded-witness-relaxation-v1"},
        "panelId": {"enum": ["A", "B"]}, "unitId": {"type": "string", "minLength": 1},
        "epochId": {"$ref": "#/$defs/positive"}, "simTimeMs": {"$ref": "#/$defs/nonnegative"},
        "sourceBehavioralComparisonSha256": {"$ref": "#/$defs/hash"}, "rawEvidence": {"$ref": "#/$defs/rawEvidence"},
        "candidateLinks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateLink"}}
      }
    }
  }
}
