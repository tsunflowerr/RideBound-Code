{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/full-source-logic-claim-audit.schema.json",
  "title": "RideBound WP13 full source, logic and claim audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaId", "reportType", "auditTicket", "claimBoundary", "sourceIdentity", "repositoryInventory", "architectureAudit", "claimAudit", "contractAudit", "evidenceDag", "deepRawVerification", "resourceFootprint", "findings"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/full-source-logic-claim-audit.schema.json"},
    "reportType": {"const": "ridebound-wp13-full-source-logic-claim-audit-v1"},
    "auditTicket": {"const": "RB-WP13-012"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisClass", "scientificResult", "h6Artifacts", "e1Artifacts", "causalInference", "populationInference", "confirmatoryGate"],
      "properties": {
        "analysisClass": {"const": "implementationEvidenceAndClaimAuditOnly"},
        "scientificResult": {"const": "noneAdded"},
        "h6Artifacts": {"const": "readOnlyImmutableInputs"},
        "e1Artifacts": {"const": "readOnlyImmutableInputs"},
        "causalInference": {"const": "notEvaluated"},
        "populationInference": {"const": "notEvaluated"},
        "confirmatoryGate": {"const": "notApplicableCannotRescueH6"}
      }
    },
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "repositoryInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupCount", "fileCount", "totalBytes", "inventorySha256", "files"],
      "properties": {
        "groupCount": {"const": 8},
        "fileCount": {"type": "integer", "minimum": 70},
        "totalBytes": {"$ref": "#/$defs/positive"},
        "inventorySha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 70, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "architectureAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainApplicationSourceFileCount", "analyzerImportCount", "reverseDependencyViolationCount", "simulatorPolicyReimplementation"],
      "properties": {
        "domainApplicationSourceFileCount": {"$ref": "#/$defs/positive"},
        "analyzerImportCount": {"$ref": "#/$defs/positive"},
        "reverseDependencyViolationCount": {"const": 0},
        "simulatorPolicyReimplementation": {"const": "notDetected"}
      }
    },
    "claimAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannedDocumentCount", "highRiskOccurrenceCount", "unsafeConclusionCount", "occurrenceInventorySha256", "requiredLabels"],
      "properties": {
        "scannedDocumentCount": {"const": 12},
        "highRiskOccurrenceCount": {"$ref": "#/$defs/nonnegative"},
        "unsafeConclusionCount": {"const": 0},
        "occurrenceInventorySha256": {"$ref": "#/$defs/sha256"},
        "requiredLabels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["associationRows", "objectiveComparison", "interpretation", "confirmatoryGate"],
          "properties": {
            "associationRows": {"const": "overlappingCellsNotAdditive"},
            "objectiveComparison": {"const": "notComparableAcrossObjectiveProfiles"},
            "interpretation": {"const": "descriptiveAssociationNotCausal"},
            "confirmatoryGate": {"const": "notApplicableCannotRescueH6"}
          }
        }
      }
    },
    "contractAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaCount", "compactSummaryCount", "externalReferenceCount", "activeExternalArtifactCount", "supersededExternalArtifactCount", "canonicalExternalArtifactCount", "e1FreezeRepositoryFileCount", "e1FreezeRepositoryMismatchCount", "h6HistoricalVerifierSourceSha256", "e1CurrentVerifierSourceSha256", "backwardCompatibility"],
      "properties": {
        "schemaCount": {"const": 11},
        "compactSummaryCount": {"const": 9},
        "externalReferenceCount": {"$ref": "#/$defs/positive"},
        "activeExternalArtifactCount": {"const": 10},
        "supersededExternalArtifactCount": {"const": 3},
        "canonicalExternalArtifactCount": {"const": 13},
        "e1FreezeRepositoryFileCount": {"$ref": "#/$defs/positive"},
        "e1FreezeRepositoryMismatchCount": {"const": 0},
        "h6HistoricalVerifierSourceSha256": {"const": "3eebec96b8370db2c4879adeaede3e67b7344571299a496953afcbc599dd93e5"},
        "e1CurrentVerifierSourceSha256": {"const": "89a9e9a797e7d7f004490bff3bc37da14cd792c14ff60513873ed51b96c06a17"},
        "backwardCompatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["h6EvidenceVersion", "profileOffEvidenceVersion", "profileOnEvidenceVersion", "operationalEquivalenceArmRunCount", "operationalMismatchCount"],
          "properties": {
            "h6EvidenceVersion": {"const": "1.0.0"},
            "profileOffEvidenceVersion": {"const": "1.1.0"},
            "profileOnEvidenceVersion": {"const": "1.2.0"},
            "operationalEquivalenceArmRunCount": {"const": 80},
            "operationalMismatchCount": {"const": 0}
          }
        }
      }
    },
    "evidenceDag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeCount", "failedEdgeCount", "activeArtifacts", "supersededArtifacts", "aggregateInvariants"],
      "properties": {
        "edgeCount": {"const": 8},
        "failedEdgeCount": {"const": 0},
        "activeArtifacts": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/artifact"}},
        "supersededArtifacts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/artifact"}},
        "aggregateInvariants": {"$ref": "#/$defs/aggregateInvariants"}
      }
    },
    "deepRawVerification": {"$ref": "#/$defs/deepRawVerification"},
    "resourceFootprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e1RawBundleBytes", "e1MaximumBundleBytes", "e1MaximumWallMilliseconds", "interpretation"],
      "properties": {
        "e1RawBundleBytes": {"const": 5516098710},
        "e1MaximumBundleBytes": {"const": 119353350},
        "e1MaximumWallMilliseconds": {"const": 1514349},
        "interpretation": {"const": "instrumentationCostObservationNotMechanismEvidence"}
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolvedP0Count", "unresolvedP1Count", "unresolvedP2Count", "resolvedP2Findings", "p3Limitations"],
      "properties": {
        "unresolvedP0Count": {"const": 0},
        "unresolvedP1Count": {"const": 0},
        "unresolvedP2Count": {"const": 0},
        "resolvedP2Findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resolvedFinding"}},
        "p3Limitations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/limitation"}}
      }
    }
  },
  "$defs": {
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "signed": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerSourceSha256", "testSourceSha256", "schemaSha256"],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "testSourceSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "lengthBytes", "lineCount", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "lineCount": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256", "reportType", "schemaValidation", "superseded"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "reportType": {"type": "string", "minLength": 1},
        "schemaValidation": {"enum": ["pass", "notDeclared", "supersededNotApplicable"]},
        "superseded": {"type": "boolean"}
      }
    },
    "aggregateInvariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairedCellCount", "verifiedArmRunCount", "verifiedSolverDecisionCount", "retainedPortfolioCount", "actionfulLinkCount", "generatedSignatureEqualPairCount", "candidateIdDriftCount", "panelACompletedDeltaC1MinusB1", "panelBCompletedDeltaC1MinusB1", "associationRows", "objectiveComparison", "interpretation"],
      "properties": {
        "pairedCellCount": {"const": 40},
        "verifiedArmRunCount": {"const": 80},
        "verifiedSolverDecisionCount": {"const": 44156},
        "retainedPortfolioCount": {"const": 44156},
        "actionfulLinkCount": {"const": 41},
        "generatedSignatureEqualPairCount": {"const": 40},
        "candidateIdDriftCount": {"const": 0},
        "panelACompletedDeltaC1MinusB1": {"const": -154},
        "panelBCompletedDeltaC1MinusB1": {"const": -106},
        "associationRows": {"const": "overlappingCellsNotAdditive"},
        "objectiveComparison": {"const": "notComparableAcrossObjectiveProfiles"},
        "interpretation": {"const": "descriptiveAssociationNotCausal"}
      }
    },
    "deepRawVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "h6", "e1"],
      "properties": {
        "status": {"enum": ["notRequested", "pass"]},
        "h6": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/h6Deep"}]},
        "e1": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/e1Deep"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "notRequested"}}}, "then": {"properties": {"h6": {"type": "null"}, "e1": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"h6": {"$ref": "#/$defs/h6Deep"}, "e1": {"$ref": "#/$defs/e1Deep"}}}}
      ]
    },
    "h6Deep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelCount", "bundleCount", "solverDecisionCount", "comparison"],
      "properties": {
        "panelCount": {"const": 2},
        "bundleCount": {"const": 100},
        "solverDecisionCount": {"const": 57806},
        "comparison": {"const": "exactPanelObjectsEqual"}
      }
    },
    "e1Deep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armRunCount", "requestCount", "solverDecisionCount", "retainedPortfolioEvidenceCount", "repositoryInventorySha256", "comparison"],
      "properties": {
        "armRunCount": {"const": 80},
        "requestCount": {"const": 8640},
        "solverDecisionCount": {"const": 44156},
        "retainedPortfolioEvidenceCount": {"const": 44156},
        "repositoryInventorySha256": {"const": "22f4914e9f61163f8e33089a2f24786bcd4bf0b4c50d42a860fbf8916a3f6afb"},
        "comparison": {"const": "exactRunAndPanelObjectsEqual"}
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^WP13-AUDIT-P3-[0-9]{3}$"},
        "owner": {"const": "RB-WP13-013"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "resolvedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resolution", "regression"],
      "properties": {
        "id": {"type": "string", "pattern": "^WP13-AUDIT-P2-[0-9]{3}$"},
        "resolution": {"type": "string", "minLength": 1},
        "regression": {"type": "string", "minLength": 1}
      }
    }
  }
}
