{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/runner-retained-candidate-portfolio-evidence.schema.json",
  "title": "RideBound Runner retained candidate portfolio evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["portfolioVersion", "schemaId", "objectiveProfile", "generatedCandidateCount", "policyEligibleCandidateCount", "selectedCandidateIds", "selectionProblem", "candidates"],
  "properties": {
    "portfolioVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/runner-retained-candidate-portfolio-evidence.schema.json"},
    "objectiveProfile": {"enum": ["rollingCost", "revisionPenalty", "hardVector", "softHardHybrid"]},
    "generatedCandidateCount": {"$ref": "#/$defs/positive"},
    "policyEligibleCandidateCount": {"$ref": "#/$defs/positive"},
    "selectedCandidateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "selectionProblem": {"$ref": "#/$defs/selectionProblem"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "identifier": {"type": "string", "minLength": 1},
    "selectionProblem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicleIds", "requestIds", "objectiveLevels"],
      "properties": {
        "vehicleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "requestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "objectiveLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["levelIndex", "name", "sense", "aggregation"],
            "properties": {
              "levelIndex": {"$ref": "#/$defs/nonnegative"},
              "name": {"$ref": "#/$defs/identifier"},
              "sense": {"enum": ["minimize", "maximize"]},
              "aggregation": {"enum": ["sum", "maximum"]}
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "vehicleId", "newRequestIds", "isNoOp", "scheduleStrategy", "relocatedWaitMs", "route", "schedule", "policyEligibility"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/identifier"},
        "vehicleId": {"$ref": "#/$defs/identifier"},
        "newRequestIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "isNoOp": {"type": "boolean"},
        "scheduleStrategy": {"enum": ["earliestFeasible", "originHoldRelocatedWait"]},
        "relocatedWaitMs": {"$ref": "#/$defs/nonnegative"},
        "certifiedForwardSlackMs": {"$ref": "#/$defs/nonnegative"},
        "repairedIncumbentRequestId": {"$ref": "#/$defs/identifier"},
        "route": {"$ref": "#/$defs/route"},
        "schedule": {"$ref": "#/$defs/schedule"},
        "policyEligibility": {"enum": ["eligible", "pruned"]},
        "objectiveContributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonnegative"}}
      },
      "allOf": [
        {"if": {"properties": {"policyEligibility": {"const": "eligible"}}}, "then": {"required": ["objectiveContributions"]}},
        {"if": {"properties": {"policyEligibility": {"const": "pruned"}}}, "then": {"not": {"required": ["objectiveContributions"]}}}
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planVersion", "executedStopCount", "frozenPrefix", "mutableSuffix"],
      "properties": {
        "planVersion": {"$ref": "#/$defs/nonnegative"},
        "executedStopCount": {"$ref": "#/$defs/nonnegative"},
        "frozenPrefix": {"type": "array", "items": {"$ref": "#/$defs/routeStop"}},
        "mutableSuffix": {"type": "array", "items": {"$ref": "#/$defs/routeStop"}}
      }
    },
    "routeStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopId", "nodeId", "kind", "serviceDurationMs"],
      "properties": {
        "stopId": {"$ref": "#/$defs/identifier"},
        "nodeId": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["waypoint", "pickup", "dropOff"]},
        "requestId": {"$ref": "#/$defs/identifier"},
        "serviceDurationMs": {"$ref": "#/$defs/nonnegative"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "waypoint"}}}, "then": {"not": {"required": ["requestId"]}}},
        {"if": {"properties": {"kind": {"enum": ["pickup", "dropOff"]}}}, "then": {"required": ["requestId"]}}
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationalCost", "stops"],
      "properties": {
        "operationalCost": {"$ref": "#/$defs/nonnegative"},
        "stops": {"type": "array", "items": {"$ref": "#/$defs/scheduledStop"}}
      }
    },
    "scheduledStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopId", "arrivalTimeMs", "serviceStartTimeMs", "departureTimeMs"],
      "properties": {
        "stopId": {"$ref": "#/$defs/identifier"},
        "arrivalTimeMs": {"$ref": "#/$defs/nonnegative"},
        "serviceStartTimeMs": {"$ref": "#/$defs/nonnegative"},
        "departureTimeMs": {"$ref": "#/$defs/nonnegative"}
      }
    }
  }
}
