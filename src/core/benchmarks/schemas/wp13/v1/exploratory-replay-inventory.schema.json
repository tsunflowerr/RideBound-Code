{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/exploratory-replay-inventory.schema.json",
  "title": "RideBound WP13 E1 exploratory replay inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaId", "reportType", "claimBoundary", "freezeReceipt", "sourceIdentity", "totals", "panels", "runs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {"const": "https://ridebound.local/schemas/wp13/v1/exploratory-replay-inventory.schema.json"},
    "reportType": {"const": "ridebound-wp13-e1-retained-portfolio-inventory-v1"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "interpretation", "h6", "outcomeSelection", "confirmatoryGate", "mechanismConclusion"],
      "properties": {
        "experiment": {"const": "postOutcomeExploratoryInstrumentationReplay"},
        "interpretation": {"const": "descriptiveExecutionInventoryOnlyNotCausal"},
        "h6": {"const": "readOnlyImmutableHistoricalEvidence"},
        "outcomeSelection": {"const": "allFrozenTargetsNoSubset"},
        "confirmatoryGate": {"const": "notApplicableCannotRescueH6"},
        "mechanismConclusion": {"const": "notEvaluatedInThisTicket"}
      }
    },
    "freezeReceipt": {"$ref": "#/$defs/freezeReceipt"},
    "sourceIdentity": {"$ref": "#/$defs/sourceIdentity"},
    "totals": {"$ref": "#/$defs/totals"},
    "panels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/panel"}
    },
    "runs": {
      "type": "array",
      "minItems": 80,
      "maxItems": 80,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "freezeReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freezeId", "frozenAtUtc", "lengthBytes", "sha256"],
      "properties": {
        "freezeId": {"const": "wp13-e1-retained-portfolio-replay-v1"},
        "frozenAtUtc": {"type": "string", "format": "date-time"},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerSourceSha256", "independentVerifierSourceSha256", "schemaSha256", "planASha256", "planBSha256"],
      "properties": {
        "analyzerSourceSha256": {"$ref": "#/$defs/sha256"},
        "independentVerifierSourceSha256": {"$ref": "#/$defs/sha256"},
        "schemaSha256": {"$ref": "#/$defs/sha256"},
        "planASha256": {"$ref": "#/$defs/sha256"},
        "planBSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairedTargetCount", "plannedArmRunCount", "completedVerifiedArmRunCount", "failureCount", "requestCount", "solverDecisionCount", "retainedPortfolioEvidenceCount", "repositoryInventorySha256", "totalBundleBytes", "maximumBundleBytes", "maximumWallMilliseconds"],
      "properties": {
        "pairedTargetCount": {"const": 40},
        "plannedArmRunCount": {"const": 80},
        "completedVerifiedArmRunCount": {"const": 80},
        "failureCount": {"const": 0},
        "requestCount": {"const": 8640},
        "solverDecisionCount": {"$ref": "#/$defs/positive"},
        "retainedPortfolioEvidenceCount": {"$ref": "#/$defs/positive"},
        "repositoryInventorySha256": {"$ref": "#/$defs/sha256"},
        "totalBundleBytes": {"$ref": "#/$defs/positive"},
        "maximumBundleBytes": {"$ref": "#/$defs/positive"},
        "maximumWallMilliseconds": {"$ref": "#/$defs/positive"}
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "planId", "root", "rootInventorySha256", "armRunCount", "requestCount", "solverDecisionCount", "retainedPortfolioEvidenceCount", "totalBundleBytes", "logFileCount", "logBytes"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "planId": {"$ref": "#/$defs/identifier"},
        "root": {"$ref": "#/$defs/identifier"},
        "rootInventorySha256": {"$ref": "#/$defs/sha256"},
        "armRunCount": {"const": 40},
        "requestCount": {"const": 4320},
        "solverDecisionCount": {"$ref": "#/$defs/positive"},
        "retainedPortfolioEvidenceCount": {"$ref": "#/$defs/positive"},
        "totalBundleBytes": {"$ref": "#/$defs/positive"},
        "logFileCount": {"$ref": "#/$defs/nonnegative"},
        "logBytes": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panelId", "unitId", "armId", "jobId", "sourceScenarioContentSha256", "repositoryInventorySha256", "bundleManifestSha256", "semanticHash", "behavioralProjectionHash", "requestCount", "solverDecisionCount", "retainedPortfolioEvidenceCount", "bundleFileCount", "bundleBytes", "wallMilliseconds", "userCpuMilliseconds", "systemCpuMilliseconds", "rssBeforeBytes", "rssAfterBytes"],
      "properties": {
        "panelId": {"enum": ["A", "B"]},
        "unitId": {"$ref": "#/$defs/identifier"},
        "armId": {"enum": ["b1", "c1"]},
        "jobId": {"$ref": "#/$defs/identifier"},
        "sourceScenarioContentSha256": {"$ref": "#/$defs/sha256"},
        "repositoryInventorySha256": {"$ref": "#/$defs/sha256"},
        "bundleManifestSha256": {"$ref": "#/$defs/sha256"},
        "semanticHash": {"$ref": "#/$defs/sha256"},
        "behavioralProjectionHash": {"$ref": "#/$defs/sha256"},
        "requestCount": {"const": 108},
        "solverDecisionCount": {"$ref": "#/$defs/positive"},
        "retainedPortfolioEvidenceCount": {"$ref": "#/$defs/positive"},
        "bundleFileCount": {"$ref": "#/$defs/positive"},
        "bundleBytes": {"$ref": "#/$defs/positive"},
        "wallMilliseconds": {"$ref": "#/$defs/positive"},
        "userCpuMilliseconds": {"$ref": "#/$defs/nonnegative"},
        "systemCpuMilliseconds": {"$ref": "#/$defs/nonnegative"},
        "rssBeforeBytes": {"$ref": "#/$defs/positive"},
        "rssAfterBytes": {"$ref": "#/$defs/positive"}
      }
    }
  }
}
