{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/closure-decision.schema.json",
  "title": "RideBound WP13 closure decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "reportType",
    "claimBoundary",
    "closureInput",
    "p3Resolutions",
    "exitGates",
    "retentionPolicy",
    "successorVerifierPolicy",
    "wp14Decision",
    "sourceIdentity",
    "verification"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "schemaId": {
      "const": "https://ridebound.local/schemas/wp13/v1/closure-decision.schema.json"
    },
    "reportType": {"const": "ridebound-wp13-closure-decision-v1"},
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation",
        "h6Result",
        "causalInference",
        "populationInference",
        "confirmatoryGate",
        "policySelection"
      ],
      "properties": {
        "interpretation": {"const": "assuranceAndReadinessDecisionOnly"},
        "h6Result": {"const": "immutableNegativeResultNotRescued"},
        "causalInference": {"const": "notEvaluated"},
        "populationInference": {"const": "notEvaluatedNoCiOrPValue"},
        "confirmatoryGate": {"const": "notApplicableCannotRescueH6"},
        "policySelection": {"const": "notPerformed"}
      }
    },
    "closureInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditReceipt",
        "repositoryInventory",
        "evidenceDag",
        "deepVerification"
      ],
      "properties": {
        "auditReceipt": {"$ref": "#/$defs/artifact"},
        "repositoryInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileCount", "totalBytes", "sha256"],
          "properties": {
            "fileCount": {"const": 80},
            "totalBytes": {"const": 1076880},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "evidenceDag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activeArtifactCount", "supersededArtifactCount", "failedEdgeCount"],
          "properties": {
            "activeArtifactCount": {"const": 10},
            "supersededArtifactCount": {"const": 3},
            "failedEdgeCount": {"const": 0}
          }
        },
        "deepVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "h6BundleCount",
            "h6SolverDecisionCount",
            "e1ArmRunCount",
            "e1RequestCount",
            "e1SolverDecisionCount",
            "e1PortfolioCount"
          ],
          "properties": {
            "h6BundleCount": {"const": 100},
            "h6SolverDecisionCount": {"const": 57806},
            "e1ArmRunCount": {"const": 80},
            "e1RequestCount": {"const": 8640},
            "e1SolverDecisionCount": {"const": 44156},
            "e1PortfolioCount": {"const": 44156}
          }
        }
      }
    },
    "p3Resolutions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/resolution"}
    },
    "exitGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLogicClaimAudit",
        "provenance",
        "architecture",
        "claimBoundary",
        "rawImmutability",
        "resourceReadiness",
        "wp14Separation"
      ],
      "properties": {
        "sourceLogicClaimAudit": {"$ref": "#/$defs/gate"},
        "provenance": {"$ref": "#/$defs/gate"},
        "architecture": {"$ref": "#/$defs/gate"},
        "claimBoundary": {"$ref": "#/$defs/gate"},
        "rawImmutability": {"$ref": "#/$defs/gate"},
        "resourceReadiness": {"$ref": "#/$defs/gate"},
        "wp14Separation": {"$ref": "#/$defs/gate"}
      }
    },
    "retentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "verifiedRawBytes",
        "archiveAction",
        "deletionPermitted",
        "futureMigrationRule"
      ],
      "properties": {
        "disposition": {"const": "retainVerifiedRawAndFreeze"},
        "verifiedRawBytes": {"const": 5516098710},
        "archiveAction": {"const": "notPerformed"},
        "deletionPermitted": {"const": false},
        "futureMigrationRule": {"const": "byteExactDualInventoryBeforeCutover"}
      }
    },
    "successorVerifierPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozenVerifierMutation",
        "futureVerifier",
        "canonicalIntegerGuard",
        "optionalFieldGuard",
        "utf8IdentifierGuard",
        "exclusiveCreate"
      ],
      "properties": {
        "frozenVerifierMutation": {"const": "forbidden"},
        "futureVerifier": {"const": "versionedSuccessorRequired"},
        "canonicalIntegerGuard": {"const": "requiredBooleanIsNotInteger"},
        "optionalFieldGuard": {"const": "requiredTypeOrOmissionNoNull"},
        "utf8IdentifierGuard": {"const": "requiredOneTo128Bytes"},
        "exclusiveCreate": {"const": "requiredForSuccessArtifacts"}
      }
    },
    "wp14Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "nextWorkPackage", "nextTicket", "constraints"],
      "properties": {
        "verdict": {"const": "openExploratoryAblationOnly"},
        "nextWorkPackage": {"const": "WP14"},
        "nextTicket": {"const": "RB-WP14-001"},
        "constraints": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "newDevelopmentNamespaceAndCells",
              "h6PanelsExcludedFromConfigurationSelection",
              "freezeBeforeOutcome",
              "pairedParetoReportNoScalarPostOutcomeSelection",
              "declaredDiskAndRuntimeEnvelope",
              "noH7OrPolicyV2Authorization"
            ]
          }
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaSha256", "policyDocument", "auditSchemaSha256"],
      "properties": {
        "schemaSha256": {"$ref": "#/$defs/sha256"},
        "policyDocument": {"$ref": "#/$defs/repositoryArtifact"},
        "auditSchemaSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolvedFindingCount",
        "dotNetPassed",
        "pinnedPythonPassed",
        "independentClosureTestsPassed"
      ],
      "properties": {
        "unresolvedFindingCount": {"const": 0},
        "dotNetPassed": {"type": "integer", "minimum": 860},
        "pinnedPythonPassed": {"type": "integer", "minimum": 199},
        "independentClosureTestsPassed": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "repositoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lengthBytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/benchmarking/"},
        "lengthBytes": {"$ref": "#/$defs/positive"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "status", "resolution", "owner"],
      "properties": {
        "findingId": {
          "enum": ["WP13-AUDIT-P3-001", "WP13-AUDIT-P3-002", "WP13-AUDIT-P3-003"]
        },
        "status": {"const": "resolvedByClosurePolicy"},
        "resolution": {"type": "string", "minLength": 1},
        "owner": {"const": "RB-WP13-013"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence"],
      "properties": {
        "verdict": {"const": "pass"},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
