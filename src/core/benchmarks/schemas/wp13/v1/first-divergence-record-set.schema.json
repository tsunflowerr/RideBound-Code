{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/first-divergence-record-set.schema.json",
  "title": "RideBound WP13 First-Divergence Record Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "contractIdentity",
    "sourceInventoryReport",
    "claimBoundary",
    "recordCount",
    "panelRecordCounts",
    "classificationCounts",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportType": { "const": "ridebound-wp13-first-divergence-record-set-v1" },
    "contractIdentity": { "$ref": "#/$defs/contractIdentity" },
    "sourceInventoryReport": { "$ref": "#/$defs/sourceInventoryReport" },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" },
    "recordCount": { "const": 40 },
    "panelRecordCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": { "const": 20 },
        "B": { "const": 20 }
      }
    },
    "classificationCounts": { "$ref": "#/$defs/classificationCounts" },
    "records": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordSetSchemaSha256", "generatorSourceSha256"],
      "properties": {
        "recordSetSchemaSha256": { "$ref": "#/$defs/sha256" },
        "generatorSourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceInventoryReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reportType",
        "lengthBytes",
        "sha256",
        "analyzerSourceSha256",
        "solverEvidenceVerifierSourceSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "reportType": { "const": "ridebound-wp13-h6-evidence-inventory-v1" },
        "lengthBytes": { "const": 73102 },
        "sha256": {
          "const": "6d36bc6e781f9fa5c32a024c3f5350271b806f43a7418f148ef5138fa1fff63e"
        },
        "analyzerSourceSha256": {
          "const": "0563ef2495550345c587ddbe07cf47a0ff88c38bf2b618dae6723c881ab1ab3b"
        },
        "solverEvidenceVerifierSourceSha256": {
          "const": "3eebec96b8370db2c4879adeaede3e67b7344571299a496953afcbc599dd93e5"
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignment", "interpretation", "h6Artifacts"],
      "properties": {
        "alignment": { "const": "equalObservedInputNotFullInternalState" },
        "interpretation": { "const": "descriptiveFirstDivergenceNotCausal" },
        "h6Artifacts": { "const": "readOnlyImmutableInputs" }
      }
    },
    "classificationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noneObserved",
        "observedInputDivergence",
        "operationalDecisionDivergenceOnEqualObservedInput",
        "transcriptLengthDivergence"
      ],
      "properties": {
        "noneObserved": { "$ref": "#/$defs/nonNegativeInteger" },
        "observedInputDivergence": { "$ref": "#/$defs/nonNegativeInteger" },
        "operationalDecisionDivergenceOnEqualObservedInput": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "transcriptLengthDivergence": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "armEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epochId",
        "simTimeMs",
        "observedInputProjectionSha256",
        "operationalDecisionProjectionSha256",
        "wireDecisionProjectionSha256",
        "eventTypes",
        "actionTypes"
      ],
      "properties": {
        "epochId": { "$ref": "#/$defs/positiveInteger" },
        "simTimeMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "observedInputProjectionSha256": { "$ref": "#/$defs/sha256" },
        "operationalDecisionProjectionSha256": { "$ref": "#/$defs/sha256" },
        "wireDecisionProjectionSha256": { "$ref": "#/$defs/sha256" },
        "eventTypes": { "$ref": "#/$defs/stringArray" },
        "actionTypes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "firstDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "observedInputRelation"],
      "properties": {
        "classification": {
          "enum": [
            "noneObserved",
            "observedInputDivergence",
            "operationalDecisionDivergenceOnEqualObservedInput",
            "transcriptLengthDivergence"
          ]
        },
        "observedInputRelation": {
          "enum": ["different", "equal", "equalThroughTranscript", "notComparable"]
        },
        "b1Evidence": { "$ref": "#/$defs/armEvidence" },
        "c1Evidence": { "$ref": "#/$defs/armEvidence" }
      },
      "oneOf": [
        {
          "properties": {
            "classification": {
              "const": "operationalDecisionDivergenceOnEqualObservedInput"
            },
            "observedInputRelation": { "const": "equal" }
          },
          "required": ["b1Evidence", "c1Evidence"]
        },
        {
          "properties": {
            "classification": { "const": "observedInputDivergence" },
            "observedInputRelation": { "const": "different" }
          },
          "required": ["b1Evidence", "c1Evidence"]
        },
        {
          "properties": {
            "classification": { "const": "transcriptLengthDivergence" },
            "observedInputRelation": { "const": "notComparable" }
          },
          "oneOf": [
            {
              "required": ["b1Evidence"],
              "not": { "required": ["c1Evidence"] }
            },
            {
              "required": ["c1Evidence"],
              "not": { "required": ["b1Evidence"] }
            }
          ]
        },
        {
          "properties": {
            "classification": { "const": "noneObserved" },
            "observedInputRelation": { "const": "equalThroughTranscript" }
          },
          "not": {
            "anyOf": [
              { "required": ["b1Evidence"] },
              { "required": ["c1Evidence"] }
            ]
          }
        }
      ]
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceInventoryReportSha256",
        "sourceInventoryReportLengthBytes",
        "panelBundleInventorySha256"
      ],
      "properties": {
        "sourceInventoryReportSha256": {
          "const": "6d36bc6e781f9fa5c32a024c3f5350271b806f43a7418f148ef5138fa1fff63e"
        },
        "sourceInventoryReportLengthBytes": { "const": 73102 },
        "panelBundleInventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "panelId",
        "unitId",
        "sourceScenarioContentSha256",
        "b1Label",
        "c1Label",
        "alignmentContractId",
        "equalObservedDecisionEpochCountBeforeDivergence",
        "stateHashMismatchBeforeDivergence",
        "wireOnlyDifferenceBeforeDivergence",
        "firstDivergence",
        "evidenceBinding",
        "contractIdentity",
        "claimBoundary"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "recordType": { "const": "ridebound-wp13-first-divergence-v1" },
        "panelId": { "enum": ["A", "B"] },
        "unitId": {
          "type": "string",
          "pattern": "^d[0-9]{8}-s[0-9]+-r[0-9]+$"
        },
        "sourceScenarioContentSha256": { "$ref": "#/$defs/sha256" },
        "b1Label": { "type": "string", "minLength": 1 },
        "c1Label": { "type": "string", "minLength": 1 },
        "alignmentContractId": {
          "const": "equal-observed-input-operational-v1"
        },
        "equalObservedDecisionEpochCountBeforeDivergence": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "stateHashMismatchBeforeDivergence": { "type": "boolean" },
        "firstStateHashMismatchEpoch": { "$ref": "#/$defs/positiveInteger" },
        "wireOnlyDifferenceBeforeDivergence": { "type": "boolean" },
        "firstWireOnlyDifferenceEpoch": { "$ref": "#/$defs/positiveInteger" },
        "firstDivergence": { "$ref": "#/$defs/firstDivergence" },
        "evidenceBinding": { "$ref": "#/$defs/evidenceBinding" },
        "contractIdentity": { "$ref": "#/$defs/contractIdentity" },
        "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stateHashMismatchBeforeDivergence": { "const": true }
            },
            "required": ["stateHashMismatchBeforeDivergence"]
          },
          "then": { "required": ["firstStateHashMismatchEpoch"] },
          "else": { "not": { "required": ["firstStateHashMismatchEpoch"] } }
        },
        {
          "if": {
            "properties": {
              "wireOnlyDifferenceBeforeDivergence": { "const": true }
            },
            "required": ["wireOnlyDifferenceBeforeDivergence"]
          },
          "then": { "required": ["firstWireOnlyDifferenceEpoch"] },
          "else": { "not": { "required": ["firstWireOnlyDifferenceEpoch"] } }
        },
        {
          "if": { "properties": { "panelId": { "const": "A" } } },
          "then": {
            "properties": {
              "evidenceBinding": {
                "properties": {
                  "panelBundleInventorySha256": {
                    "const": "0467c4d8a4d7dca41e543b4e2335c9e73c0074036b564dde4ece1024516ac53d"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "evidenceBinding": {
                "properties": {
                  "panelBundleInventorySha256": {
                    "const": "e36708efa51ede63195a45cf892a407c7083d6cffe5f30dbbfd23254c0f24c9e"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
