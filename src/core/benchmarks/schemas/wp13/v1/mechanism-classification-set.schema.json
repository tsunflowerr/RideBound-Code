{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/mechanism-classification-set.schema.json",
  "title": "RideBound WP13 evidence-supported mechanism classification set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "toolIdentity", "inputIdentity", "claimBoundary", "recordCount", "candidateLinkCount", "evidenceClassOccurrenceCounts", "acceptanceRelationCrossTab", "panelSummaries", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportType": {"const": "ridebound-wp13-mechanism-classification-set-v1"},
    "toolIdentity": {"type": "object", "additionalProperties": false, "required": ["classifierSourceSha256", "schemaSha256"], "properties": {"classifierSourceSha256": {"$ref": "#/$defs/hash"}, "schemaSha256": {"$ref": "#/$defs/hash"}}},
    "inputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["behavioralReportLengthBytes", "behavioralReportSha256", "behavioralComparatorSourceSha256", "relaxationReportLengthBytes", "relaxationReportSha256", "relaxationCalculatorSourceSha256", "relaxationSchemaSha256"],
      "properties": {
        "behavioralReportLengthBytes": {"$ref": "#/$defs/nonnegative"}, "behavioralReportSha256": {"$ref": "#/$defs/hash"},
        "behavioralComparatorSourceSha256": {"$ref": "#/$defs/hash"}, "relaxationReportLengthBytes": {"$ref": "#/$defs/nonnegative"},
        "relaxationReportSha256": {"$ref": "#/$defs/hash"}, "relaxationCalculatorSourceSha256": {"$ref": "#/$defs/hash"},
        "relaxationSchemaSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["analysisClass", "classificationScope", "causalAttribution", "downstreamTrajectory", "rankingVsSearchOmission", "candidateFeasibility", "interpretation", "h6Artifacts", "confirmatoryGate"],
      "properties": {
        "analysisClass": {"const": "postOutcomeExploratory"}, "classificationScope": {"const": "firstDivergenceEvidenceCooccurrence"},
        "causalAttribution": {"const": "notEstablished"}, "downstreamTrajectory": {"const": "notEvaluated"},
        "rankingVsSearchOmission": {"const": "notDistinguishableWhenPortfolioMissing"}, "candidateFeasibility": {"const": "notEvaluated"},
        "interpretation": {"const": "descriptiveNotCausal"}, "h6Artifacts": {"const": "readOnlyImmutableInputs"}, "confirmatoryGate": {"type": "null"}
      }
    },
    "recordCount": {"const": 40}, "candidateLinkCount": {"const": 41},
    "evidenceClassOccurrenceCounts": {"$ref": "#/$defs/classCounts"},
    "acceptanceRelationCrossTab": {"$ref": "#/$defs/crossTab"},
    "panelSummaries": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/panelSummary"}},
    "records": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "evidenceClass": {"enum": ["recordedBudgetWitness", "recordedLockWitness", "recordedPhysicalPruneCode", "sharedSelectedCandidate", "rankingOrSearchOmissionIndeterminate", "unsupportedRecordedPrune"]},
    "relation": {"enum": ["c1LowerImmediateAcceptance", "equalImmediateAcceptance", "c1HigherImmediateAcceptance"]},
    "strength": {"enum": ["recordedCandidateLinkNotCausal", "indeterminateMissingPortfolio", "unsupportedRecordedEvidence"]},
    "classCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["rankingOrSearchOmissionIndeterminate", "recordedBudgetWitness", "recordedLockWitness", "recordedPhysicalPruneCode", "sharedSelectedCandidate", "unsupportedRecordedPrune"],
      "properties": {
        "rankingOrSearchOmissionIndeterminate": {"$ref": "#/$defs/nonnegative"}, "recordedBudgetWitness": {"$ref": "#/$defs/nonnegative"},
        "recordedLockWitness": {"$ref": "#/$defs/nonnegative"}, "recordedPhysicalPruneCode": {"$ref": "#/$defs/nonnegative"},
        "sharedSelectedCandidate": {"$ref": "#/$defs/nonnegative"}, "unsupportedRecordedPrune": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "relationCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["c1HigherImmediateAcceptance", "c1LowerImmediateAcceptance", "equalImmediateAcceptance"],
      "properties": {"c1HigherImmediateAcceptance": {"$ref": "#/$defs/nonnegative"}, "c1LowerImmediateAcceptance": {"$ref": "#/$defs/nonnegative"}, "equalImmediateAcceptance": {"$ref": "#/$defs/nonnegative"}}
    },
    "crossTab": {
      "type": "object", "additionalProperties": false,
      "required": ["rankingOrSearchOmissionIndeterminate", "recordedBudgetWitness", "recordedLockWitness", "recordedPhysicalPruneCode", "sharedSelectedCandidate", "unsupportedRecordedPrune"],
      "properties": {
        "rankingOrSearchOmissionIndeterminate": {"$ref": "#/$defs/relationCounts"}, "recordedBudgetWitness": {"$ref": "#/$defs/relationCounts"},
        "recordedLockWitness": {"$ref": "#/$defs/relationCounts"}, "recordedPhysicalPruneCode": {"$ref": "#/$defs/relationCounts"},
        "sharedSelectedCandidate": {"$ref": "#/$defs/relationCounts"}, "unsupportedRecordedPrune": {"$ref": "#/$defs/relationCounts"}
      }
    },
    "candidateClassification": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "sourceCandidateLinkSha256", "sourceStatus", "evidenceClasses", "evidenceStrength"],
      "properties": {
        "candidateId": {"type": "string", "pattern": "^candidate-v1-[0-9a-f]{64}$"}, "sourceCandidateLinkSha256": {"$ref": "#/$defs/hash"},
        "sourceStatus": {"enum": ["absentRetainedOrOmittedNotRecorded", "prunedWithCommitmentWitness", "prunedWithoutCommitmentWitness", "selectedByC1"]},
        "evidenceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceClass"}},
        "evidenceStrength": {"$ref": "#/$defs/strength"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "panelId", "unitId", "epochId", "simTimeMs", "sourceBehavioralComparisonSha256", "sourceRelaxationRecordSha256", "immediateAcceptanceRelation", "acceptedCountDeltaC1MinusB1", "primaryBehaviorDifferenceClass", "evidenceClasses", "candidateClassifications", "causalAttribution", "downstreamTrajectory"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "recordType": {"const": "ridebound-wp13-mechanism-classification-v1"},
        "panelId": {"enum": ["A", "B"]}, "unitId": {"type": "string", "minLength": 1}, "epochId": {"type": "integer", "minimum": 1}, "simTimeMs": {"$ref": "#/$defs/nonnegative"},
        "sourceBehavioralComparisonSha256": {"$ref": "#/$defs/hash"}, "sourceRelaxationRecordSha256": {"$ref": "#/$defs/hash"},
        "immediateAcceptanceRelation": {"$ref": "#/$defs/relation"}, "acceptedCountDeltaC1MinusB1": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "primaryBehaviorDifferenceClass": {"type": "string", "minLength": 1}, "evidenceClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceClass"}},
        "candidateClassifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidateClassification"}},
        "causalAttribution": {"const": "notEstablished"}, "downstreamTrajectory": {"const": "notEvaluated"}
      }
    },
    "panelSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["panelId", "recordCount", "candidateLinkCount", "evidenceClassOccurrenceCounts", "acceptanceRelationCrossTab"],
      "properties": {"panelId": {"enum": ["A", "B"]}, "recordCount": {"const": 20}, "candidateLinkCount": {"$ref": "#/$defs/nonnegative"}, "evidenceClassOccurrenceCounts": {"$ref": "#/$defs/classCounts"}, "acceptanceRelationCrossTab": {"$ref": "#/$defs/crossTab"}}
    }
  }
}
