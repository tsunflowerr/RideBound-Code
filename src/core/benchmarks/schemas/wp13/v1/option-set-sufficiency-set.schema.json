{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp13/v1/option-set-sufficiency-set.schema.json",
  "title": "RideBound WP13 H6 option-set sufficiency record set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "toolIdentity", "inputIdentity", "claimBoundary", "fieldAvailability", "blockedQuestions", "evidenceVNextDecision", "recordCount", "armEpochCount", "panelSummaries", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportType": {"const": "ridebound-wp13-option-set-sufficiency-set-v1"},
    "toolIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzerSourceSha256", "schemaSha256"],
      "properties": {"analyzerSourceSha256": {"$ref": "#/$defs/hash"}, "schemaSha256": {"$ref": "#/$defs/hash"}}
    },
    "inputIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["firstDivergenceRecordSetSha256", "behavioralReportSha256", "relaxationReportLengthBytes", "relaxationReportSha256", "relaxationCalculatorSourceSha256", "relaxationSchemaSha256", "classificationReportLengthBytes", "classificationReportSha256", "classificationSourceSha256", "classificationSchemaSha256"],
      "properties": {
        "firstDivergenceRecordSetSha256": {"$ref": "#/$defs/hash"},
        "behavioralReportSha256": {"$ref": "#/$defs/hash"},
        "relaxationReportLengthBytes": {"$ref": "#/$defs/nonnegative"},
        "relaxationReportSha256": {"$ref": "#/$defs/hash"},
        "relaxationCalculatorSourceSha256": {"$ref": "#/$defs/hash"},
        "relaxationSchemaSha256": {"$ref": "#/$defs/hash"},
        "classificationReportLengthBytes": {"$ref": "#/$defs/nonnegative"},
        "classificationReportSha256": {"$ref": "#/$defs/hash"},
        "classificationSourceSha256": {"$ref": "#/$defs/hash"},
        "classificationSchemaSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["analysisClass", "optionSetScope", "candidateIdentityEquality", "candidateFeasibility", "causalAttribution", "downstreamTrajectory", "interpretation", "h6Artifacts", "confirmatoryGate"],
      "properties": {
        "analysisClass": {"const": "postOutcomeExploratory"},
        "optionSetScope": {"const": "recordedCountWorkOmissionAndSelectionCovariates"},
        "candidateIdentityEquality": {"const": "notEstablishedByAggregateEquality"},
        "candidateFeasibility": {"const": "notEvaluated"},
        "causalAttribution": {"const": "notEstablished"},
        "downstreamTrajectory": {"const": "notEvaluated"},
        "interpretation": {"const": "descriptiveNotCausal"},
        "h6Artifacts": {"const": "readOnlyImmutableInputs"},
        "confirmatoryGate": {"type": "null"}
      }
    },
    "fieldAvailability": {
      "type": "object", "additionalProperties": false,
      "required": ["generationCountWorkOmissionCovariates", "pruneWitnessCounts", "selectionCountWorkStatusCovariates", "fullRetainedCandidateIdentityPortfolio", "retainedCandidateRouteSchedulePortfolio", "perCandidateObjectiveVectorPortfolio", "perCandidateCommitmentVectorPortfolio", "prunedCandidateRouteSchedule", "candidateRankingPosition", "subsequentValidatorBlockersAfterFirstWitness", "candidateFeasibilityAfterClearance"],
      "properties": {
        "generationCountWorkOmissionCovariates": {"const": "recordedCountOnly"},
        "pruneWitnessCounts": {"const": "recordedCountOnly"},
        "selectionCountWorkStatusCovariates": {"const": "recordedCountOnly"},
        "fullRetainedCandidateIdentityPortfolio": {"const": "notRecorded"},
        "retainedCandidateRouteSchedulePortfolio": {"const": "notRecorded"},
        "perCandidateObjectiveVectorPortfolio": {"const": "notRecorded"},
        "perCandidateCommitmentVectorPortfolio": {"const": "notRecorded"},
        "prunedCandidateRouteSchedule": {"const": "notRecorded"},
        "candidateRankingPosition": {"const": "notRecorded"},
        "subsequentValidatorBlockersAfterFirstWitness": {"const": "notRecorded"},
        "candidateFeasibilityAfterClearance": {"const": "notEvaluated"}
      }
    },
    "blockedQuestions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["candidateLevelReranking", "retainedCandidateRouteScheduleComparison", "postRelaxationCandidateFeasibility", "laterValidatorBlockerEnumeration"]}},
    "evidenceVNextDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "unresolvedCandidateLinkCount", "unresolvedPairCount", "triggerReasons", "authorizesExploratoryRerun", "h6BackfillProhibited"],
      "properties": {
        "verdict": {"const": "requiredForCandidateLevelPortfolioAndReplayQuestions"},
        "unresolvedCandidateLinkCount": {"$ref": "#/$defs/nonnegative"},
        "unresolvedPairCount": {"$ref": "#/$defs/nonnegative"},
        "triggerReasons": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["unresolvedCandidateIdentityLinks", "retainedPortfolioNotRecorded", "postClearanceStateNotEvaluated"]}},
        "authorizesExploratoryRerun": {"const": false},
        "h6BackfillProhibited": {"const": true}
      }
    },
    "recordCount": {"const": 40},
    "armEpochCount": {"const": 80},
    "panelSummaries": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/panelSummary"}},
    "records": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "signed": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "generationKeys": {"enum": ["totalPendingRequestCount", "consideredRequestCount", "omittedRequestCount", "vehicleLossRecordCount", "explorationWorkUnits", "evaluatedCandidatePathCount", "uniqueFeasibleCandidateCountBeforeCap", "retainedCandidateCount", "physicallyOrSchedulePrunedCount", "omittedUnexpandedCandidatePathCount", "omittedFeasibleCandidateCountByCap", "eligibleRepairRequestCount", "consideredRepairRequestCount", "omittedRepairRequestCount", "generationOmissionRecordCount", "generationOmissionCountSum", "candidateCapAppliedVehicleCount", "workBudgetExhaustedVehicleCount", "omissionCountWasSaturatedVehicleCount"]},
    "generationCounts": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}, "propertyNames": {"$ref": "#/$defs/generationKeys"},
      "required": ["totalPendingRequestCount", "consideredRequestCount", "omittedRequestCount", "vehicleLossRecordCount", "explorationWorkUnits", "evaluatedCandidatePathCount", "uniqueFeasibleCandidateCountBeforeCap", "retainedCandidateCount", "physicallyOrSchedulePrunedCount", "omittedUnexpandedCandidatePathCount", "omittedFeasibleCandidateCountByCap", "eligibleRepairRequestCount", "consideredRepairRequestCount", "omittedRepairRequestCount", "generationOmissionRecordCount", "generationOmissionCountSum", "candidateCapAppliedVehicleCount", "workBudgetExhaustedVehicleCount", "omissionCountWasSaturatedVehicleCount"]
    },
    "signedGenerationDeltas": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/signed"}, "propertyNames": {"$ref": "#/$defs/generationKeys"},
      "required": ["totalPendingRequestCount", "consideredRequestCount", "omittedRequestCount", "vehicleLossRecordCount", "explorationWorkUnits", "evaluatedCandidatePathCount", "uniqueFeasibleCandidateCountBeforeCap", "retainedCandidateCount", "physicallyOrSchedulePrunedCount", "omittedUnexpandedCandidatePathCount", "omittedFeasibleCandidateCountByCap", "eligibleRepairRequestCount", "consideredRepairRequestCount", "omittedRepairRequestCount", "generationOmissionRecordCount", "generationOmissionCountSum", "candidateCapAppliedVehicleCount", "workBudgetExhaustedVehicleCount", "omissionCountWasSaturatedVehicleCount"]
    },
    "pruneKeys": {"enum": ["prunedCandidateCount", "physicalWitnessCandidateCount", "commitmentWitnessCandidateCount", "mixedWitnessCandidateCount", "untypedPrunedCandidateCount", "commitmentWitnessCount"]},
    "pruneCounts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}, "propertyNames": {"$ref": "#/$defs/pruneKeys"}, "required": ["prunedCandidateCount", "physicalWitnessCandidateCount", "commitmentWitnessCandidateCount", "mixedWitnessCandidateCount", "untypedPrunedCandidateCount", "commitmentWitnessCount"]},
    "signedPruneDeltas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/signed"}, "propertyNames": {"$ref": "#/$defs/pruneKeys"}, "required": ["prunedCandidateCount", "physicalWitnessCandidateCount", "commitmentWitnessCandidateCount", "mixedWitnessCandidateCount", "untypedPrunedCandidateCount", "commitmentWitnessCount"]},
    "selectionKeys": {"enum": ["consumedGenerationWorkUnits", "consumedValidationWorkUnits", "omittedCandidateCount", "fallbackValidationAttempts", "validationWitnessCount"]},
    "selectionCounts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}, "propertyNames": {"$ref": "#/$defs/selectionKeys"}, "required": ["consumedGenerationWorkUnits", "consumedValidationWorkUnits", "omittedCandidateCount", "fallbackValidationAttempts", "validationWitnessCount"]},
    "signedSelectionDeltas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/signed"}, "propertyNames": {"$ref": "#/$defs/selectionKeys"}, "required": ["consumedGenerationWorkUnits", "consumedValidationWorkUnits", "omittedCandidateCount", "fallbackValidationAttempts", "validationWitnessCount"]},
    "selectionStatuses": {
      "type": "object", "additionalProperties": false,
      "required": ["omissionCountWasSaturated", "primarySolveStatus", "finalSolveStatus", "executionPath", "primaryIncumbentRejected"],
      "properties": {
        "omissionCountWasSaturated": {"type": "boolean"},
        "primarySolveStatus": {"enum": ["optimal", "feasible", "infeasible", "unknown", "modelInvalid", "safeFallback"]},
        "finalSolveStatus": {"enum": ["optimal", "feasible", "infeasible", "unknown", "modelInvalid", "safeFallback"]},
        "executionPath": {"enum": ["none", "validatedIncumbent", "safeNoOp", "greedySingleRequest"]},
        "primaryIncumbentRejected": {"type": "boolean"}
      }
    },
    "armCovariates": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceVersion", "generationEvidenceSha256", "selectionEvidenceSha256", "generationCounts", "generationCompleteFromRecordedCounters", "pruneCounts", "selectionCounts", "selectionStatuses"],
      "properties": {
        "evidenceVersion": {"const": "1.0.0"},
        "generationEvidenceSha256": {"$ref": "#/$defs/hash"},
        "selectionEvidenceSha256": {"$ref": "#/$defs/hash"},
        "generationCounts": {"$ref": "#/$defs/generationCounts"},
        "generationCompleteFromRecordedCounters": {"type": "boolean"},
        "pruneCounts": {"$ref": "#/$defs/pruneCounts"},
        "selectionCounts": {"$ref": "#/$defs/selectionCounts"},
        "selectionStatuses": {"$ref": "#/$defs/selectionStatuses"}
      }
    },
    "rawEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["b1BundleManifestSha256", "b1TranscriptSha256", "c1BundleManifestSha256", "c1TranscriptSha256"],
      "properties": {"b1BundleManifestSha256": {"$ref": "#/$defs/hash"}, "b1TranscriptSha256": {"$ref": "#/$defs/hash"}, "c1BundleManifestSha256": {"$ref": "#/$defs/hash"}, "c1TranscriptSha256": {"$ref": "#/$defs/hash"}}
    },
    "candidateIdentityGap": {
      "type": "object", "additionalProperties": false,
      "required": ["unresolvedCandidateLinkCount", "resolutionStatus"],
      "properties": {"unresolvedCandidateLinkCount": {"$ref": "#/$defs/nonnegative"}, "resolutionStatus": {"enum": ["notApplicableNoUnresolvedLink", "notRecorded"]}},
      "allOf": [
        {"if": {"properties": {"unresolvedCandidateLinkCount": {"const": 0}}}, "then": {"properties": {"resolutionStatus": {"const": "notApplicableNoUnresolvedLink"}}}},
        {"if": {"properties": {"unresolvedCandidateLinkCount": {"minimum": 1}}}, "then": {"properties": {"resolutionStatus": {"const": "notRecorded"}}}}
      ]
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "panelId", "unitId", "epochId", "simTimeMs", "sourceFirstDivergenceRecordSha256", "sourceBehavioralComparisonSha256", "sourceRelaxationRecordSha256", "sourceClassificationRecordSha256", "rawEvidence", "immediateAcceptanceRelation", "evidenceClasses", "candidateIdentityGap", "arms", "pairedRelations", "causalAttribution", "downstreamTrajectory"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"}, "recordType": {"const": "ridebound-wp13-option-set-sufficiency-v1"},
        "panelId": {"enum": ["A", "B"]}, "unitId": {"type": "string", "minLength": 1},
        "epochId": {"$ref": "#/$defs/nonnegative"}, "simTimeMs": {"$ref": "#/$defs/nonnegative"},
        "sourceFirstDivergenceRecordSha256": {"$ref": "#/$defs/hash"}, "sourceBehavioralComparisonSha256": {"$ref": "#/$defs/hash"},
        "sourceRelaxationRecordSha256": {"$ref": "#/$defs/hash"}, "sourceClassificationRecordSha256": {"$ref": "#/$defs/hash"},
        "rawEvidence": {"$ref": "#/$defs/rawEvidence"},
        "immediateAcceptanceRelation": {"enum": ["c1HigherImmediateAcceptance", "c1LowerImmediateAcceptance", "equalImmediateAcceptance"]},
        "evidenceClasses": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["recordedBudgetWitness", "recordedLockWitness", "recordedPhysicalPruneCode", "sharedSelectedCandidate", "rankingOrSearchOmissionIndeterminate", "unsupportedRecordedPrune"]}},
        "candidateIdentityGap": {"$ref": "#/$defs/candidateIdentityGap"},
        "arms": {"type": "object", "additionalProperties": false, "required": ["b1", "c1"], "properties": {"b1": {"$ref": "#/$defs/armCovariates"}, "c1": {"$ref": "#/$defs/armCovariates"}}},
        "pairedRelations": {
          "type": "object", "additionalProperties": false,
          "required": ["generationEvidenceRelation", "allRecordedCountCovariatesRelation", "selectionEvidenceRelation", "generationCountDeltasC1MinusB1", "pruneCountDeltasC1MinusB1", "selectionCountDeltasC1MinusB1", "candidateIdentityEquality"],
          "properties": {
            "generationEvidenceRelation": {"enum": ["exactEqual", "different"]}, "allRecordedCountCovariatesRelation": {"enum": ["exactEqual", "different"]}, "selectionEvidenceRelation": {"enum": ["exactEqual", "different"]},
            "generationCountDeltasC1MinusB1": {"$ref": "#/$defs/signedGenerationDeltas"}, "pruneCountDeltasC1MinusB1": {"$ref": "#/$defs/signedPruneDeltas"}, "selectionCountDeltasC1MinusB1": {"$ref": "#/$defs/signedSelectionDeltas"},
            "candidateIdentityEquality": {"const": "notEstablishedByAggregateEquality"}
          }
        },
        "causalAttribution": {"const": "notEstablished"}, "downstreamTrajectory": {"const": "notEvaluated"}
      }
    },
    "armTotals": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"},
      "propertyNames": {"enum": ["armEpochCount", "generationCompleteEpochCount", "candidateCapAppliedEpochCount", "workBudgetExhaustedEpochCount", "generationOmissionEpochCount", "selectionOmissionEpochCount", "retainedCandidateCount", "prunedCandidateCount", "commitmentWitnessCandidateCount", "consumedValidationWorkUnits"]},
      "required": ["armEpochCount", "generationCompleteEpochCount", "candidateCapAppliedEpochCount", "workBudgetExhaustedEpochCount", "generationOmissionEpochCount", "selectionOmissionEpochCount", "retainedCandidateCount", "prunedCandidateCount", "commitmentWitnessCandidateCount", "consumedValidationWorkUnits"]
    },
    "panelSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["panelId", "recordCount", "armEpochCount", "unresolvedCandidateLinkCount", "unresolvedPairCount", "exactGenerationEvidencePairCount", "exactRecordedCountCovariatePairCount", "armTotals"],
      "properties": {
        "panelId": {"enum": ["A", "B"]}, "recordCount": {"const": 20}, "armEpochCount": {"const": 40},
        "unresolvedCandidateLinkCount": {"$ref": "#/$defs/nonnegative"}, "unresolvedPairCount": {"$ref": "#/$defs/nonnegative"},
        "exactGenerationEvidencePairCount": {"$ref": "#/$defs/nonnegative"}, "exactRecordedCountCovariatePairCount": {"$ref": "#/$defs/nonnegative"},
        "armTotals": {"type": "object", "additionalProperties": false, "required": ["b1", "c1"], "properties": {"b1": {"$ref": "#/$defs/armTotals"}, "c1": {"$ref": "#/$defs/armTotals"}}}
      }
    }
  }
}
