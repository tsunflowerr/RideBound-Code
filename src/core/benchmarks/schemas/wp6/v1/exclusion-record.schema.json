{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/exclusion-record.schema.json",
  "title": "RideBound WP6 Exclusion Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordSequence", "exclusionRecordId", "ruleId", "ruleVersion", "ruleSetHash", "stage", "subjectKind", "subjectId", "beforeOutcome", "evidenceRelativePath", "evidenceSha256", "retainedDenominatorIds", "safeReason"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recordSequence": { "$ref": "common.schema.json#/$defs/positive" },
    "exclusionRecordId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "ruleId": { "enum": ["source.license-not-accepted", "source.checksum-mismatch", "source.invalid-record", "source.unreachable-node-pair", "scenario.exceeds-declared-capability", "scenario.unsupported-position-model", "arm.missing-required-capability", "arm.incomparable-pairing-class"] },
    "ruleVersion": { "$ref": "common.schema.json#/$defs/version" },
    "ruleSetHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "stage": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "subjectKind": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "subjectId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "armId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "repeatIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "beforeOutcome": { "const": true },
    "evidenceRelativePath": { "type": "string", "minLength": 1 },
    "evidenceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "retainedDenominatorIds": { "$ref": "common.schema.json#/$defs/opaqueSet", "minItems": 1 },
    "safeReason": { "type": "string", "minLength": 1 }
  }
}
