{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/scenario-content.schema.json",
  "title": "RideBound WP6 Scenario Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "scenarioKind", "evidenceClass", "datasetId", "sourceArtifactSha256", "sourceSelectionSha256", "normalizerId", "normalizerVersion", "normalizerSourceSha256", "normalizerConfigurationSha256", "eventOrderingId", "driverSemanticsId", "timeWindow", "fleet", "requests", "travelSnapshots", "events", "validationSummary"],
  "properties": {
    "schemaVersion": { "const": "1.0.1" },
    "scenarioId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "scenarioKind": { "enum": ["protocolFixture", "publicDerivative", "syntheticStress"] },
    "evidenceClass": { "enum": ["mechanical", "development", "pilot", "confirmatory"] },
    "datasetId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "sourceArtifactSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "sourceSelectionSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "normalizerId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "normalizerVersion": { "$ref": "common.schema.json#/$defs/version" },
    "normalizerSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "normalizerConfigurationSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "eventOrderingId": { "const": "ridebound-event-order-v1" },
    "driverSemanticsId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "timeWindow": { "$ref": "common.schema.json#/$defs/timeWindow" },
    "fleet": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/scenarioVehicle" } },
    "requests": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/scenarioRequest" } },
    "travelSnapshots": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/travelSnapshot" } },
    "events": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/scenarioEvent" } },
    "validationSummary": { "$ref": "common.schema.json#/$defs/validationSummary" }
  },
  "not": { "required": ["scenarioHash"] }
}
