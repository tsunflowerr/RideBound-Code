{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/common.schema.json",
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-maxUtf8Bytes": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "opaqueSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/opaqueId" },
      "uniqueItems": true
    },
    "nodePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nodeId"],
      "properties": {
        "kind": { "const": "node" },
        "nodeId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "edgeProgressPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fromNodeId", "toNodeId", "edgeId", "progressPermille"],
      "properties": {
        "kind": { "const": "edgeProgress" },
        "fromNodeId": { "$ref": "#/$defs/opaqueId" },
        "toNodeId": { "$ref": "#/$defs/opaqueId" },
        "edgeId": { "$ref": "#/$defs/opaqueId" },
        "progressPermille": { "type": "integer", "minimum": 1, "maximum": 999 }
      }
    },
    "position": {
      "oneOf": [
        { "$ref": "#/$defs/nodePosition" },
        { "$ref": "#/$defs/edgeProgressPosition" }
      ]
    },
    "routeStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopId", "nodeId", "kind", "serviceDurationMs"],
      "properties": {
        "stopId": { "$ref": "#/$defs/opaqueId" },
        "nodeId": { "$ref": "#/$defs/opaqueId" },
        "kind": { "enum": ["waypoint", "pickup", "dropOff"] },
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "serviceDurationMs": { "$ref": "#/$defs/nonNegative" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "waypoint" } } },
          "then": { "not": { "required": ["requestId"] } },
          "else": { "required": ["requestId"] }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planVersion", "executedStopCount", "frozenPrefix", "mutableSuffix"],
      "properties": {
        "planVersion": { "$ref": "#/$defs/nonNegative" },
        "executedStopCount": { "$ref": "#/$defs/nonNegative" },
        "frozenPrefix": { "type": "array", "items": { "$ref": "#/$defs/routeStop" } },
        "mutableSuffix": { "type": "array", "items": { "$ref": "#/$defs/routeStop" } }
      }
    },
    "scenarioVehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicleId", "capacity", "occupiedSeats", "position", "onboardRequestIds", "acceptedRequestIds", "initialRoute", "sourceProvenanceId"],
      "properties": {
        "vehicleId": { "$ref": "#/$defs/opaqueId" },
        "capacity": { "$ref": "#/$defs/positive" },
        "occupiedSeats": { "$ref": "#/$defs/nonNegative" },
        "position": { "$ref": "#/$defs/position" },
        "onboardRequestIds": { "$ref": "#/$defs/opaqueSet" },
        "acceptedRequestIds": { "$ref": "#/$defs/opaqueSet" },
        "initialRoute": { "$ref": "#/$defs/route" },
        "sourceProvenanceId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "scenarioRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "sourceRecordOrdinal", "arrivalTimeMs", "originNodeId", "destinationNodeId", "earliestPickupMs", "latestPickupMs", "maxRideTimeMs", "partySize", "serviceClass", "commitmentPolicyId", "policyObservationClass", "sourceProvenanceId"],
      "properties": {
        "requestId": { "$ref": "#/$defs/opaqueId" },
        "sourceRecordOrdinal": { "$ref": "#/$defs/nonNegative" },
        "arrivalTimeMs": { "$ref": "#/$defs/nonNegative" },
        "originNodeId": { "$ref": "#/$defs/opaqueId" },
        "destinationNodeId": { "$ref": "#/$defs/opaqueId" },
        "earliestPickupMs": { "$ref": "#/$defs/nonNegative" },
        "latestPickupMs": { "$ref": "#/$defs/nonNegative" },
        "maxRideTimeMs": { "$ref": "#/$defs/positive" },
        "partySize": { "$ref": "#/$defs/positive" },
        "serviceClass": { "$ref": "#/$defs/opaqueId" },
        "commitmentPolicyId": { "$ref": "#/$defs/opaqueId" },
        "policyObservationClass": { "enum": ["fixtureDefined", "observed", "syntheticPolicyOverlay"] },
        "sourceProvenanceId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "travelArc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromNodeId", "toNodeId", "travelTimeMs"],
      "properties": {
        "fromNodeId": { "$ref": "#/$defs/opaqueId" },
        "toNodeId": { "$ref": "#/$defs/opaqueId" },
        "travelTimeMs": { "$ref": "#/$defs/positive" }
      }
    },
    "travelSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshotHash", "arcs"],
      "properties": {
        "version": { "$ref": "#/$defs/positive" },
        "snapshotHash": { "$ref": "#/$defs/sha256" },
        "arcs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/travelArc" } }
      }
    },
    "scenarioEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventSequence", "simTimeMs", "eventType", "sourceRecordOrdinal", "stableSubjectId", "sourceSequencePreserved", "payloadCanonicalJsonHex", "payloadSha256", "sourceProvenanceId"],
      "properties": {
        "eventSequence": { "$ref": "#/$defs/positive" },
        "simTimeMs": { "$ref": "#/$defs/nonNegative" },
        "eventType": { "$ref": "#/$defs/opaqueId" },
        "sourceRecordOrdinal": { "$ref": "#/$defs/nonNegative" },
        "stableSubjectId": { "$ref": "#/$defs/opaqueId" },
        "sourceSequencePreserved": { "type": "boolean" },
        "payloadCanonicalJsonHex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "sourceProvenanceId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceTimezoneId", "sourceWindowStartUtc", "sourceWindowEndUtc", "warmupStartMs", "scoreStartMs", "horizonEndMs", "drainEndMs", "batchingId"],
      "properties": {
        "sourceTimezoneId": { "type": "string", "minLength": 1 },
        "sourceWindowStartUtc": { "$ref": "#/$defs/utc" },
        "sourceWindowEndUtc": { "$ref": "#/$defs/utc" },
        "warmupStartMs": { "const": 0 },
        "scoreStartMs": { "$ref": "#/$defs/nonNegative" },
        "horizonEndMs": { "$ref": "#/$defs/positive" },
        "drainEndMs": { "$ref": "#/$defs/nonNegative" },
        "batchingId": { "$ref": "#/$defs/artifactId" }
      }
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicleCount", "requestCount", "nodeCount", "directedArcCount", "snapshotCount", "eventCount", "excludedSourceRowCount", "selectedSourceRowCount", "duplicateIdCount", "unreachableSelectedRowCount", "invalidTimeRowCount", "overflowRowCount", "invariantSetHash"],
      "properties": {
        "vehicleCount": { "$ref": "#/$defs/nonNegative" },
        "requestCount": { "$ref": "#/$defs/nonNegative" },
        "nodeCount": { "$ref": "#/$defs/nonNegative" },
        "directedArcCount": { "$ref": "#/$defs/nonNegative" },
        "snapshotCount": { "$ref": "#/$defs/nonNegative" },
        "eventCount": { "$ref": "#/$defs/nonNegative" },
        "excludedSourceRowCount": { "$ref": "#/$defs/nonNegative" },
        "selectedSourceRowCount": { "$ref": "#/$defs/nonNegative" },
        "duplicateIdCount": { "const": 0 },
        "unreachableSelectedRowCount": { "const": 0 },
        "invalidTimeRowCount": { "const": 0 },
        "overflowRowCount": { "const": 0 },
        "invariantSetHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "runnerArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerExecutableSha256", "runnerAssemblySha256", "contractsAssemblySha256", "runtimeInventorySha256", "launchContractId"],
      "properties": {
        "runnerExecutableSha256": { "$ref": "#/$defs/sha256" },
        "runnerAssemblySha256": { "$ref": "#/$defs/sha256" },
        "contractsAssemblySha256": { "$ref": "#/$defs/sha256" },
        "runtimeInventorySha256": { "$ref": "#/$defs/sha256" },
        "launchContractId": { "$ref": "#/$defs/artifactId" }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armId", "policyId", "policyVersion", "policyConfigurationSha256", "effectiveConfigurationSha256", "candidateGeneratorId", "candidateWorkBudget", "validatorVersion", "solverId", "solverVersion", "solverWorkBudget", "capabilitySelectionSha256", "pairingClassId"],
      "properties": {
        "armId": { "$ref": "#/$defs/artifactId" },
        "policyId": { "$ref": "#/$defs/opaqueId" },
        "policyVersion": { "$ref": "#/$defs/opaqueId" },
        "policyConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "effectiveConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "candidateGeneratorId": { "$ref": "#/$defs/artifactId" },
        "candidateWorkBudget": { "$ref": "#/$defs/nonNegative" },
        "validatorVersion": { "$ref": "#/$defs/opaqueId" },
        "solverId": { "$ref": "#/$defs/opaqueId" },
        "solverVersion": { "$ref": "#/$defs/opaqueId" },
        "solverWorkBudget": { "$ref": "#/$defs/nonNegative" },
        "capabilitySelectionSha256": { "$ref": "#/$defs/sha256" },
        "pairingClassId": { "enum": ["wp4-common-candidate-v1", "wp4-multiple-plan-v1", "mechanical-single-arm-v1"] }
      }
    },
    "runFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "lengthBytes", "sha256"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\\\]+$" },
        "lengthBytes": { "$ref": "#/$defs/nonNegative" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "lengthBytes", "sha256", "mediaType", "role", "producerActivityId", "sourceEntityIds"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^data/(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[^\\\\]+$" },
        "lengthBytes": { "$ref": "#/$defs/nonNegative" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 },
        "role": { "enum": ["plan", "dataset", "scenario", "runEvidence", "failureLog", "exclusionLog", "metric", "provenance", "sourceInventory", "claimCheck", "verificationReport"] },
        "producerActivityId": { "$ref": "#/$defs/opaqueId" },
        "sourceEntityIds": { "$ref": "#/$defs/opaqueSet" }
      }
    }
  }
}
