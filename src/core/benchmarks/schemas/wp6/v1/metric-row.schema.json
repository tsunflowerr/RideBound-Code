{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/metric-row.schema.json",
  "title": "RideBound WP6 Metric Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metricRegistryHash", "metricId", "metricVersion", "runId", "scenarioHash", "armId", "repeatIndex", "attemptIndex", "scopeKind", "scopeId", "windowId", "valueStatus", "unitId", "rawEvidenceSha256", "calculatorSourceSha256"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "metricRegistryHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "metricId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "metricVersion": { "$ref": "common.schema.json#/$defs/version" },
    "runId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "armId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "repeatIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "attemptIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "scopeKind": { "enum": ["run", "epoch", "request", "vehicle"] },
    "scopeId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "windowId": { "enum": ["all", "warmup", "scoring", "drain"] },
    "valueStatus": { "enum": ["observed", "missing", "notApplicable"] },
    "valueInteger": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "unitId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "numeratorInteger": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "denominatorId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "denominatorInteger": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "missingReasonId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "rawEvidenceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "calculatorSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "valueStatus": { "const": "observed" } }, "required": ["valueStatus"] },
      "then": { "required": ["valueInteger"], "not": { "required": ["missingReasonId"] } }
    },
    {
      "if": { "properties": { "valueStatus": { "enum": ["missing", "notApplicable"] } }, "required": ["valueStatus"] },
      "then": { "required": ["missingReasonId"], "not": { "required": ["valueInteger"] } }
    }
  ]
}
