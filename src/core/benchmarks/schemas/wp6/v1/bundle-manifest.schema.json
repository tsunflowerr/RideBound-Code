{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/bundle-manifest.schema.json",
  "title": "RideBound WP6 Logical Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bundleId", "evidenceClass", "claimProfileId", "planHash", "metricSetHash", "sourceInventorySha256", "runtimeInventorySha256", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "bundleId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "evidenceClass": { "enum": ["mechanical", "development"] },
    "claimProfileId": { "const": "wp6-mechanical-only-v1" },
    "planHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "metricSetHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "sourceInventorySha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "runtimeInventorySha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/bundleArtifact" } }
  },
  "not": { "required": ["bundleHash"] }
}
