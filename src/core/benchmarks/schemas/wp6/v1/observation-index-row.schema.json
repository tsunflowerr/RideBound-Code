{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/observation-index-row.schema.json",
  "title": "RideBound WP6 Observation Index Row v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordSequence", "recordKind", "runId", "scenarioHash", "armId", "repeatIndex", "attemptIndex", "transcriptRole", "lineNumber", "envelopeSha256", "requestIds", "vehicleIds"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "recordSequence": { "$ref": "common.schema.json#/$defs/positive" },
    "recordKind": { "enum": ["inputEvent", "outputDecision", "decisionAck", "checkpoint", "runTerminal"] },
    "runId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "armId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "repeatIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "attemptIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "transcriptRole": { "enum": ["input", "output"] },
    "lineNumber": { "$ref": "common.schema.json#/$defs/positive" },
    "envelopeSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "epochId": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "simTimeMs": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "eventSequence": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "requestIds": { "$ref": "common.schema.json#/$defs/opaqueSet" },
    "vehicleIds": { "$ref": "common.schema.json#/$defs/opaqueSet" },
    "decisionHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "certificateHash": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
