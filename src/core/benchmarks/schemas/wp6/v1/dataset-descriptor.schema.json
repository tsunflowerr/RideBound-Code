{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/dataset-descriptor.schema.json",
  "title": "RideBound WP6 Dataset Descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "datasetKind", "title", "releaseVersion", "persistentUri", "downloadUri", "retrievedAtUtc", "publisherArtifactName", "licenseSpdx", "licenseUri", "citation", "composition", "collectionLimit", "allowedUse", "forbiddenClaim", "directIdentifierStatus", "locationPrecisionClass", "retentionClass", "maintenanceNote"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "datasetKind": { "enum": ["public", "synthetic", "restrictedReal"] },
    "title": { "type": "string", "minLength": 1 },
    "releaseVersion": { "$ref": "common.schema.json#/$defs/releaseVersion" },
    "persistentUri": { "type": "string", "format": "uri" },
    "downloadUri": { "type": "string", "format": "uri" },
    "retrievedAtUtc": { "$ref": "common.schema.json#/$defs/utc" },
    "publisherArtifactName": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
    "publisherArtifactLengthBytes": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "publisherMd5": { "$ref": "common.schema.json#/$defs/md5" },
    "sourceArtifactSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "licenseSpdx": { "type": "string", "minLength": 1 },
    "licenseUri": { "type": "string", "format": "uri" },
    "citation": { "type": "string", "minLength": 1 },
    "composition": { "type": "string", "minLength": 1 },
    "collectionLimit": { "type": "string", "minLength": 1 },
    "allowedUse": { "$ref": "common.schema.json#/$defs/opaqueSet", "minItems": 1 },
    "forbiddenClaim": { "$ref": "common.schema.json#/$defs/opaqueSet", "minItems": 1 },
    "directIdentifierStatus": { "enum": ["noneObserved", "removedBySource", "presentRestricted"] },
    "locationPrecisionClass": { "enum": ["roadNode", "zone", "coordinateE7", "synthetic"] },
    "retentionClass": { "enum": ["localRawCache", "redistributableDerivative", "restrictedNoRedistribution"] },
    "maintenanceNote": { "type": "string", "minLength": 1 }
  }
}
