{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/failure-record.schema.json",
  "title": "RideBound WP6 Failure Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordSequence", "failureRecordId", "runId", "planHash", "scenarioHash", "armId", "repeatIndex", "attemptIndex", "code", "stage", "firstObservedMonotonicOffsetMs", "sourceComponent", "evidenceRelativePath", "evidenceSha256", "safeMessage", "retryAuthorization", "affectedDenominatorIds"],
  "properties": {
    "schemaVersion": { "const": "1.0.2" },
    "recordSequence": { "$ref": "common.schema.json#/$defs/positive" },
    "failureRecordId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "runId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "planHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "armId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "repeatIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "attemptIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "code": { "enum": ["input.invalid", "artifact.mismatch", "capability.divergence", "process.start-failed", "process.crash", "process.cancelled", "harness.persistence-incomplete", "resource.wall-time-exceeded", "resource.cpu-time-exceeded", "resource.memory-exceeded", "resource.process-count-exceeded", "resource.stdin-bytes-exceeded", "resource.stdout-bytes-exceeded", "resource.stderr-bytes-exceeded", "solver.unknown", "protocol.invalid-output", "protocol.incomplete-output", "state.divergence", "metric.oracle-mismatch", "bundle.invalid"] },
    "stage": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "firstObservedMonotonicOffsetMs": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "sourceComponent": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "evidenceRelativePath": { "type": "string", "minLength": 1 },
    "evidenceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "safeMessage": { "type": "string", "minLength": 1 },
    "retryAuthorization": { "const": "none" },
    "affectedDenominatorIds": { "$ref": "common.schema.json#/$defs/opaqueSet", "minItems": 1 }
  }
}
