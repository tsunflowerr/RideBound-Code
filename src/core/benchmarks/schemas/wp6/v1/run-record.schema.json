{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/run-record.schema.json",
  "title": "RideBound WP6 Terminal Run Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "planHash", "scenarioHash", "armId", "repeatIndex", "attemptIndex", "policyConfigurationSha256", "effectiveConfigurationSha256", "componentSeedHex", "runnerArtifactSha256", "harnessSourceSha256", "executionOrdinal", "warmup", "terminalStatus", "startedAtUtc", "finishedAtUtc", "wallTimeMs", "cpuTimeMs", "peakWorkingSetBytes", "spawnedProcessCount", "artifactPreflightSha256", "artifactPostflightSha256", "inputFile", "outputFile", "stderrFile", "resourceSamplesFile", "observationIndexFile"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "planHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "armId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "repeatIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "attemptIndex": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "policyConfigurationSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "effectiveConfigurationSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "componentSeedHex": { "$ref": "common.schema.json#/$defs/sha256" },
    "runnerArtifactSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "harnessSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "executionOrdinal": { "$ref": "common.schema.json#/$defs/positive" },
    "warmup": { "type": "boolean" },
    "terminalStatus": { "enum": ["succeeded", "failed", "excluded"] },
    "startedAtUtc": { "$ref": "common.schema.json#/$defs/utc" },
    "finishedAtUtc": { "$ref": "common.schema.json#/$defs/utc" },
    "wallTimeMs": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "cpuTimeMs": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "peakWorkingSetBytes": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "spawnedProcessCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "exitCode": { "$ref": "common.schema.json#/$defs/safeInteger" },
    "artifactPreflightSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifactPostflightSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "inputFile": { "$ref": "common.schema.json#/$defs/runFile" },
    "outputFile": { "$ref": "common.schema.json#/$defs/runFile" },
    "stderrFile": { "$ref": "common.schema.json#/$defs/runFile" },
    "resourceSamplesFile": { "$ref": "common.schema.json#/$defs/runFile" },
    "observationIndexFile": { "$ref": "common.schema.json#/$defs/runFile" },
    "lastEpochId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "lastEventHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "lastDecisionHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "lastCheckpointHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "failureRecordId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "exclusionRecordId": { "$ref": "common.schema.json#/$defs/artifactId" }
  },
  "allOf": [
    {
      "if": { "properties": { "terminalStatus": { "const": "succeeded" } }, "required": ["terminalStatus"] },
      "then": { "required": ["exitCode"], "properties": { "exitCode": { "const": 0 } }, "not": { "anyOf": [{ "required": ["failureRecordId"] }, { "required": ["exclusionRecordId"] }] } }
    },
    {
      "if": { "properties": { "terminalStatus": { "const": "failed" } }, "required": ["terminalStatus"] },
      "then": { "required": ["failureRecordId"], "not": { "required": ["exclusionRecordId"] } }
    },
    {
      "if": { "properties": { "terminalStatus": { "const": "excluded" } }, "required": ["terminalStatus"] },
      "then": { "required": ["exclusionRecordId"], "not": { "required": ["failureRecordId"] } }
    }
  ]
}
