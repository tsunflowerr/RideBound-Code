{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/normalization-report.schema.json",
  "title": "RideBound WP6 Normalization Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "datasetId", "sourceArtifactSha256", "sourceMemberInventorySha256", "normalizerId", "normalizerVersion", "normalizerSourceSha256", "configurationSha256", "inputRecordCount", "eligibleRecordCount", "selectedRecordCount", "excludedRecordCount", "selectionFrameSha256", "exclusionLogSha256", "roundingRuleId", "eventOrderingId", "selectionRuleId", "scenarioContentSha256", "scenarioHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.1" },
    "reportId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "datasetId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "sourceArtifactSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "sourceMemberInventorySha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "normalizerId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "normalizerVersion": { "$ref": "common.schema.json#/$defs/version" },
    "normalizerSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "configurationSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "inputRecordCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "eligibleRecordCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "selectedRecordCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "excludedRecordCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "selectionFrameSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "exclusionLogSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "roundingRuleId": { "const": "ties-to-even-v1" },
    "eventOrderingId": { "const": "ridebound-event-order-v1" },
    "selectionRuleId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "scenarioContentSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "scenarioHash": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
