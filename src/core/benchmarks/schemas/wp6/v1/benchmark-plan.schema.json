{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ridebound.local/schemas/wp6/v1/benchmark-plan.schema.json",
  "title": "RideBound WP6 Benchmark Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "evidenceClass", "claimProfileId", "scenarioHashes", "arms", "pairingClassId", "masterSeedHex", "warmupRunCount", "measuredRepeatCount", "runOrderId", "resourceProfileId", "failureRuleSetId", "exclusionRuleSetId", "metricRegistryHash", "runnerArtifact", "harnessSourceSha256", "oracleSourceSha256"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "planId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "evidenceClass": { "enum": ["mechanical", "development"] },
    "claimProfileId": { "const": "wp6-mechanical-only-v1" },
    "scenarioHashes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/sha256" } },
    "arms": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/arm" } },
    "pairingClassId": { "enum": ["wp4-common-candidate-v1", "wp4-multiple-plan-v1", "mechanical-single-arm-v1"] },
    "masterSeedHex": { "$ref": "common.schema.json#/$defs/sha256" },
    "warmupRunCount": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "measuredRepeatCount": { "type": "integer", "minimum": 3, "maximum": 9007199254740991 },
    "runOrderId": { "const": "hash-counterbalanced-v1" },
    "resourceProfileId": { "$ref": "common.schema.json#/$defs/artifactId" },
    "failureRuleSetId": { "const": "wp6-failure-v1.0.2" },
    "exclusionRuleSetId": { "const": "wp6-exclusion-v1" },
    "metricRegistryHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "runnerArtifact": { "$ref": "common.schema.json#/$defs/runnerArtifact" },
    "harnessSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "oracleSourceSha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "not": { "required": ["planHash"] }
}
