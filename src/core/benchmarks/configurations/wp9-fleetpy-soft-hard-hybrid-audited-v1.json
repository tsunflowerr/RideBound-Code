  "solverExecution": {
    "adapterVersion": "google-ortools-9.15.6755",
    "maximumGenerationWorkUnits": 10000,
    "maximumValidationWorkUnits": 10000,
    "maximumSolverWorkUnits": 100000,
    "maximumSolverDeterministicTimeMicros": 1000000,
    "randomSeed": 7
  }
