{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/decision-action.schema.json",
  "title": "RideBound decision action v1",
  "type": "object",
  "required": [
    "decisionType",
    "payload"
  ],
  "properties": {
    "decisionType": {
      "type": "string",
      "enum": [
        "offerProposed",
        "requestAccepted",
        "requestRejected",
        "requestDeferred",
        "vehiclePlanUpdated",
        "promisePublished",
        "commitmentBreachDeclared"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decisionType": { "const": "offerProposed" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "empty-action-payload.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisionType": {
            "const": "requestAccepted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "request-accepted-action-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisionType": {
            "enum": [
              "requestRejected",
              "requestDeferred"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "request-outcome-action-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisionType": {
            "const": "vehiclePlanUpdated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "vehicle-plan-updated-action-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisionType": { "const": "promisePublished" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "promise-published-action-payload.schema.json" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decisionType": { "const": "commitmentBreachDeclared" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "commitment-breach-declared-action-payload.schema.json" }
        }
      }
    }
  ],
  "additionalProperties": false
}
