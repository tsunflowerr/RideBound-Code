{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/commitment-breach-declared-action-payload.schema.json",
  "title": "RideBound commitment-breach-declared action payload v1",
  "type": "object",
  "required": [
    "breachId", "incidentId", "requestId", "sourceEventSeq",
    "witnessCodes", "budgetBefore", "attemptedBudgetAfter"
  ],
  "properties": {
    "breachId": { "$ref": "definitions.schema.json#/$defs/opaqueIdentifier" },
    "incidentId": { "$ref": "definitions.schema.json#/$defs/opaqueIdentifier" },
    "requestId": { "$ref": "definitions.schema.json#/$defs/opaqueIdentifier" },
    "sourceEventSeq": { "$ref": "definitions.schema.json#/$defs/canonicalPositiveInteger" },
    "witnessCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "definitions.schema.json#/$defs/opaqueIdentifier" }
    },
    "budgetBefore": { "$ref": "commitment-vector.schema.json" },
    "attemptedBudgetAfter": { "$ref": "commitment-vector.schema.json" }
  },
  "additionalProperties": false
}
