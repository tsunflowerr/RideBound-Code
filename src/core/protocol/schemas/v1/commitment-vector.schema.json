{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/commitment-vector.schema.json",
  "title": "RideBound commitment vector v1",
  "type": "object",
  "required": [
    "pickupEtaTotalMs",
    "dropEtaTotalMs",
    "vehicleSwitchCount",
    "pickupStopSwitchCount",
    "dropStopSwitchCount"
  ],
  "properties": {
    "pickupEtaTotalMs": { "$ref": "definitions.schema.json#/$defs/canonicalNonNegativeInteger" },
    "dropEtaTotalMs": { "$ref": "definitions.schema.json#/$defs/canonicalNonNegativeInteger" },
    "vehicleSwitchCount": { "$ref": "definitions.schema.json#/$defs/canonicalNonNegativeInteger" },
    "pickupStopSwitchCount": { "$ref": "definitions.schema.json#/$defs/canonicalNonNegativeInteger" },
    "dropStopSwitchCount": { "$ref": "definitions.schema.json#/$defs/canonicalNonNegativeInteger" }
  },
  "additionalProperties": false
}
