{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/protocol-event.schema.json",
  "title": "RideBound protocol event v1",
  "type": "object",
  "required": [
    "eventSeq",
    "eventType",
    "payload"
  ],
  "properties": {
    "eventSeq": {
      "$ref": "definitions.schema.json#/$defs/canonicalPositiveInteger"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "requestArrived",
        "bookingConfirmed",
        "offerDeclined",
        "requestCancelledBeforeAcceptance",
        "requestCancelledAfterAcceptance",
        "vehicleAdvanced",
        "vehicleReachedStop",
        "passengerBoarded",
        "passengerAlighted",
        "travelTimesUpdated",
        "timerTick",
        "incidentOpened",
        "incidentResolved"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "requestArrived"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "request-arrived-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "bookingConfirmed",
              "offerDeclined",
              "requestCancelledBeforeAcceptance",
              "requestCancelledAfterAcceptance"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "request-reference-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "vehicleAdvanced"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "vehicle-advanced-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "vehicleReachedStop"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "vehicle-reached-stop-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "passengerBoarded",
              "passengerAlighted"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "passenger-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "travelTimesUpdated"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "travel-times-updated-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "timerTick"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "timer-tick-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "incidentOpened"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "incident-opened-event-payload.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "incidentResolved"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "incident-resolved-event-payload.schema.json"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
