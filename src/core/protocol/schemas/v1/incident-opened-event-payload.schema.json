{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/incident-opened-event-payload.schema.json",
  "title": "RideBound incidentOpened payload v1",
  "type": "object",
  "required": [
    "incidentId",
    "reasonCode",
    "vehicleIds"
  ],
  "properties": {
    "incidentId": {
      "$ref": "definitions.schema.json#/$defs/opaqueIdentifier"
    },
    "reasonCode": {
      "$ref": "definitions.schema.json#/$defs/opaqueIdentifier"
    },
    "vehicleIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.schema.json#/$defs/opaqueIdentifier"
      },
      "uniqueItems": true,
      "x-ridebound-semantic-set": true,
      "x-ridebound-sort": "ordinal"
    }
  },
  "additionalProperties": false
}
