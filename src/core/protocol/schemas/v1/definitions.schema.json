{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsunflowerr/RideBound/main/benchmarks/schemas/v1/definitions.schema.json",
  "title": "RideBound protocol v1 common definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.(0|[1-9][0-9]*)$",
      "description": "Protocol 1.0 patch line. Patch releases cannot change canonical semantics."
    },
    "opaqueIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-ridebound-maxUtf8Bytes": 128
    },
    "canonicalNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "canonicalPositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "positionModel": {
      "type": "string",
      "enum": [
        "nodeOnly",
        "directedEdgeProgress"
      ]
    },
    "capabilityId": {
      "type": "string",
      "enum": [
        "cancellations",
        "dynamicTravelTimes",
        "exactEventOrdering",
        "nativeBaselineHooks",
        "oldPlanProjection",
        "stopRelocation",
        "vehicleReassignment"
      ]
    },
    "capabilitySet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capabilityId"
      },
      "uniqueItems": true,
      "x-ridebound-semantic-set": true,
      "x-ridebound-sort": "ordinal"
    }
  }
}
