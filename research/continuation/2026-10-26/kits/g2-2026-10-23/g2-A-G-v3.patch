+        return PairResult.Kept(
+            new HardVectorCandidateAssessment(
+                candidate.CandidateId,
+                utilization.PartsPerMillion,
+                revision.Value!,
+                utilization.HasApplicableHardLimit,
+                warning.Value,
+                warning.HasApplicableWarning));
