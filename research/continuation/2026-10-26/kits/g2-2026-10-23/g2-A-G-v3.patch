+        if (!updated.IsSuccess)
+        {
+            return PairResult.Pruned(
+                new CandidatePruneWitness(
+                    candidate.CandidateId,
+                    candidate.VehicleId,
+                    candidate.NewRequestIds,
+                    updated.Failure!.Code,
+                    updated.Failure.Message));
