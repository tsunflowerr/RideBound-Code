+                "A released request must have no remaining stop on the vehicle route.",
+                requestId.Value,
+                "routeStops");
+        }
+
+        return Create(
+            Id,
+            Capacity,
+            OccupiedSeats,
+            Position,
+            OnboardRequestIds,
+            AcceptedRequestIds.Where(value => value != requestId),
+            Route,
+            LastObservedEpoch);
+    }
